		emoji = "🤖",
		joke = "Hello traveler. Tanks like a side quest.",
		stats = { hp = 1.4 },
		special = {},
		tint = C(170, 170, 170),
		weight = 30,
	},
	MainCharacter = {
		displayName = "Main Character",
		rarity = "Legendary",
		emoji = "🌟",
		joke = "The plot armor is real.",
		stats = {},
		special = { taunt = true, damageTaken = 0.6 },
		accessory = "Spotlight",
		weight = 4,
	},
	LagSpike = {
		displayName = "Lag Spike",
		rarity = "Epic",
		emoji = "📶",
		joke = "Hits register twice. Server is sorry.",
