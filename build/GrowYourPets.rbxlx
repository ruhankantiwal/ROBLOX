		emoji = "👑",
		exclusive = "VIP",
		base = { power = 16, hp = 150, speed = 34, attackRate = 1.4, range = 6 },
		body = {
			template = "Quad",
			size = Vector3.new(2.6, 2.2, 3.8),
			colors = { main = C(255, 204, 64), accent = C(255, 240, 180), detail = C(200, 140, 20) },
			ears = "Pointy",
			snout = "Dog",
			tail = "Fluffy",
			extras = { "Crown", "Mane" },
		},
	},
	PumpkinHound = {
		displayName = "Pumpkin Hound",
		rarity = "Exclusive",
		role = "Striker",
		emoji = "🎃",
		exclusive = "Halloween",
		base = { power = 15, hp = 140, speed = 32, attackRate = 1.4, range = 6 },
		body = {
			template = "Quad",
			size = Vector3.new(2.4, 2, 3.4),
			colors = { main = C(40, 36, 44), accent = C(255, 120, 20), detail = C(255, 150, 20) },
			ears = "Pointy",
			snout = "Dog",
			tail = "Long",
			headColor = C(255, 120, 20),
			eyeColor = C(255, 240, 60),
			neonDetail = true,
		},
	},
}

-- Hatch-time variants (Pet Simulator style). Golden/Rainbow are crafted.
Pets.Variants = {
	Normal = { mult = 1, label = "" },
	Shiny = { mult = 1.5, label = "✨ Shiny", hatchChance = 1 / 250 },
	Golden = { mult = 1.6, label = "🟡 Golden", craftFrom = "Normal", craftCount = 5 },
	Rainbow = { mult = 2.6, label = "🌈 Rainbow", craftFrom = "Golden", craftCount = 5 },
}

-- Global balance knobs applied on top of every species' base stats.
Pets.GlobalTuning = { power = 1.5, hp = 1.6 }

Pets.BaseEquipSlots = 3
Pets.MaxEquipSlots = 8
Pets.BaseInventory = 60
Pets.FaintSeconds = 8
Pets.MaxMutationSlots = 2
Pets.SecondMutationSlotLevel = 15

return Pets
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Progression</string>
            <string name="Source"><![CDATA[--[[
	Player levels, pet levels, rebirths, daily rewards, quests and codes.
]]

local Progression = {}

-- Player XP needed to go from `level` to `level + 1`.
function Progression.PlayerXpToNext(level: number): number
	return math.floor(60 * level ^ 1.55)
end

-- Pet XP needed to go from `level` to `level + 1`.
function Progression.PetXpToNext(level: number): number
	return math.floor(25 * level ^ 1.45)
end

Progression.PetStatPerLevel = 0.045 -- +4.5% power/hp per pet level

-- Rebirth ("Evolve Farm"): resets coins + conveyor, keeps pets/fruits.
Progression.Rebirth = {
	baseCost = 1000000,
	costGrowth = 3,
	coinBonusPerRebirth = 0.25,
	equipSlotAt = { [1] = true, [3] = true, [6] = true },
}

function Progression.RebirthCost(rebirths: number): number
	return Progression.Rebirth.baseCost * Progression.Rebirth.costGrowth ^ rebirths
end

-- Seven-day login streak, loops. Day 7 is the big one.
Progression.DailyRewards = {
	{ coins = 500 },
	{ mutagen = 50 },
	{ coins = 2500 },
	{ heistTickets = 1 },
	{ coins = 10000, mutagen = 150 },
	{ capsule = "Rare" },
	{ fruit = "Random", heistTickets = 1 },
}

-- Daily quests: three are picked each day from this pool.
Progression.QuestPool = {
	{ id = "Kill", stat = "zombiesKilled", goal = 150, text = "Defeat %d zombies", reward = { coins = 2000, mutagen = 40 } },
	{ id = "Waves", stat = "wavesCleared", goal = 5, text = "Clear %d base waves", reward = { coins = 3000 } },
	{ id = "Hatch", stat = "eggsHatched", goal = 10, text = "Hatch %d eggs", reward = { mutagen = 60 } },
	{ id = "Boss", stat = "bossesKilled", goal = 2, text = "Defeat %d bosses", reward = { heistTickets = 1 } },
	{ id = "Fruit", stat = "fruitsCollected", goal = 1, text = "Collect %d Beast Fruit", reward = { coins = 5000 } },
	{ id = "Heist", stat = "heistsWon", goal = 1, text = "Win %d Egg Heist", reward = { mutagen = 150 } },
	{ id = "Steal", stat = "capsulesStolen", goal = 1, text = "Steal %d capsule", reward = { coins = 4000 } },
}

-- Free Dragon's Nest heist tickets regenerate over time (capped).
Progression.FreeTicketEvery = 4 * 3600
Progression.FreeTicketCap = 2

-- Launch codes. Rotate through creators' videos for tracking.
Progression.Codes = {
	RELEASE = { coins = 2500, heistTickets = 1 },
	GROWYOURPETS = { fruit = "Blaze" },
	ZOMBIEPARTY = { mutagen = 200 },
	SIXSEVEN = { capsule = "Rare" },
}

-- Offline conveyor earnings (fraction of live rate, capped duration).
Progression.OfflineRate = 0.5
Progression.OfflineCapSeconds = 2 * 3600
Progression.OfflineCapSecondsVip = 8 * 3600

return Progression
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Rarity</string>
            <string name="Source"><![CDATA[--[[
	Rarity tiers shared by pets, fruits, mutations and capsules.

	rank        ordering used for sorting, luck boosts and announcements
	statMult    multiplier applied on top of species base stats
	maxLevel    pet level cap for this tier
	sizeMult    visual scale, rarer pets read as "bigger" on screen
	announce    "none" | "server" | "global" (cross-server via MessagingService)
]]

local Rarity = {}

Rarity.Order = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythical", "Secret", "Exclusive" }

Rarity.Info = {
	Common = {
		rank = 1,
		color = Color3.fromRGB(176, 184, 192),
		statMult = 1.0,
		maxLevel = 25,
		sizeMult = 1.0,
		sellValue = 10,
		announce = "none",
	},
	Uncommon = {
		rank = 2,
		color = Color3.fromRGB(88, 214, 104),
		statMult = 1.35,
		maxLevel = 30,
		sizeMult = 1.0,
		sellValue = 40,
		announce = "none",
	},
	Rare = {
		rank = 3,
		color = Color3.fromRGB(64, 156, 255),
		statMult = 1.9,
		maxLevel = 40,
		sizeMult = 1.05,
		sellValue = 200,
		announce = "none",
	},
	Epic = {
		rank = 4,
		color = Color3.fromRGB(176, 92, 255),
		statMult = 2.8,
		maxLevel = 50,
		sizeMult = 1.1,
		sellValue = 1200,
		announce = "none",
	},
	Legendary = {
		rank = 5,
		color = Color3.fromRGB(255, 184, 36),
		statMult = 4.2,
		maxLevel = 60,
		sizeMult = 1.2,
		sellValue = 8000,
		announce = "server",
	},
	Mythical = {
		rank = 6,
		color = Color3.fromRGB(255, 72, 120),
		statMult = 6.5,
		maxLevel = 75,
		sizeMult = 1.3,
		sellValue = 50000,
		announce = "server",
	},
	Secret = {
		rank = 7,
		color = Color3.fromRGB(20, 20, 24),
		rainbow = true,
		statMult = 11,
		maxLevel = 100,
		sizeMult = 1.4,
		sellValue = 500000,
		announce = "global",
	},
	Exclusive = {
		rank = 8,
		color = Color3.fromRGB(255, 226, 120),
		statMult = 7.5,
		maxLevel = 80,
		sizeMult = 1.3,
		sellValue = 0,
		announce = "server",
	},
}

function Rarity.Rank(name: string): number
	local info = Rarity.Info[name]
	return if info then info.rank else 0
end

function Rarity.Color(name: string): Color3
	local info = Rarity.Info[name]
	return if info then info.color else Color3.new(1, 1, 1)
end

return Rarity
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[--[[
	The Long Valley: one continuous valley running along +Z, built from
	studded blocks by WorldBuilder at server start.

	Everything here is deterministic (fixed seed), so the server and every
	client agree on ground height, plot positions and zone bounds without
	sending any geometry over the network.
]]

local C = Color3.fromRGB

local World = {}

World.Seed = 1001
World.Tile = 32
World.Length = 3200
World.StartZ = -64

World.Zones = {
	{
		id = "Hub",
		name = "Barnyard Plaza",
		zStart = -64,
		zEnd = 280,
		levelReq = 1,
		hills = 0,
		palette = { ground = C(92, 180, 76), groundAlt = C(100, 190, 82), cliff = C(120, 110, 100), cliffTop = C(80, 160, 70), accent = C(215, 190, 140) },
		trees = 0,
	},
	{
		id = "FarmRow",
		name = "Farm Row",
		zStart = 280,
		zEnd = 820,
		levelReq = 1,
		hills = 0,
		palette = { ground = C(96, 176, 70), groundAlt = C(106, 186, 78), cliff = C(128, 112, 96), cliffTop = C(84, 162, 72), accent = C(210, 184, 130) },
		trees = 10,
	},
	{
		id = "Meadow",
		name = "Meadow Fields",
		zStart = 820,
		zEnd = 1300,
		levelReq = 1,
		hills = 4,
		palette = { ground = C(124, 200, 80), groundAlt = C(136, 210, 90), cliff = C(140, 124, 104), cliffTop = C(110, 190, 80), accent = C(255, 230, 90) },
		trees = 40,
		treeStyle = "Round",
		camps = { count = 7, types = { "Walker", "Walker", "Runner" }, level = { 1, 8 } },
	},
	{
		id = "Woods",
		name = "Whispering Woods",
		zStart = 1300,
		zEnd = 1850,
		levelReq = 10,
		hills = 6,
		palette = { ground = C(52, 110, 60), groundAlt = C(60, 122, 66), cliff = C(90, 84, 80), cliffTop = C(40, 96, 52), accent = C(150, 110, 70) },
		trees = 120,
		treeStyle = "Pine",
		camps = { count = 8, types = { "Walker", "Runner", "Spitter" }, level = { 10, 22 } },
	},
	{
		id = "Canyon",
		name = "Crystal Canyon",
		zStart = 1850,
		zEnd = 2400,
		levelReq = 25,
		hills = 10,
		palette = { ground = C(214, 150, 104), groundAlt = C(224, 162, 114), cliff = C(186, 110, 76), cliffTop = C(230, 180, 130), accent = C(110, 230, 255) },
		trees = 14,
		treeStyle = "Crystal",
		camps = { count = 8, types = { "Runner", "Spitter", "Brute" }, level = { 25, 40 } },
	},
	{
		id = "Volcano",
		name = "Volcano Ridge",
		zStart = 2400,
		zEnd = 2900,
		levelReq = 40,
		hills = 12,
		palette = { ground = C(70, 64, 66), groundAlt = C(84, 76, 78), cliff = C(46, 42, 44), cliffTop = C(100, 60, 50), accent = C(255, 110, 20) },
		trees = 18,
		treeStyle = "Dead",
		camps = { count = 8, types = { "Brute", "Spitter", "Runner" }, level = { 40, 60 } },
	},
	{
		id = "Nest",
		name = "Dragon's Nest",
		zStart = 2900,
		zEnd = 3200,
		levelReq = 50,
		hills = 6,
		palette = { ground = C(70, 40, 90), groundAlt = C(80, 48, 102), cliff = C(40, 26, 50), cliffTop = C(120, 60, 140), accent = C(255, 190, 40) },
		trees = 0,
	},
}

-- Valley half-width control points (z, halfWidth); linearly interpolated.
local WIDTH_POINTS = {
	{ -64, 190 },
	{ 270, 190 },
	{ 300, 262 },
	{ 820, 262 },
	{ 900, 210 },
	{ 1300, 220 },
	{ 1360, 175 },
	{ 1850, 175 },
	{ 1910, 135 },
	{ 2400, 140 },
	{ 2460, 185 },
	{ 2900, 190 },
	{ 2960, 170 },
	{ 3264, 170 },
}

function World.ZoneAt(z: number)
	for i, zone in World.Zones do
		if z < zone.zEnd or i == #World.Zones then
			return zone, i
		end
	end
	return World.Zones[1], 1
end

function World.ZoneById(id: string)
	for i, zone in World.Zones do
		if zone.id == id then
			return zone, i
		end
	end
	return nil, 0
end

function World.HalfWidth(z: number): number
	for i = 1, #WIDTH_POINTS - 1 do
		local a, b = WIDTH_POINTS[i], WIDTH_POINTS[i + 1]
		if z <= b[1] then
			local t = math.clamp((z - a[1]) / (b[1] - a[1]), 0, 1)
			return a[2] + (b[2] - a[2]) * t
		end
	end
	return WIDTH_POINTS[#WIDTH_POINTS][2]
end

-- Gentle meander once you leave the farms, so the valley reads as "long"
-- and you never see the end from the start.
function World.CenterX(z: number): number
	local ramp = math.clamp((z - 880) / 300, 0, 1)
	return math.sin((z - 880) / 260) * 80 * ramp
end

local function isFlat(x: number, z: number): boolean
	if z < 830 then
		return true
	end
	-- Gate plazas, heist yards and the dungeon entrance stay flat.
	for _, zone in World.Zones do
		if math.abs(z - zone.zStart) < 24 and zone.levelReq > 1 then
			return true
		end
	end
	for _, heist in World.Heists do
		if math.abs(z - heist.center.Z) < 90 and math.abs(x - World.CenterX(heist.center.Z) - heist.center.X) < 90 then
			return true
		end
	end
	local e = World.Dungeon.entrance
	if math.abs(z - e.Z) < 40 and math.abs(x - World.CenterX(e.Z) - e.X) < 40 then
		return true
	end
	return false
end

-- Height of the walkable top surface at (x, z). Quantised to 1 stud so the
-- block terrain has small steps characters can walk up.
function World.GroundHeight(x: number, z: number): number
	local tile = World.Tile
	local ix = math.floor(x / tile)
	local iz = math.floor(z / tile)
	local tx = (ix + 0.5) * tile
	local tz = (iz + 0.5) * tile
	local d = math.abs(tx - World.CenterX(tz))
	local hw = World.HalfWidth(tz)
	if d > hw then
		return World.CliffHeight(ix, iz)
	end
	if isFlat(tx, tz) then
		return 0
	end
	local zone = World.ZoneAt(tz)
	local n = math.noise(ix * 0.09, iz * 0.09, World.Seed * 0.001)
	local h = (n + 0.5) * zone.hills
	local edge = d - (hw - 48)
	if edge > 0 then
		h += edge * 0.12
	end
	return math.max(0, math.floor(h + 0.5))
end

function World.CliffHeight(ix: number, iz: number): number
	local n = math.noise(ix * 0.21 + 7.3, iz * 0.17 - 2.1, World.Seed * 0.002)
	return 46 + math.floor((n + 0.5) * 40)
end

function World.IsInsideValley(x: number, z: number, margin: number?): boolean
	local m = margin or 0
	if z < World.StartZ + m or z > World.Length - m then
		return false
	end
	return math.abs(x - World.CenterX(z)) < World.HalfWidth(z) - m
end

-- Clamp a position to the walkable valley floor (used by entity movement).
function World.ClampToValley(x: number, z: number, margin: number): (number, number)
	z = math.clamp(z, World.StartZ + margin, World.Length - margin)
	local cx = World.CenterX(z)
	local hw = World.HalfWidth(z) - margin
	x = math.clamp(x, cx - hw, cx + hw)
	return x, z
end

-- Valley features are authored as (offset from the meandering centre line,
-- y ignored, z). Resolve turns one into a world position on the ground.
function World.Resolve(v: Vector3): Vector3
	local x = World.CenterX(v.Z) + v.X
	return Vector3.new(x, World.GroundHeight(x, v.Z), v.Z)
end

-- Player bases: 4 per side of the Farm Row road.
World.PlotCount = 8
function World.PlotCFrame(index: number): CFrame
	local side = if index % 2 == 1 then -1 else 1
	local row = math.floor((index - 1) / 2)
	local center = Vector3.new(150 * side, 0, 360 + row * 125)
	-- Plot-local +Z faces the road (front), -Z faces the cliff (back).
	local towardRoad = Vector3.new(-side, 0, 0)
	return CFrame.lookAt(center, center - towardRoad)
end

World.HubSpawn = Vector3.new(0, 0, 150)

World.EggStands = {
	FarmEgg = Vector3.new(-66, 0, 210),
	MeadowEgg = Vector3.new(-22, 0, 222),
	WoodsEgg = Vector3.new(22, 0, 222),
	CanyonEgg = Vector3.new(66, 0, 210),
}

World.FruitDealer = Vector3.new(-120, 0, 130)
World.RebirthStatue = Vector3.new(120, 0, 130)
World.BrainrotBelt = { from = Vector3.new(-110, 0, 40), to = Vector3.new(110, 0, 40) }

World.Heists = {
	ChickenCoop = {
		name = "Chicken Coop Heist",
		center = Vector3.new(130, 0, 1190), -- offset from CenterX, see Resolve
		egg = "GoldenCoopEgg",
		guards = { "CoopGuard", "CoopGuard", "CoopGuard", "CoopGuard" },
		boss = "GiantRooster",
		level = 8,
		ticket = false,
		cooldown = 600,
		pursuitLeash = 260,
	},
	DragonNest = {
		name = "Dragon's Nest Heist",
		center = Vector3.new(0, 0, 3080),
		egg = "DragonEgg",
		guards = { "NestWyvern", "NestWyvern", "NestWyvern", "NestWyvern", "NestWyvern" },
		boss = "NestMother",
		level = 55,
		ticket = true,
		cooldown = 0,
		pursuitLeash = 520,
	},
}

World.Dungeon = {
	name = "The Hollow Stump",
	entrance = Vector3.new(0, 0, 1640), -- x is offset from CenterX at build time
	arena = Vector3.new(0, -600, 1640),
	waves = 4,
	levelOffset = 3,
	cooldown = 300,
}

-- Deterministic list of zombie camps along the valley.
function World.Camps()
	local camps = {}
	local rng = Random.new(World.Seed + 17)
	for _, zone in World.Zones do
		if zone.camps then
			for i = 1, zone.camps.count do
				local z = zone.zStart + 60 + (zone.zEnd - zone.zStart - 120) * ((i - 0.5) / zone.camps.count)
				local hw = World.HalfWidth(z) - 60
				local x = World.CenterX(z) + rng:NextNumber(-hw, hw)
				local lvl = math.floor(zone.camps.level[1] + (zone.camps.level[2] - zone.camps.level[1]) * ((i - 1) / math.max(1, zone.camps.count - 1)))
				table.insert(camps, {
					id = zone.id .. i,
					zone = zone.id,
					position = Vector3.new(x, World.GroundHeight(x, z), z),
					types = zone.camps.types,
					level = lvl,
					size = 6 + (i % 4), -- hordes, not handfuls: kills are the clip
				})
			end
		end
	end
	return camps
end

return World
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Zombies</string>
            <string name="Source"><![CDATA[--[[
	Zombies, bosses and heist guardians. All are server-simulated entities
	rendered client-side from blocks (no Humanoids, no physics), which is
	what keeps 60+ zombies cheap on phones.

	Stats are level-1 values; Zombies.Scale() applies level growth.
]]

local C = Color3.fromRGB

local Zombies = {}

Zombies.Types = {
	Walker = {
		displayName = "Walker",
		hp = 28,
		damage = 3.5,
		speed = 9,
		attackRate = 0.8,
		range = 4,
		aggro = 30,
		coins = 6,
		xp = 4,
		mutagen = 0.2,
		body = {
			template = "Zombie",
			colors = { main = C(110, 170, 90), accent = C(70, 90, 150), detail = C(90, 60, 40) },
		},
	},
	Runner = {
		displayName = "Runner",
		hp = 20,
		damage = 3,
		speed = 17,
		attackRate = 1.2,
		range = 4,
		aggro = 40,
		coins = 7,
		xp = 5,
		mutagen = 0.2,
		body = {
			template = "Zombie",
			scale = 0.85,
			colors = { main = C(150, 190, 110), accent = C(200, 60, 60), detail = C(50, 50, 60) },
		},
	},
	Brute = {
		displayName = "Brute",
		hp = 140,
		damage = 10,
		speed = 7,
		attackRate = 0.6,
		range = 6,
		aggro = 30,
		coins = 25,
		xp = 16,
		mutagen = 1,
		body = {
			template = "Zombie",
			scale = 1.6,
			colors = { main = C(90, 130, 80), accent = C(110, 80, 60), detail = C(60, 40, 30) },
		},
	},
	Spitter = {
		displayName = "Spitter",
		hp = 26,
		damage = 4,
		speed = 8,
		attackRate = 0.7,
		range = 20,
		ranged = true,
		aggro = 36,
		coins = 10,
		xp = 7,
		mutagen = 0.4,
		body = {
			template = "Zombie",
			colors = { main = C(160, 110, 200), accent = C(60, 120, 60), detail = C(200, 255, 80) },
		},
	},

	-- Bosses
	FarmerZed = {
		displayName = "Farmer Zed",
		boss = true,
		hp = 600,
		damage = 14,
		speed = 8,
		attackRate = 0.7,
		range = 8,
		aggro = 60,
		coins = 600,
		xp = 250,
		mutagen = 40,
		fruitDrop = 0.08,
		body = {
			template = "Zombie",
			scale = 2.4,
			colors = { main = C(120, 170, 90), accent = C(70, 110, 190), detail = C(230, 200, 90) },
			extras = { "StrawHat" },
		},
	},
	BrainrotTitan = {
		displayName = "Brainrot Titan",
		boss = true,
		hp = 2600,
		damage = 30,
		speed = 7,
		attackRate = 0.6,
		range = 10,
		aggro = 70,
		coins = 3000,
		xp = 1200,
		mutagen = 200,
		fruitDrop = 0.2,
		body = {
			template = "Zombie",
			scale = 3.4,
			colors = { main = C(255, 90, 210), accent = C(40, 40, 60), detail = C(80, 255, 240) },
			extras = { "Crown" },
			neonDetail = true,
		},
	},

	-- Heist guardians (only visible to the player running the heist)
	CoopGuard = {
		displayName = "Coop Guard",
		guard = true,
		hp = 120,
		damage = 9,
		speed = 19,
		attackRate = 1,
		range = 5,
		aggro = 34,
		coins = 20,
		xp = 20,
		mutagen = 1,
		body = {
			template = "Zombie",
			scale = 1.2,
			colors = { main = C(250, 250, 250), accent = C(200, 40, 40), detail = C(255, 180, 40) },
			extras = { "StrawHat" },
		},
	},
	GiantRooster = {
		displayName = "Giant Rooster",
		boss = true,
		guard = true,
		hp = 900,
		damage = 18,
		speed = 14,
		attackRate = 0.8,
		range = 9,
		aggro = 60,
		coins = 900,
		xp = 400,
		mutagen = 60,
		body = {
			template = "Bird",
			scale = 3.2,
			colors = { main = C(250, 250, 250), accent = C(255, 170, 30), detail = C(230, 30, 30) },
			extras = { "Crest" },
		},
	},
	NestWyvern = {
		displayName = "Nest Wyvern",
		guard = true,
		hp = 150,
		damage = 40,
		speed = 24,
		attackRate = 1,
		range = 7,
		aggro = 45,
		coins = 150,
		xp = 120,
		mutagen = 8,
		body = {
			template = "Quad",
			scale = 1.4,
			colors = { main = C(80, 30, 110), accent = C(255, 120, 40), detail = C(30, 20, 30) },
			ears = "Pointy",
			snout = "Dog",
			tail = "Long",
			extras = { "Wings" },
		},
	},
	NestMother = {
		displayName = "Nest Mother",
		boss = true,
		guard = true,
		hp = 4000,
		damage = 90,
		speed = 16,
		attackRate = 0.7,
		range = 14,
		aggro = 80,
		coins = 20000,
		xp = 6000,
		mutagen = 800,
		fruitDrop = 0.35,
		body = {
			template = "Quad",
			scale = 4,
			colors = { main = C(150, 20, 40), accent = C(255, 190, 40), detail = C(30, 20, 24) },
			ears = "Horns",
			snout = "Dog",
			tail = "Long",
			extras = { "Wings", "Crown" },
			neonDetail = true,
		},
	},
}

-- Level growth. Tuned against pet growth (rarity x level x fruit):
-- zombie HP grows ~64x from Lv1 to Lv55, roughly what a Mythical army
-- gains over a Common one, so every zone stays a fight but never a wall.
-- A fresh 2-pet squad clears waves 1-4; the wave-5 boss wants a wall,
-- a third pet or a fruit.
function Zombies.Scale(typeId: string, level: number)
	local t = Zombies.Types[typeId]
	local l = math.max(1, level) - 1
	return {
		hp = t.hp * (1.08 ^ l),
		damage = t.damage * (1.06 ^ l),
		coins = math.floor(t.coins * (1.12 ^ l)),
		xp = math.floor(t.xp * (1.1 ^ l)),
		mutagen = t.mutagen * (1.08 ^ l),
	}
end

-- Base-defense wave composition.
function Zombies.WaveComposition(wave: number)
	local list = {}
	local count = math.min(4 + wave * 2, 60)
	for i = 1, count do
		local roll = (i * 7919 + wave * 104729) % 100
		if wave >= 4 and roll < 12 then
			table.insert(list, "Brute")
		elseif wave >= 3 and roll < 30 then
			table.insert(list, "Spitter")
		elseif wave >= 2 and roll < 55 then
			table.insert(list, "Runner")
		else
			table.insert(list, "Walker")
		end
	end
	if wave % 10 == 0 then
		table.insert(list, "BrainrotTitan")
	elseif wave % 5 == 0 then
		table.insert(list, "FarmerZed")
	end
	return list
end

-- Zombie level for a base wave (waves ramp faster than the wave number).
function Zombies.WaveLevel(wave: number): number
	return math.max(1, math.floor(wave * 1.5))
end

Zombies.MaxAlivePerPlot = 30
Zombies.WaveSpawnInterval = 1
Zombies.WaveBreak = 25 -- seconds between waves (skippable)

return Zombies
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--[[
	Every remote in the game, declared in one place. The server creates them
	at boot (Net.Setup); clients wait for them by name.

	Naming: client -> server requests are verbs ("EquipPet"); server ->
	client pushes are nouns/past tense ("DataChanged", "EntitySpawned").
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

local EVENTS = {
	-- server -> client
	"Init",
	"DataChanged",
	"Notify",
	"Announce",
	"EntitySpawned",
	"EntityRemoved",
	"EntityAppearance",
	"CombatEvents",
	"HatchResult",
	"MutationCinematic",
	"FruitSpawned",
	"FruitDespawned",
	"WaveState",
	"HeistState",
	"MountState",
	"ConveyorState",
	"OpenPanel",
	-- client -> server
	"SquadCommand",
	"EquipPet",
	"UnequipPet",
	"EquipBest",
	"SetAlpha",
	"LockPet",
	"SellPet",
	"CraftPet",
	"ToggleMount",
	"MountAttack",
	"StartWave",
	"LockBase",
	"ApplyMutation",
	"RedeemCode",
	"ClaimDaily",
	"ClaimQuest",
	"Purchase",
	"GemPurchase",
	"Rebirth",
	"AutoHatch",
}

local UNRELIABLE = {
	"EntitySnapshot",
}

local FUNCTIONS = {
	"HatchEgg",
	"FeedFruit",
	"RollFruit",
	"GetShopInfo",
}

local folder: Folder

function Net.Setup()
	assert(RunService:IsServer(), "Net.Setup is server-only")
	folder = Instance.new("Folder")
	folder.Name = "Remotes"
	for _, name in EVENTS do
		local r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = folder
	end
	for _, name in UNRELIABLE do
		local r = Instance.new("UnreliableRemoteEvent")
		r.Name = name
		r.Parent = folder
	end
	for _, name in FUNCTIONS do
		local r = Instance.new("RemoteFunction")
		r.Name = name
		r.Parent = folder
	end
	folder.Parent = ReplicatedStorage
end

local function getFolder(): Folder
	if not folder then
		folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
	end
	return folder
end

function Net.Event(name: string): RemoteEvent
	return getFolder():WaitForChild(name) :: RemoteEvent
end

function Net.Unreliable(name: string): UnreliableRemoteEvent
	return getFolder():WaitForChild(name) :: UnreliableRemoteEvent
end

function Net.Function(name: string): RemoteFunction
	return getFolder():WaitForChild(name) :: RemoteFunction
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="19">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">EntityProtocol</string>
            <string name="Source"><![CDATA[--[[
	Wire format for entity snapshots (pets, zombies, guardians).

	The server simulates every entity at 10 Hz and sends each player a
	compact binary snapshot of the entities near them over an
	UnreliableRemoteEvent. Clients own all the parts and animation, so no
	physics or Humanoids replicate. 17 bytes per entity:

		u16 id | f32 x | f32 y | f32 z | u8 yaw | u8 state | u8 hp

	UnreliableRemoteEvent payloads are capped (~900 bytes), so snapshots are
	chunked at MaxPerPacket entities.
]]

local EntityProtocol = {}

EntityProtocol.State = {
	Idle = 0,
	Move = 1,
	Attack = 2,
	Ability = 3,
	Fainted = 4,
	Mounted = 5,
	Stunned = 6,
	Dead = 7,
	Frozen = 8,
	Carry = 9,
}

EntityProtocol.EntrySize = 17
EntityProtocol.MaxPerPacket = 48
EntityProtocol.TickRate = 10

local TAU = math.pi * 2

export type Entry = {
	id: number,
	x: number,
	y: number,
	z: number,
	yaw: number,
	state: number,
	hp: number, -- 0..1
}

function EntityProtocol.Pack(entries: { Entry }, from: number, to: number): buffer
	local count = to - from + 1
	local buf = buffer.create(1 + count * EntityProtocol.EntrySize)
	buffer.writeu8(buf, 0, count)
	local offset = 1
	for i = from, to do
		local e = entries[i]
		buffer.writeu16(buf, offset, e.id)
		buffer.writef32(buf, offset + 2, e.x)
		buffer.writef32(buf, offset + 6, e.y)
		buffer.writef32(buf, offset + 10, e.z)
		buffer.writeu8(buf, offset + 14, math.floor(((e.yaw % TAU) / TAU) * 256) % 256)
		buffer.writeu8(buf, offset + 15, e.state)
		buffer.writeu8(buf, offset + 16, math.clamp(math.floor(e.hp * 255 + 0.5), 0, 255))
		offset += EntityProtocol.EntrySize
	end
	return buf
end

function EntityProtocol.Unpack(buf: buffer, onEntry: (id: number, x: number, y: number, z: number, yaw: number, state: number, hp: number) -> ())
	local count = buffer.readu8(buf, 0)
	local offset = 1
	for _ = 1, count do
		onEntry(
			buffer.readu16(buf, offset),
			buffer.readf32(buf, offset + 2),
			buffer.readf32(buf, offset + 6),
			buffer.readf32(buf, offset + 10),
			buffer.readu8(buf, offset + 14) / 256 * TAU,
			buffer.readu8(buf, offset + 15),
			buffer.readu8(buf, offset + 16) / 255
		)
		offset += EntityProtocol.EntrySize
	end
end

-- Combat event codes, sent batched per tick on the reliable CombatEvents
-- remote as small arrays: { code, ... }.
EntityProtocol.Event = {
	Hit = 1, -- { 1, attackerId, targetId, damage, isCrit, fx }
	Ability = 2, -- { 2, casterId, fx, x, z, radius, dirX, dirZ }
	Death = 3, -- { 3, id, killerId, fx }
	Text = 4, -- { 4, id, text, colorHex }
	Projectile = 5, -- { 5, fromId, toId, fx }
	Heal = 6, -- { 6, id, amount }
	Status = 7, -- { 7, id, status, duration }
	Chain = 8, -- { 8, { id1, id2, ... }, fx }
	Beam = 9, -- { 9, fx, x1, y1, z1, x2, y2, z2 }  (turrets, world FX)
}

return EntityProtocol
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--[[
	Number and time formatting for the UI.
]]

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

-- 1234 -> "1.23K", 5600000 -> "5.6M"
function Format.Short(n: number): string
	if n ~= n then
		return "0"
	end
	local negative = n < 0
	n = math.abs(n)
	local i = 1
	while n >= 1000 and i < #SUFFIXES do
		n /= 1000
		i += 1
	end
	local text
	if i == 1 then
		text = tostring(math.floor(n))
	elseif n >= 100 then
		text = string.format("%d%s", math.floor(n), SUFFIXES[i])
	else
		local digits = if n >= 10 then 1 else 2
		local factor = 10 ^ digits
		local num = string.format("%." .. digits .. "f", math.floor(n * factor) / factor)
		num = num:gsub("0+$", ""):gsub("%.$", "")
		text = num .. SUFFIXES[i]
	end
	return (if negative then "-" else "") .. text
end

-- 1234567 -> "1,234,567"
function Format.Commas(n: number): string
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return out
end

-- 3725 -> "1h 2m", 95 -> "1m 35s"
function Format.Duration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%dh %dm", h, m)
	elseif m > 0 then
		return string.format("%dm %ds", m, s)
	end
	return string.format("%ds", s)
end

function Format.Percent(p: number): string
	if p >= 1 then
		return string.format("%.1f%%", p)
	elseif p >= 0.01 then
		return string.format("%.2f%%", p)
	end
	return string.format("%.3f%%", p)
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">PetStats</string>
            <string name="Source"><![CDATA[--[[
	Single source of truth for a pet's final stats. Shared so the server
	(combat) and the client (inventory cards, "equip best") always agree.

	pet data shape (stored in the player profile):
	{
		uid: string,
		species: string,
		level: number, xp: number,
		variant: "Normal" | "Shiny" | "Golden" | "Rainbow",
		fruit: { id: string, mastery: number }?,
		mutations: { string },
		locked: boolean?,
	}
]]

local Config = script.Parent.Parent.Config
local Pets = require(Config.Pets)
local Rarity = require(Config.Rarity)
local Fruits = require(Config.Fruits)
local Mutations = require(Config.Mutations)
local Progression = require(Config.Progression)

local PetStats = {}

export type Stats = {
	power: number,
	hp: number,
	speed: number,
	attackRate: number,
	range: number,
	critChance: number,
	dodge: number,
	damageTaken: number,
	sizeMult: number,
	role: string,
	rarity: string,
	special: { [string]: any },
	abilities: { any },
	powerScore: number,
}

local function applyMods(stats, mods)
	if not mods then
		return
	end
	for key, mult in mods do
		if type(stats[key]) == "number" then
			stats[key] *= mult
		end
	end
end

function PetStats.Compute(pet): Stats
	local species = Pets.Species[pet.species]
	assert(species, "Unknown species " .. tostring(pet.species))
	local rarity = Rarity.Info[species.rarity]
	local variant = Pets.Variants[pet.variant or "Normal"] or Pets.Variants.Normal
	local roleInfo = Pets.Roles[species.role] or {}
	local levelMult = 1 + ((pet.level or 1) - 1) * Progression.PetStatPerLevel
	local grow = rarity.statMult * variant.mult * levelMult
	local tuning = Pets.GlobalTuning

	local stats = {
		power = species.base.power * grow * tuning.power,
		hp = species.base.hp * grow * tuning.hp,
		speed = species.base.speed,
		attackRate = species.base.attackRate,
		range = species.base.range,
		critChance = 0.05 + (roleInfo.critBonus or 0),
		dodge = 0,
		damageTaken = roleInfo.damageTaken or 1,
		sizeMult = rarity.sizeMult,
		role = species.role,
		rarity = species.rarity,
		special = {},
		abilities = {},
		powerScore = 0,
	}

	-- Beast Fruit
	local fruit = pet.fruit and Fruits.List[pet.fruit.id]
	if fruit then
		applyMods(stats, fruit.stats)
		local mastery = pet.fruit.mastery or 0
		if fruit.awaken and mastery >= fruit.awaken.mastery then
			applyMods(stats, fruit.awaken.stats)
			stats.special.awakened = true
		end
		stats.sizeMult *= fruit.look.sizeMult or 1
		for _, ability in fruit.abilities do
			if mastery >= ability.mastery then
				table.insert(stats.abilities, ability)
			end
		end
	end

	-- Brainrot mutations
	for _, mutationId in pet.mutations or {} do
		local m = Mutations.List[mutationId]
		if m then
			applyMods(stats, m.stats)
			stats.sizeMult *= m.sizeMult or 1
			for key, value in m.special do
				if key == "critChance" then
					stats.critChance += value
				elseif key == "dodge" then
					stats.dodge += value
				elseif key == "damageTaken" then
					stats.damageTaken *= value
				else
					stats.special[key] = value
				end
			end
		end
	end

	stats.critChance = math.min(stats.critChance, 0.75)
	stats.dodge = math.min(stats.dodge, 0.4)
	stats.powerScore = PetStats.PowerScore(stats)
	return stats
end

-- One number for sorting and "Equip Best": damage per second weighted up,
-- survivability weighted down.
function PetStats.PowerScore(stats): number
	local dps = stats.power * stats.attackRate * (1 + stats.critChance)
	return math.floor(dps * 10 + stats.hp * 0.5)
end

function PetStats.MutationSlots(pet): number
	if (pet.level or 1) >= Pets.SecondMutationSlotLevel then
		return Pets.MaxMutationSlots
	end
	return 1
end

return PetStats
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Rng</string>
            <string name="Source"><![CDATA[--[[
	Weighted random helpers shared by eggs, fruits, capsules and memes.
]]

local Rng = {}

export type WeightedEntry = { weight: number, [string]: any }

-- Picks one entry from a list of {weight = n, ...}.
function Rng.Pick<T>(entries: { T }, weightOf: (T) -> number, rng: Random?): T
	local total = 0
	for _, e in entries do
		total += weightOf(e)
	end
	local roll = (if rng then rng:NextNumber() else math.random()) * total
	for _, e in entries do
		roll -= weightOf(e)
		if roll <= 0 then
			return e
		end
	end
	return entries[#entries]
end

-- Returns egg odds with luck applied: every "rare pull" (base chance under
-- `maxChance` percent) gets its weight multiplied by `luck`, then the table
-- is renormalised to sum to 100. This exact table is what the UI shows.
function Rng.LuckAdjustedOdds(odds: { { pet: string, chance: number } }, luck: number, maxChance: number)
	local adjusted = {}
	local total = 0
	for _, entry in odds do
		local w = entry.chance
		if luck ~= 1 and entry.chance < maxChance then
			w *= luck
		end
		total += w
		table.insert(adjusted, { pet = entry.pet, chance = w })
	end
	for _, entry in adjusted do
		entry.chance = entry.chance / total * 100
	end
	return adjusted
end

function Rng.Chance(p: number): boolean
	return math.random() < p
end

return Rng
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--[[
	Minimal synchronous signal for service-to-service events.
]]

local Signal = {}
Signal.__index = Signal

export type Connection = { Disconnect: (Connection) -> () }

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn: (...any) -> ())
	local handlers = self._handlers
	table.insert(handlers, fn)
	return {
		Disconnect = function()
			local i = table.find(handlers, fn)
			if i then
				table.remove(handlers, i)
			end
		end,
	}
end

function Signal:Fire(...)
	for _, fn in table.clone(self._handlers) do
		task.spawn(fn, ...)
	end
end

return Signal
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="25">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="26">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="27">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Grow Your Pets: Animal Farm — server bootstrap.

	Services are plain ModuleScripts in ./Services with optional
	:Init(services) and :Start() methods. Init wires references (no yielding),
	Start begins work. A single Heartbeat scheduler drives every fixed-rate
	simulation step, so the whole server has one predictable game loop.
]]

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)

Net.Setup()

local services = {}
for _, module in script.Parent.Services:GetChildren() do
	if module:IsA("ModuleScript") then
		services[module.Name] = require(module) :: any
	end
end

-- Start order matters: the world must exist before plots, plots before
-- the systems that live on them.
local START_ORDER = {
	"WorldBuilder",
	"AnnounceService",
	"DataService",
	"MonetizationService",
	"EntityService",
	"CombatService",
	"PlotService",
	"PetService",
	"PetAIService",
	"ZombieService",
	"ConveyorService",
	"MutationService",
	"CarryService",
	"FruitService",
	"EggHeistService",
	"MountService",
	"ZoneService",
	"RewardsService",
}

for name, service in services do
	if service.Init then
		service:Init(services)
	end
	if not table.find(START_ORDER, name) then
		warn("[Main] service not in START_ORDER:", name)
	end
end

for _, name in START_ORDER do
	local service = services[name]
	if service and service.Start then
		local ok, err = pcall(service.Start, service)
		if not ok then
			warn(("[Main] %s failed to start: %s"):format(name, tostring(err)))
		end
	end
end

-- Fixed-rate scheduler: { service, method, interval }
local jobs = {
	{ services.PetAIService, "Step", 0.1 },
	{ services.ZombieService, "Step", 0.1 },
	{ services.PlotService, "StepDefenses", 0.1 },
	{ services.EntityService, "Replicate", 0.1 },
	{ services.CarryService, "Step", 0.2 },
	{ services.ConveyorService, "Step", 1 },
	{ services.FruitService, "Step", 1 },
	{ services.MutationService, "Step", 1 },
	{ services.EggHeistService, "Step", 0.5 },
	{ services.ZoneService, "Step", 1.5 },
	{ services.RewardsService, "Step", 5 },
}
local accum = {}
for i in jobs do
	accum[i] = 0
end

RunService.Heartbeat:Connect(function(dt)
	for i, job in jobs do
		accum[i] += dt
		local interval = job[3]
		if accum[i] >= interval then
			local step = accum[i]
			accum[i] = 0
			local service = job[1]
			local ok, err = pcall(service[job[2]], service, math.min(step, interval * 3))
			if not ok then
				warn(("[Main] %s.%s error: %s"):format(tostring(service.Name or "?"), job[2], tostring(err)))
			end
		end
	end
end)

print("[Grow Your Pets] server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="28">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">AnnounceService</string>
            <string name="Source"><![CDATA[--[[
	AnnounceService: toasts for one player, banners for the server, and
	cross-server banners via MessagingService for the moments people clip
	(Secret hatches, Dragon Egg steals, nukes).
]]

local MessagingService = game:GetService("MessagingService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)

local TOPIC = "GrowYourPets_Announce"

local AnnounceService = { Name = "AnnounceService" }

local lastGlobal = 0

function AnnounceService:Start()
	if RunService:IsStudio() then
		return
	end
	task.spawn(function()
		local ok, err = pcall(function()
			MessagingService:SubscribeAsync(TOPIC, function(message)
				local payload = message.Data
				if type(payload) == "table" and payload.jobId ~= game.JobId then
					Net.Event("Announce"):FireAllClients(payload.text, payload.style, true)
				end
			end)
		end)
		if not ok then
			warn("[AnnounceService] subscribe failed:", err)
		end
	end)
end

-- style: "info" | "good" | "warn" | "error" | "levelup" | "reward"
function AnnounceService:Notify(player: Player, text: string, style: string?)
	Net.Event("Notify"):FireClient(player, text, style or "info")
end

-- Big banner for everyone in this server; optionally every server.
function AnnounceService:Announce(text: string, style: string?, global: boolean?)
	Net.Event("Announce"):FireAllClients(text, style or "info", false)
	if global and not RunService:IsStudio() and os.clock() - lastGlobal > 5 then
		lastGlobal = os.clock()
		task.spawn(function()
			pcall(function()
				MessagingService:PublishAsync(TOPIC, { text = text, style = style, jobId = game.JobId })
			end)
		end)
	end
end

return AnnounceService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">CarryService</string>
            <string name="Source"><![CDATA[--[[
	CarryService: "steal it and run" for both stolen Mutation Capsules and
	heist eggs.

	While carrying, the loot floats over your head with a big red label so
	everyone can see you, you move slower (unless mounted), and:
	  * the victim's pets hunt you (PetAIService -> Catch)
	  * heist guardians chase you (ZombieService)
	  * any hit from a zombie/guardian makes you drop it
	  * dying, leaving or timing out drops it
	Reach the delivery point (your base) and it's yours.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local StudStyle = require(Shared.Art.StudStyle)
local Protocol = require(Shared.Util.EntityProtocol)

local EV = Protocol.Event

local CarryService = { Name = "CarryService" }

local S
local carrying: { [Player]: any } = {}

function CarryService:Init(services)
	S = services
end

function CarryService:Start()
	Players.PlayerRemoving:Connect(function(player)
		self:Drop(player, "left")
	end)
	Players.PlayerAdded:Connect(function(player)
		self:WatchDeaths(player)
	end)
	for _, player in Players:GetPlayers() do
		self:WatchDeaths(player)
	end
end

function CarryService:WatchDeaths(player: Player)
	player.CharacterAdded:Connect(function(character)
		local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
		if humanoid then
			humanoid.Died:Connect(function()
				self:Drop(player, "died")
			end)
		end
	end)
end

function CarryService:IsCarrying(player: Player): boolean
	return carrying[player] ~= nil
end

function CarryService:Get(player: Player)
	return carrying[player]
end

--[[
	opts = {
		kind, label, victim?, speedMult, timeout,
		visual(parent, cf) -> Model,
		deliverCheck() -> boolean,
		onDeliver(), onDrop(reason),
		pursuers = encounter?  (heist)
	}
]]
function CarryService:StartCarry(player: Player, opts): boolean
	if carrying[player] then
		return false
	end
	local character = player.Character
	local head = character and character:FindFirstChild("Head") :: BasePart?
	if not head then
		return false
	end
	local folder = Instance.new("Model")
	folder.Name = "CarriedLoot"
	local model = opts.visual(folder, head.CFrame * CFrame.new(0, 3.5, 0))
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = false
			p.Massless = true
			p.CanCollide = false
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = p
			weld.Part1 = head
			weld.Parent = p
		end
	end
	local primary = model.PrimaryPart
	if primary then
		local label = StudStyle.Label(primary, opts.label, Color3.fromRGB(255, 90, 90), 400, 1.1)
		label.AlwaysOnTop = true
	end
	folder.Parent = character

	carrying[player] = {
		opts = opts,
		visual = folder,
		startedAt = os.clock(),
	}
	player:SetAttribute("Carrying", opts.kind)
	S.MountService:RefreshSpeed(player)
	S.AnnounceService:Notify(player, "RUN! Get it back to your base!", "warn")
	return true
end

function CarryService:Step(_dt: number)
	local now = os.clock()
	for player, c in carrying do
		if not player.Parent or not player.Character then
			self:Drop(player, "left")
		elseif c.opts.deliverCheck() then
			self:Deliver(player)
		elseif now - c.startedAt > (c.opts.timeout or 120) then
			self:Drop(player, "timeout")
		end
	end
end

function CarryService:Finish(player: Player)
	local c = carrying[player]
	if not c then
		return nil
	end
	carrying[player] = nil
	if c.visual then
		c.visual:Destroy()
	end
	player:SetAttribute("Carrying", nil)
	S.MountService:RefreshSpeed(player)
	return c
end

function CarryService:Deliver(player: Player)
	local c = self:Finish(player)
	if c then
		c.opts.onDeliver()
		S.AnnounceService:Notify(player, "✅ Delivered!", "reward")
	end
end

function CarryService:Drop(player: Player, reason: string)
	local c = self:Finish(player)
	if not c then
		return
	end
	c.opts.onDrop(reason)
	if player.Parent then
		local text = if reason == "caught" then "You got caught! Loot returned."
			elseif reason == "hit" then "You got hit and dropped it!"
			elseif reason == "timeout" then "Too slow! The loot vanished back home."
			else "You dropped the loot!"
		S.AnnounceService:Notify(player, text, "error")
	end
end

-- Zombies / guardians hitting a carrier make them drop the loot.
function CarryService:OnCarrierHit(player: Player, _source)
	if carrying[player] then
		self:Drop(player, "hit")
	end
end

-- Victim's pet reached the thief.
function CarryService:Catch(thief: Player, victim: Player, pet)
	local c = carrying[thief]
	if not c or c.opts.victim ~= victim then
		return
	end
	S.EntityService:Event(pet.pos, { EV.Text, pet.id, "CAUGHT YOU!", "#FF5050" })
	self:Drop(thief, "caught")
end

-- Everyone currently carrying loot stolen from `victim`.
function CarryService:ThievesFrom(victim: Player)
	local list = {}
	for player, c in carrying do
		if c.opts.victim == victim then
			local root = S.EntityService:RootOf(player)
			if root then
				table.insert(list, { player = player, pos = root.Position })
			end
		end
	end
	return list
end

return CarryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--[[
	CombatService: all damage flows through here so fruit passives, brainrot
	mutation specials, statuses and kill credit behave the same whether the
	hit came from a pet, a mounted attack, an ability or a turret.

	Statuses live in entity.effects:
	  burn   { dps, untilT, source }
	  slow   { mult, untilT }
	  stun   { untilT, kind = "Frozen" | "Stunned" }
	  launch { t0, dur, height }     -- zombie flies up (great for clips)
	  vulnerable = untilT            -- takes +50% damage (Rizz Aura charm)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Protocol = require(Shared.Util.EntityProtocol)
local Fruits = require(Shared.Config.Fruits)

local EV = Protocol.Event
local State = Protocol.State

local CombatService = { Name = "CombatService" }

local S

function CombatService:Init(services)
	S = services
end

local function event(target, ev)
	S.EntityService:Event(target.pos, ev, target.visibleTo)
end

function CombatService:Text(entity, text: string, color: string?)
	event(entity, { EV.Text, entity.id, text, color or "#FFFFFF" })
end

----------------------------------------------------------------------------
-- Core damage
----------------------------------------------------------------------------

-- opts: { fx, status, canCrit, silent }
function CombatService:Damage(attacker, target, amount: number, opts: { [string]: any }?): number
	local o = opts or {}
	if not target or target.dead or target.removed then
		return 0
	end
	local now = os.clock()
	local tstats = target.stats
	if tstats and tstats.dodge > 0 and math.random() < tstats.dodge then
		self:Text(target, "DODGE", "#DDDDDD")
		return 0
	end

	local crit = false
	if attacker and not attacker.removed then
		local astats = attacker.stats
		if astats then
			if o.canCrit ~= false and math.random() < astats.critChance then
				crit = true
				amount *= 2
			end
			local sp = astats.special
			if target.boss and sp.bossDamage then
				amount *= sp.bossDamage
			end
			if sp.auraPerStack and (attacker.aura or 0) > 0 then
				amount *= 1 + attacker.aura * sp.auraPerStack
			end
		end
		local buff = attacker.buff
		if buff and now < buff.untilT then
			amount *= buff.power or 1
		end
	end

	if tstats then
		amount *= tstats.damageTaken
	end
	if target.effects.vulnerable and now < target.effects.vulnerable then
		amount *= 1.5
	end
	amount = math.max(1, math.floor(amount + 0.5))

	target.hp -= amount
	target.lastHitAt = now
	target.lastAttacker = attacker
	if not o.silent then
		event(target, { EV.Hit, if attacker then attacker.id else 0, target.id, amount, crit, o.fx or "" })
	end
	if o.status then
		self:ApplyStatus(target, o.status, attacker)
	end
	if target.hp <= 0 then
		self:Kill(target, attacker, o)
	end
	return amount
end

function CombatService:Kill(target, killer, opts)
	if target.dead then
		return
	end
	target.dead = true
	target.hp = 0
	target.state = State.Dead
	if target.kind == "Zombie" then
		S.ZombieService:OnKilled(target, killer, opts)
	elseif target.kind == "Pet" then
		S.PetService:OnFainted(target, killer)
	end
end

----------------------------------------------------------------------------
-- Pet basic attack: fruit passives + brainrot mutation specials
----------------------------------------------------------------------------

function CombatService:PetBasicHit(pet, target, baseDamage: number, fx: string?)
	local stats = pet.stats
	local sp = stats.special
	local fruit = pet.fruitId and Fruits.List[pet.fruitId]
	local onHit = fruit and fruit.onHit
	pet.hitCount = (pet.hitCount or 0) + 1

	local dmg = baseDamage
	local status = nil
	local chain = nil
	if sp.everyNthHit and pet.hitCount % sp.everyNthHit == 0 then
		dmg *= sp.nthMult
		self:Text(target, "🤲 SIX SEVEN!!", "#FFD23F")
	end
	if onHit and math.random() < (onHit.chance or 1) then
		if onHit.status == "SixSeven" then
			dmg *= onHit.mult
			self:Text(target, "6.7x OHIO CRIT", "#FF46D2")
		elseif onHit.status == "Chain" then
			chain = onHit
		else
			status = onHit
		end
	end

	self:Damage(pet, target, dmg, { fx = fx or (fruit and fruit.element) or "Hit", status = status })

	if sp.charmChance and not target.dead and math.random() < sp.charmChance then
		self:ApplyStatus(target, { status = "Mesmerize", duration = sp.charmDuration or 2 }, pet)
		self:Text(target, "💖 rizzed", "#FF7AC8")
	end
	if chain then
		self:ChainFrom(pet, target, chain.jumps, chain.jumpRange, baseDamage * chain.damageMult, nil, "Volt")
	end
	if onHit and onHit.splash then
		for _, z in S.ZombieService:Query(target.pos, onHit.splash, pet.ownerId) do
			if z ~= target then
				self:Damage(pet, z, dmg * onHit.splashMult, { fx = "Splash", canCrit = false })
			end
		end
	end
	if sp.repeatHit then
		task.delay(sp.repeatHit, function()
			if not target.dead and not pet.removed then
				self:Damage(pet, target, dmg, { fx = "Lag", canCrit = false })
				self:Text(target, "📶 lag", "#9AE6FF")
			end
		end)
	end
end

----------------------------------------------------------------------------
-- Area helpers (abilities, mounted attacks, turrets)
----------------------------------------------------------------------------

function CombatService:Burst(attacker, center: Vector3, radius: number, damage: number, status, fx: string, viewerId: number?): number
	local hits = 0
	for _, z in S.ZombieService:Query(center, radius, viewerId) do
		self:Damage(attacker, z, damage, { fx = fx, status = status })
		hits += 1
	end
	S.EntityService:Event(center, { EV.Ability, if attacker then attacker.id else 0, fx, center.X, center.Z, radius, 0, 0 }, if attacker then attacker.visibleTo else nil)
	return hits
end

function CombatService:Cone(attacker, origin: Vector3, dir: Vector3, range: number, angleDeg: number, damage: number, status, fx: string, viewerId: number?): number
	local flatDir = Vector3.new(dir.X, 0, dir.Z)
	if flatDir.Magnitude < 1e-3 then
		return 0
	end
	flatDir = flatDir.Unit
	local cosHalf = math.cos(math.rad(angleDeg / 2))
	local hits = 0
	for _, z in S.ZombieService:Query(origin, range + 3, viewerId) do
		local to = Vector3.new(z.pos.X - origin.X, 0, z.pos.Z - origin.Z)
		local dist = to.Magnitude
		if dist < 2 or (dist <= range + z.radius and to.Unit:Dot(flatDir) >= cosHalf) then
			self:Damage(attacker, z, damage, { fx = fx, status = status })
			hits += 1
		end
	end
	S.EntityService:Event(origin, { EV.Ability, if attacker then attacker.id else 0, fx, origin.X, origin.Z, range, flatDir.X, flatDir.Z }, if attacker then attacker.visibleTo else nil)
	return hits
end

-- Hops from `first` to the nearest un-hit zombie, `jumps` times.
function CombatService:ChainFrom(attacker, first, jumps: number, range: number, damage: number, status, fx: string, includeFirst: boolean?): number
	local hit = { [first.id] = true }
	local ids = { first.id }
	if includeFirst then
		self:Damage(attacker, first, damage, { fx = fx, status = status, canCrit = false })
	end
	local current = first
	for _ = 1, jumps do
		local best, bestD = nil, range * range
		for _, z in S.ZombieService:Query(current.pos, range, attacker and attacker.ownerId) do
			if not hit[z.id] then
				local d = z.pos - current.pos
				local d2 = d.X * d.X + d.Z * d.Z
				if d2 < bestD then
					best, bestD = z, d2
				end
			end
		end
		if not best then
			break
		end
		hit[best.id] = true
		table.insert(ids, best.id)
		self:Damage(attacker, best, damage, { fx = fx, status = status, canCrit = false })
		current = best
	end
	S.EntityService:Event(first.pos, { EV.Chain, ids, fx }, if attacker then attacker.visibleTo else nil)
	return #ids
end

----------------------------------------------------------------------------
-- Statuses
----------------------------------------------------------------------------

function CombatService:ApplyStatus(target, s, attacker)
	if target.dead then
		return
	end
	local now = os.clock()
	local e = target.effects
	local duration = s.duration or 1
	local kind = s.status
	if kind == "Burn" then
		local power = if attacker and attacker.stats then attacker.stats.power else 5
		e.burn = { dps = power * s.dps, untilT = now + duration, source = attacker }
	elseif kind == "Chill" then
		e.slow = { mult = 1 - s.slow, untilT = now + duration }
	elseif kind == "Freeze" then
		duration *= if target.boss then 0.35 else 1
		e.stun = { untilT = now + duration, kind = "Frozen" }
	elseif kind == "Shock" then
		duration *= if target.boss then 0.35 else 1
		e.stun = { untilT = now + duration, kind = "Stunned" }
	elseif kind == "Mesmerize" then
		e.stun = { untilT = now + duration * (if target.boss then 0.3 else 1), kind = "Stunned" }
		e.vulnerable = now + duration
	elseif kind == "Launch" then
		if target.boss then
			return
		end
		duration = 1.1
		e.launch = { t0 = now, dur = duration, height = s.height or 12 }
		e.stun = { untilT = now + duration, kind = "Stunned" }
	else
		return
	end
	S.EntityService:Event(target.pos, { EV.Status, target.id, kind, duration }, target.visibleTo)
end

-- Advances statuses. Returns speedMult, stunKind (or nil), yOffset.
function CombatService:StepEffects(entity, dt: number, now: number): (number, string?, number)
	local e = entity.effects
	local speed = 1
	local stun = nil
	local yOffset = 0
	if e.burn then
		if now > e.burn.untilT then
			e.burn = nil
		else
			local source = e.burn.source
			if source and source.removed then
				source = nil
			end
			self:Damage(source, entity, e.burn.dps * dt, { silent = true, canCrit = false })
		end
	end
	if e.slow then
		if now > e.slow.untilT then
			e.slow = nil
		else
			speed *= e.slow.mult
		end
	end
	if e.stun then
		if now > e.stun.untilT then
			e.stun = nil
		else
			stun = e.stun.kind
		end
	end
	if e.launch then
		local t = (now - e.launch.t0) / e.launch.dur
		if t >= 1 then
			e.launch = nil
		else
			yOffset = e.launch.height * 4 * t * (1 - t)
		end
	end
	return speed, stun, yOffset
end

----------------------------------------------------------------------------
-- Players
----------------------------------------------------------------------------

function CombatService:DamagePlayer(player: Player, amount: number, source)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	if character:FindFirstChildOfClass("ForceField") then
		return
	end
	humanoid:TakeDamage(amount)
	S.CarryService:OnCarrierHit(player, source)
end

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">ConveyorService</string>
            <string name="Source"><![CDATA[--[[
	ConveyorService: the tycoon half of every base.

	Droppers drop Mutagen Goo onto the belt; the collector sells it. The
	server never moves items. It credits income once per second from a
	formula, and clients draw the goo sliding along the belt at the same
	rate (see client ConveyorVisuals). Zero physics, zero network per item.

	Income/s = sum(dropper value * (1 + level * 0.35)) / dropInterval
	           * beltSpeed * (2 with the 2x Conveyor pass) * coin mults

	The Brainrot Extractor rolls a Mutation Capsule on a timer and drops it
	into your vault, where other players can try to steal it.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Base = require(Shared.Config.Base)
local Progression = require(Shared.Config.Progression)
local StudStyle = require(Shared.Art.StudStyle)
local Format = require(Shared.Util.Format)

local C = StudStyle.Colors
local CONV = Base.Conveyor

local ConveyorService = { Name = "ConveyorService" }

local S
local active: { [Player]: any } = {}

local DROPPER_COLORS = {
	Color3.fromRGB(120, 200, 255),
	Color3.fromRGB(120, 230, 120),
	Color3.fromRGB(255, 210, 80),
	Color3.fromRGB(255, 130, 60),
	Color3.fromRGB(220, 90, 255),
	Color3.fromRGB(255, 70, 120),
}

function ConveyorService:Init(services)
	S = services
end

function ConveyorService:Start() end

----------------------------------------------------------------------------
-- Economy
----------------------------------------------------------------------------

function ConveyorService:BeltSpeed(player: Player): number
	local d = S.DataService:Get(player)
	local speed = CONV.belts[d.base.belt].speed
	if S.MonetizationService:HasPass(player, "DoubleConveyor") then
		speed *= 2
	end
	return speed
end

-- Returns coins/s and mutagen/s before coin multipliers.
function ConveyorService:Rates(player: Player): (number, number)
	local d = S.DataService:Get(player)
	if not d then
		return 0, 0
	end
	local coins, mutagen = 0, 0
	for i, level in d.base.droppers do
		local def = CONV.droppers[i]
		if def and level > 0 then
			local mult = 1 + (level - 1) * CONV.dropperLevelMult
			coins += def.value * mult
			mutagen += def.mutagen * mult
		end
	end
	local speed = self:BeltSpeed(player)
	return coins / CONV.dropInterval * speed, mutagen / CONV.dropInterval * speed
end

function ConveyorService:Step(dt: number)
	local now = os.clock()
	for player, state in active do
		local coinsPerSec, mutagenPerSec = self:Rates(player)
		S.DataService:Add(player, "coins", coinsPerSec * dt)
		state.mutagenAcc += mutagenPerSec * dt
		if state.mutagenAcc >= 1 then
			local whole = math.floor(state.mutagenAcc)
			state.mutagenAcc -= whole
			S.DataService:Add(player, "mutagen", whole, true)
		end
		local d = S.DataService:Get(player)
		local ex = CONV.extractors[d.base.extractor]
		if ex and now >= state.nextCapsule then
			state.nextCapsule = now + ex.interval
			S.MutationService:AddCapsule(player, S.MutationService:RollMutation(ex.rarityBias), "extractor")
		end
	end
end

function ConveyorService:OnPlotAssigned(player: Player, plot)
	local d = S.DataService:Get(player)
	local state = { plot = plot, mutagenAcc = 0, nextCapsule = os.clock() + 30 }
	active[player] = state
	self:Rebuild(player)

	-- Offline earnings: a reason to come back tomorrow.
	if d.lastOnline and d.lastOnline > 0 then
		local cap = if S.MonetizationService:IsVIP(player) then Progression.OfflineCapSecondsVip else Progression.OfflineCapSeconds
		local away = math.min(os.time() - d.lastOnline, cap)
		if away > 60 then
			local rate = self:Rates(player)
			local earned = S.DataService:Add(player, "coins", rate * away * Progression.OfflineRate)
			if earned >= 1 then
				S.AnnounceService:Notify(player, ("💤 Your conveyor earned 💰%s while you were away (%s)"):format(Format.Short(earned), Format.Duration(away)), "reward")
			end
		end
	end
end

function ConveyorService:OnPlotReleased(plot)
	for player, state in active do
		if state.plot == plot then
			if state.model then
				state.model:Destroy()
			end
			active[player] = nil
		end
	end
	plot.info:SetAttribute("Droppers", nil)
end

----------------------------------------------------------------------------
-- Visuals + buy buttons
----------------------------------------------------------------------------

local function at(plot, pos: Vector3): Vector3
	return plot.cf:PointToWorldSpace(pos)
end

local function lcf(plot, pos: Vector3): CFrame
	return plot.cf * CFrame.new(pos)
end

function ConveyorService:Rebuild(player: Player)
	local state = active[player]
	local d = S.DataService:Get(player)
	if not state or not d then
		return
	end
	local plot = state.plot
	if state.model then
		state.model:Destroy()
	end
	local m = StudStyle.Model(plot.model, "Conveyor")
	state.model = m

	-- Belt
	local startP, finishP = CONV.start, CONV.finish
	local len = (finishP - startP).Magnitude
	local mid = (startP + finishP) / 2
	StudStyle.Block(m, Vector3.new(5, 1.2, len), lcf(plot, mid + Vector3.new(0, 0.6, 0)), C.Belt, { studs = false, material = Enum.Material.SmoothPlastic, name = "Belt" })
	for _, sx in { -1, 1 } do
		StudStyle.Block(m, Vector3.new(0.6, 1.8, len), lcf(plot, mid + Vector3.new(sx * 2.8, 0.9, 0)), Color3.fromRGB(250, 200, 40), { studs = false, material = Enum.Material.SmoothPlastic })
	end
	-- Collector
	local bin = StudStyle.OnGround(m, Vector3.new(7, 4, 6), at(plot, finishP + Vector3.new(0, 0, 3)), Color3.fromRGB(60, 160, 80))
	StudStyle.Neon(m, Vector3.new(6, 0.3, 5), lcf(plot, finishP + Vector3.new(0, 4.1, 3)), Color3.fromRGB(120, 255, 140))
	StudStyle.Label(bin, "💰 SELL", Color3.fromRGB(140, 255, 150), 80, 0.8)

	-- Belt upgrade button
	local beltLevel = d.base.belt
	local nextBelt = CONV.belts[beltLevel + 1]
	local beltPad = StudStyle.OnGround(m, Vector3.new(4, 0.8, 4), at(plot, startP + Vector3.new(0, 0, -6)), Color3.fromRGB(250, 200, 40), { name = "BeltButton" })
	StudStyle.Label(beltPad, ("⏩ Belt Lv%d"):format(beltLevel), Color3.fromRGB(255, 230, 120), 50, 0.6)
	if nextBelt then
		self:Button(player, beltPad, "Upgrade Belt", "💰" .. Format.Short(nextBelt.price), function()
			self:Buy(player, nextBelt.price, function()
				d.base.belt += 1
			end, "Belt upgraded!")
		end)
	end

	-- Droppers
	for i, def in CONV.droppers do
		local level = d.base.droppers[i] or 0
		local pos = def.offset
		if level > 0 then
			local color = DROPPER_COLORS[i]
			local tower = StudStyle.OnGround(m, Vector3.new(4, 6, 4), at(plot, pos), color, { name = "Dropper" .. i })
			StudStyle.Block(m, Vector3.new(4.5, 1, 4.5), lcf(plot, pos + Vector3.new(0, 6.5, 0)), C.DarkStone)
			local chuteDir = if pos.X < CONV.start.X then 1 else -1
			StudStyle.Block(m, Vector3.new(3.5, 1, 1.4), lcf(plot, pos + Vector3.new(chuteDir * 3.2, 4.6, 0)), C.DarkStone, { shadow = false })
			StudStyle.Label(tower, ("Dropper %d · Lv%d"):format(i, level), color, 60, 0.6)
			local cost = CONV.dropperUpgradeCost(i, level)
			self:Button(player, tower, ("Upgrade Dropper %d"):format(i), "💰" .. Format.Short(cost), function()
				self:Buy(player, cost, function()
					d.base.droppers[i] = level + 1
				end, ("Dropper %d is now Lv%d"):format(i, level + 1))
			end)
		else
			local prev = if i == 1 then 1 else d.base.droppers[i - 1] or 0
			if prev > 0 then
				local pad = StudStyle.OnGround(m, Vector3.new(4, 0.8, 4), at(plot, pos), Color3.fromRGB(90, 200, 90), { name = "DropperPad" .. i })
				StudStyle.Label(pad, ("➕ Dropper %d"):format(i), Color3.fromRGB(160, 255, 160), 50, 0.6)
				self:Button(player, pad, ("Buy Dropper %d"):format(i), "💰" .. Format.Short(def.price), function()
					self:Buy(player, def.price, function()
						d.base.droppers[i] = 1
					end, ("Dropper %d built!"):format(i))
				end)
			end
		end
	end

	-- Brainrot Extractor
	local exLevel = d.base.extractor
	local nextEx = CONV.extractors[exLevel + 1]
	local exPos = CONV.extractorOffset
	local machine
	if exLevel > 0 then
		machine = StudStyle.OnGround(m, Vector3.new(7, 7, 7), at(plot, exPos), Color3.fromRGB(150, 70, 220), { name = "Extractor" })
		StudStyle.Neon(m, Vector3.new(4, 3, 4), lcf(plot, exPos + Vector3.new(0, 8.5, 0)), Color3.fromRGB(255, 120, 220))
		StudStyle.Label(machine, ("🧠 Brainrot Extractor Lv%d"):format(exLevel), Color3.fromRGB(255, 160, 255), 70, 0.7)
	else
		machine = StudStyle.OnGround(m, Vector3.new(6, 0.8, 6), at(plot, exPos), Color3.fromRGB(150, 70, 220), { name = "ExtractorPad" })
		StudStyle.Label(machine, "🧠 Build Brainrot Extractor", Color3.fromRGB(255, 160, 255), 60, 0.6)
	end
	if nextEx then
		self:Button(player, machine, if exLevel == 0 then "Build Extractor" else "Upgrade Extractor", "💰" .. Format.Short(nextEx.price), function()
			self:Buy(player, nextEx.price, function()
				d.base.extractor += 1
			end, "🧠 Extractor upgraded: capsules roll faster and rarer!")
		end)
	end

	-- Client visuals read these
	local levels = {}
	for i = 1, #CONV.droppers do
		levels[i] = tostring(d.base.droppers[i] or 0)
	end
	plot.info:SetAttribute("Droppers", table.concat(levels, ","))
	plot.info:SetAttribute("BeltSpeed", self:BeltSpeed(player))
	local coinsPerSec = self:Rates(player)
	plot.info:SetAttribute("IncomePerSec", coinsPerSec * S.DataService:CoinMultiplier(player))
end

function ConveyorService:Button(player: Player, part: BasePart, action: string, cost: string, onBuy: () -> ())
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = cost
	p.HoldDuration = 0.2
	p.MaxActivationDistance = 11
	p.RequiresLineOfSight = false
	p:SetAttribute("OwnerUserId", player.UserId)
	CollectionService:AddTag(p, "OwnerOnlyPrompt")
	p.Parent = part
	p.Triggered:Connect(function(who)
		if who == player then
			onBuy()
		end
	end)
end

function ConveyorService:Buy(player: Player, price: number, apply: () -> (), message: string)
	if not S.DataService:Spend(player, "coins", price) then
		S.AnnounceService:Notify(player, ("Need 💰%s"):format(Format.Short(price)), "warn")
		return
	end
	apply()
	S.DataService:Replicate(player, "base")
	S.AnnounceService:Notify(player, message, "good")
	self:Rebuild(player)
end

-- Rebirth wipes the conveyor; called by RewardsService.
function ConveyorService:ResetForRebirth(player: Player)
	local d = S.DataService:Get(player)
	d.base.droppers = { 1, 0, 0, 0, 0, 0 }
	d.base.belt = 1
	S.DataService:Replicate(player, "base")
	self:Rebuild(player)
end

return ConveyorService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--[[
	DataService: player profiles.

	* UpdateAsync with a session lock (jobId + timestamp) so two servers can
	  never both own a profile (prevents duplication exploits on teleports).
	* Autosave every 120s, save on leave, BindToClose flush.
	* Falls back to an in-memory profile when DataStores are unavailable
	  (Studio without API access), and tells the player it won't save.
	* Services mutate `profile.data` directly, then call Replicate(key).
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Format = require(Shared.Util.Format)
local Progression = require(Shared.Config.Progression)

local STORE_NAME = "GrowYourPets_Profiles_v1"
local LOCK_EXPIRY = 600
local AUTOSAVE = 120

local DataService = {
	Name = "DataService",
	PlayerLoaded = Signal.new(),
	PlayerLeaving = Signal.new(),
	LevelUp = Signal.new(),
}

local S -- services
local store: DataStore? = nil
local profiles: { [Player]: { data: any, noSave: boolean, leaving: boolean } } = {}

local function defaultData()
	return {
		version = 1,
		coins = 300,
		mutagen = 0,
		gems = 0,
		level = 1,
		xp = 0,
		rebirths = 0,
		pets = {},
		equipped = {},
		alpha = nil,
		fruits = {},
		capsules = {},
		incubators = {},
		base = {
			droppers = { 1, 0, 0, 0, 0, 0 },
			belt = 1,
			extractor = 0,
			defenses = {},
			bestWave = 0,
			wave = 0,
		},
		heistTickets = 1,
		lastTicketRegen = os.time(),
		lastVipTickets = 0,
		heistCooldowns = {},
		dungeonCooldown = 0,
		daily = { streak = 0, lastClaim = 0 },
		quests = { day = 0, list = {}, claimed = {} },
		stats = {
			zombiesKilled = 0,
			bossesKilled = 0,
			wavesCleared = 0,
			eggsHatched = 0,
			fruitsCollected = 0,
			fruitsEaten = 0,
			heistsWon = 0,
			capsulesStolen = 0,
			playtime = 0,
		},
		codes = {},
		lastFruitDealer = 0,
		lastOnline = 0,
		purchases = {},
		purchaseOrder = {},
		extraVault = 0,
		firstJoin = os.time(),
		settings = { autoWave = true },
		tutorial = 0,
	}
end

-- Fill keys added in later versions without touching existing values.
local function reconcile(data, template)
	for key, value in template do
		if data[key] == nil then
			data[key] = if type(value) == "table" then table.clone(value) else value
		elseif type(value) == "table" and type(data[key]) == "table" and next(value) ~= nil and #value == 0 then
			reconcile(data[key], value)
		end
	end
end

local function keyFor(player: Player): string
	return "u_" .. player.UserId
end

function DataService:Init(services)
	S = services
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore unavailable, running in memory:", result)
	end
end

function DataService:Start()
	Players.PlayerAdded:Connect(function(player)
		self:Load(player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(self.Load, self, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		self:Release(player)
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				self:Save(player, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.2)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE)
			for player in profiles do
				task.spawn(self.Save, self, player, false)
				task.wait(0.5)
			end
		end
	end)
end

function DataService:Load(player: Player)
	local data = nil
	local noSave = false
	if store then
		local ds = store :: DataStore
		for attempt = 1, 5 do
			local lockedBy = nil
			local ok, err = pcall(function()
				ds:UpdateAsync(keyFor(player), function(old)
					old = old or defaultData()
					local session = old.session
					if session and session.jobId ~= game.JobId and os.time() - session.time < LOCK_EXPIRY and attempt < 4 then
						lockedBy = session.jobId
						return nil
					end
					old.session = { jobId = game.JobId, time = os.time() }
					data = old
					return old
				end)
			end)
			if ok and data then
				break
			end
			if not ok then
				warn("[DataService] load failed:", err)
			elseif lockedBy then
				warn("[DataService] profile locked by", lockedBy, "retrying")
			end
			if not player.Parent then
				return
			end
			task.wait(if lockedBy then 6 else 2 ^ attempt)
		end
	end
	if not data then
		if store and not RunService:IsStudio() then
			player:Kick("Could not load your farm. Please rejoin in a moment!")
			return
		end
		data = defaultData()
		noSave = true
	end
	if not player.Parent then
		return
	end

	reconcile(data, defaultData())
	profiles[player] = { data = data, noSave = noSave, leaving = false }

	local isNew = next(data.pets) == nil
	if isNew then
		-- Starter pet so the loop begins instantly: you hatch a friend in
		-- the first minute and it already follows you.
		local uid = self:NewUid()
		data.pets[uid] = { uid = uid, species = "Pup", level = 1, xp = 0, variant = "Normal", mutations = {} }
		data.equipped = { uid }
		data.alpha = uid
	end

	self:CreateLeaderstats(player)
	-- Pass/VIP/policy info must be known before squads, plots and rewards
	-- react to PlayerLoaded (equip slots, luck, vault size depend on it).
	S.MonetizationService:LoadPlayer(player)
	if not player.Parent then
		profiles[player] = nil
		return
	end
	Net.Event("Init"):FireClient(player, self:ClientSnapshot(player))
	if noSave then
		S.AnnounceService:Notify(player, "Studio mode: progress will not save (enable API access to test saving).", "warn")
	end
	self.PlayerLoaded:Fire(player, data, isNew)
end

function DataService:Save(player: Player, release: boolean)
	local profile = profiles[player]
	if not profile or profile.noSave or not store then
		return
	end
	local data = profile.data
	data.lastOnline = os.time()
	local ds = store :: DataStore
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			ds:UpdateAsync(keyFor(player), function(old)
				if old and old.session and old.session.jobId ~= game.JobId then
					-- Someone else owns this profile now; never overwrite them.
					return nil
				end
				data.session = if release then nil else { jobId = game.JobId, time = os.time() }
				return data
			end)
		end)
		if ok then
			return
		end
		warn("[DataService] save failed:", err)
		task.wait(attempt)
	end
end

function DataService:Release(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	profile.leaving = true
	self.PlayerLeaving:Fire(player, profile.data)
	self:Save(player, true)
	profiles[player] = nil
end

function DataService:Get(player: Player)
	local profile = profiles[player]
	return profile and profile.data
end

function DataService:IsLoaded(player: Player): boolean
	return profiles[player] ~= nil
end

function DataService:NewUid(): string
	return HttpService:GenerateGUID(false):gsub("-", ""):sub(1, 12)
end

-- What the client needs to draw every panel.
function DataService:ClientSnapshot(player: Player)
	local d = self:Get(player)
	return {
		coins = d.coins,
		mutagen = d.mutagen,
		gems = d.gems,
		level = d.level,
		xp = d.xp,
		rebirths = d.rebirths,
		pets = d.pets,
		equipped = d.equipped,
		alpha = d.alpha,
		fruits = d.fruits,
		capsules = d.capsules,
		incubators = d.incubators,
		base = d.base,
		heistTickets = d.heistTickets,
		daily = d.daily,
		quests = d.quests,
		stats = d.stats,
		settings = d.settings,
		lastFruitDealer = d.lastFruitDealer,
		serverTime = os.time(),
	}
end

function DataService:Replicate(player: Player, key: string)
	local d = self:Get(player)
	if d then
		Net.Event("DataChanged"):FireClient(player, key, d[key])
	end
	if key == "coins" or key == "level" then
		self:UpdateLeaderstats(player)
	end
end

function DataService:ReplicatePet(player: Player, uid: string)
	local d = self:Get(player)
	if d then
		Net.Event("DataChanged"):FireClient(player, "pet", uid, d.pets[uid])
	end
end

----------------------------------------------------------------------------
-- Currency / XP helpers
----------------------------------------------------------------------------

function DataService:CoinMultiplier(player: Player): number
	local d = self:Get(player)
	if not d then
		return 1
	end
	local mult = 1 + d.rebirths * Progression.Rebirth.coinBonusPerRebirth
	mult *= S.MonetizationService:CoinMult(player)
	return mult
end

-- Adds currency. Coins get rebirth/VIP multipliers unless raw = true.
function DataService:Add(player: Player, currency: string, amount: number, raw: boolean?): number
	local d = self:Get(player)
	if not d or amount == 0 then
		return 0
	end
	if currency == "coins" and amount > 0 and not raw then
		amount *= self:CoinMultiplier(player)
	end
	d[currency] = (d[currency] or 0) + amount
	self:Replicate(player, currency)
	return amount
end

function DataService:Spend(player: Player, currency: string, amount: number): boolean
	local d = self:Get(player)
	if not d or amount < 0 or (d[currency] or 0) < amount then
		return false
	end
	d[currency] -= amount
	self:Replicate(player, currency)
	return true
end

function DataService:AddXP(player: Player, amount: number)
	local d = self:Get(player)
	if not d then
		return
	end
	d.xp += amount
	local leveled = false
	while d.xp >= Progression.PlayerXpToNext(d.level) do
		d.xp -= Progression.PlayerXpToNext(d.level)
		d.level += 1
		leveled = true
	end
	self:Replicate(player, "xp")
	if leveled then
		self:Replicate(player, "level")
		S.AnnounceService:Notify(player, ("LEVEL UP! You are now Lv %d"):format(d.level), "levelup")
		self.LevelUp:Fire(player, d.level)
	end
end

function DataService:IncrementStat(player: Player, stat: string, n: number?)
	local d = self:Get(player)
	if not d then
		return
	end
	d.stats[stat] = (d.stats[stat] or 0) + (n or 1)
end

----------------------------------------------------------------------------
-- Leaderstats (abbreviated strings so big numbers stay readable)
----------------------------------------------------------------------------

function DataService:CreateLeaderstats(player: Player)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local coins = Instance.new("StringValue")
	coins.Name = "Coins"
	coins.Parent = folder
	local level = Instance.new("IntValue")
	level.Name = "Level"
	level.Parent = folder
	folder.Parent = player
	self:UpdateLeaderstats(player)
end

function DataService:UpdateLeaderstats(player: Player)
	local d = self:Get(player)
	local folder = player:FindFirstChild("leaderstats")
	if not d or not folder then
		return
	end
	local coins = folder:FindFirstChild("Coins") :: StringValue?
	local level = folder:FindFirstChild("Level") :: IntValue?
	if coins then
		coins.Value = Format.Short(d.coins)
	end
	if level then
		level.Value = d.level
	end
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">EggHeistService</string>
            <string name="Source"><![CDATA[--[[
	EggHeistService: "Steal an Egg".

	1. Walk to a heist site (Chicken Coop in the Meadow, Dragon's Nest at
	   the far end of the Long Valley) and start a run (the Nest costs a
	   Heist Ticket).
	2. Guardians patrol (visible only to you); the boss guards the egg.
	3. Defeat the boss with your army, hold "Steal Egg".
	4. RUN home down the valley carrying it. Guardians chase you; one hit
	   and the egg flies back to the nest. Your Alpha mount is the escape.
	5. Deliver to your base incubator. It hatches after a timer into a
	   rare/mythical pet (odds shown in the UI).
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local World = require(Shared.Config.World)
local Eggs = require(Shared.Config.Eggs)
local Base = require(Shared.Config.Base)
local StudStyle = require(Shared.Art.StudStyle)
local Props = require(Shared.Art.Props)
local Format = require(Shared.Util.Format)

local RUN_TIMEOUT = 8 * 60
local ABANDON_DIST = 700
local INCUBATOR_SLOTS = 3

local EggHeistService = { Name = "EggHeistService" }

local S
local runs: { [Player]: any } = {}
local incubators: { [Player]: any } = {}
local folder: Folder

function EggHeistService:Init(services)
	S = services
end

function EggHeistService:Start()
	folder = Instance.new("Folder")
	folder.Name = "Heists"
	folder.Parent = workspace
	for id, def in World.Heists do
		self:BuildSite(id, def)
	end
	S.DataService.PlayerLeaving:Connect(function(player)
		self:EndRun(player, false, "left")
	end)
end

----------------------------------------------------------------------------
-- Sites
----------------------------------------------------------------------------

function EggHeistService:SitePositions(def)
	local center = World.Resolve(def.center)
	return center, center + Vector3.new(0, 0, -56), center + Vector3.new(0, 0, 22)
end

function EggHeistService:BuildSite(id: string, def)
	local _, gatePos, pedestalPos = self:SitePositions(def)
	local egg = Eggs.List[def.egg]

	local gate = StudStyle.OnGround(folder, Vector3.new(8, 1, 8), gatePos, Color3.fromRGB(255, 200, 60), { name = id .. "_Start" })
	StudStyle.Label(gate, ("🥚 %s\n%s"):format(def.name, if def.ticket then "Costs 1 🎟️" else "Free · 10 min cooldown"), Color3.fromRGB(255, 220, 120), 120, 1.2)
	local startPrompt = Instance.new("ProximityPrompt")
	startPrompt.ActionText = "Start Heist"
	startPrompt.ObjectText = def.name
	startPrompt.HoldDuration = 0.5
	startPrompt.MaxActivationDistance = 12
	startPrompt.RequiresLineOfSight = false
	startPrompt.Parent = gate
	startPrompt.Triggered:Connect(function(player)
		self:StartRun(player, id)
	end)

	local pedestal = StudStyle.OnGround(folder, Vector3.new(6, 3, 6), pedestalPos, Color3.fromRGB(60, 50, 70), { name = id .. "_Pedestal" })
	Props.Egg(folder, CFrame.new(pedestalPos + Vector3.new(0, 3, 0)), egg, 1.2)
	StudStyle.Label(pedestal, ("%s"):format(egg.displayName), egg.color, 90, 1)
	local stealPrompt = Instance.new("ProximityPrompt")
	stealPrompt.ActionText = "Steal Egg"
	stealPrompt.ObjectText = egg.displayName
	stealPrompt.HoldDuration = 2
	stealPrompt.MaxActivationDistance = 10
	stealPrompt.RequiresLineOfSight = false
	stealPrompt.Parent = pedestal
	stealPrompt.Triggered:Connect(function(player)
		self:StealEgg(player, id)
	end)
	CollectionService:AddTag(pedestal, "HeistPedestal")
end

----------------------------------------------------------------------------
-- Runs
----------------------------------------------------------------------------

function EggHeistService:StartRun(player: Player, heistId: string)
	local def = World.Heists[heistId]
	local d = S.DataService:Get(player)
	if not def or not d then
		return
	end
	if runs[player] then
		S.AnnounceService:Notify(player, "You're already on a heist!", "warn")
		return
	end
	local cooldown = d.heistCooldowns[heistId] or 0
	if os.time() < cooldown then
		S.AnnounceService:Notify(player, ("The guards are on alert. Try again in %s."):format(Format.Duration(cooldown - os.time())), "warn")
		return
	end
	local squad = S.PetService:GetSquad(player)
	if not squad or #squad.order == 0 then
		S.AnnounceService:Notify(player, "Equip at least one pet before a heist!", "warn")
		return
	end
	if #d.incubators >= self:IncubatorSlots(player) then
		S.AnnounceService:Notify(player, "Your incubator is full! Hatch your eggs first.", "warn")
		return
	end
	if def.ticket then
		if d.heistTickets < 1 then
			S.AnnounceService:Notify(player, "You need a 🎟️ Heist Ticket! (free ticket every 4h, or grab some in the Shop)", "warn")
			Net.Event("OpenPanel"):FireClient(player, "Shop", "HeistTicket1")
			return
		end
		d.heistTickets -= 1
		S.DataService:Replicate(player, "heistTickets")
	end

	local center, _, pedestalPos = self:SitePositions(def)
	local run = {
		kind = "Heist",
		player = player,
		heistId = heistId,
		def = def,
		alive = {},
		bossDead = false,
		carrier = nil,
		startedAt = os.clock(),
		center = center,
	}
	local ring = {}
	for i = 1, 6 do
		local a = (i / 6) * math.pi * 2
		table.insert(ring, center + Vector3.new(math.cos(a) * 32, 0, math.sin(a) * 32))
	end
	for i, guardType in def.guards do
		local start = ring[(i - 1) % #ring + 1]
		local guard = S.ZombieService:Spawn(guardType, def.level, start, {
			encounter = run,
			visibleTo = player.UserId,
			leash = def.pursuitLeash,
		})
		guard.patrol = { points = ring, i = (i % #ring) + 1 }
	end
	run.boss = S.ZombieService:Spawn(def.boss, def.level + 2, pedestalPos + Vector3.new(0, 0, -10), {
		encounter = run,
		visibleTo = player.UserId,
		leash = 45,
	})
	run.onKilled = function(z)
		if z == run.boss then
			run.bossDead = true
			S.AnnounceService:Notify(player, "🥚 The egg is unguarded! Hold STEAL EGG, then RUN HOME!", "reward")
			self:SendState(player)
		end
	end
	runs[player] = run
	self:SendState(player)
	S.AnnounceService:Notify(player, ("🥷 Heist started: defeat the %s!"):format(run.boss.name), "warn")
end

function EggHeistService:StealEgg(player: Player, heistId: string)
	local run = runs[player]
	if not run or run.heistId ~= heistId then
		S.AnnounceService:Notify(player, "Start the heist at the entrance first!", "warn")
		return
	end
	if not run.bossDead then
		S.AnnounceService:Notify(player, ("Defeat the %s first!"):format(run.boss.name), "warn")
		return
	end
	if S.CarryService:IsCarrying(player) then
		return
	end
	local egg = Eggs.List[run.def.egg]
	local started = S.CarryService:StartCarry(player, {
		kind = "Egg",
		label = "🥚 STOLEN " .. egg.displayName:upper(),
		speedMult = 0.85,
		timeout = 300,
		visual = function(parent: Instance, cf: CFrame)
			return Props.Egg(parent, cf * CFrame.new(0, -1, 0), egg, 0.6)
		end,
		deliverCheck = function()
			local inc = incubators[player]
			local root = S.EntityService:RootOf(player)
			return inc ~= nil and root ~= nil and (root.Position - inc.pos).Magnitude < 18
		end,
		onDeliver = function()
			self:Incubate(player, run.def.egg)
			self:EndRun(player, true, "delivered")
		end,
		onDrop = function(reason: string)
			run.carrier = nil
			if reason ~= "left" then
				S.AnnounceService:Notify(player, "The egg flew back to the nest! Go get it again.", "warn")
			end
			self:SendState(player)
		end,
	})
	if started then
		run.carrier = player
		self:SendState(player)
	end
end

function EggHeistService:Step(_dt: number)
	local now = os.clock()
	for player, run in runs do
		local root = S.EntityService:RootOf(player)
		if now - run.startedAt > RUN_TIMEOUT then
			self:EndRun(player, false, "timeout")
		elseif root and not run.carrier and (root.Position - run.center).Magnitude > ABANDON_DIST then
			self:EndRun(player, false, "abandoned")
		end
	end
	for player, inc in incubators do
		self:UpdateIncubatorLabel(player, inc)
	end
end

function EggHeistService:EndRun(player: Player, won: boolean, reason: string)
	local run = runs[player]
	if not run then
		return
	end
	runs[player] = nil
	if S.CarryService:IsCarrying(player) and reason ~= "delivered" then
		S.CarryService:Drop(player, "left")
	end
	S.ZombieService:DespawnEncounter(run)
	local d = S.DataService:Get(player)
	if d then
		if run.def.cooldown > 0 then
			d.heistCooldowns[run.heistId] = os.time() + run.def.cooldown
		end
		if won then
			S.DataService:IncrementStat(player, "heistsWon")
			S.DataService:AddXP(player, run.def.level * 30)
			local egg = Eggs.List[run.def.egg]
			S.AnnounceService:Announce(("🥚 %s stole a %s and made it home!"):format(player.DisplayName, egg.displayName), "reward", run.heistId == "DragonNest")
		elseif reason == "timeout" then
			S.AnnounceService:Notify(player, "⏰ Heist failed: the guards reset.", "error")
		end
	end
	if player.Parent then
		Net.Event("HeistState"):FireClient(player, nil)
	end
end

function EggHeistService:SendState(player: Player)
	local run = runs[player]
	if not run then
		Net.Event("HeistState"):FireClient(player, nil)
		return
	end
	Net.Event("HeistState"):FireClient(player, {
		name = run.def.name,
		egg = run.def.egg,
		bossName = run.boss and run.boss.name,
		bossDead = run.bossDead,
		carrying = run.carrier ~= nil,
		timeLeft = RUN_TIMEOUT - (os.clock() - run.startedAt),
		home = if incubators[player] then incubators[player].pos else nil,
	})
end

----------------------------------------------------------------------------
-- Incubator (lives on your plot)
----------------------------------------------------------------------------

function EggHeistService:IncubatorSlots(player: Player): number
	return INCUBATOR_SLOTS + (if S.MonetizationService:IsVIP(player) then 1 else 0)
end

function EggHeistService:OnPlotAssigned(player: Player, plot)
	local pos = plot.cf:PointToWorldSpace(Base.IncubatorOffset)
	incubators[player] = { plot = plot, pos = pos }
	self:RebuildIncubator(player)
end

function EggHeistService:OnPlotReleased(plot)
	for player, inc in incubators do
		if inc.plot == plot then
			if inc.model then
				inc.model:Destroy()
			end
			incubators[player] = nil
		end
	end
end

function EggHeistService:RebuildIncubator(player: Player)
	local inc = incubators[player]
	local d = S.DataService:Get(player)
	if not inc or not d then
		return
	end
	if inc.model then
		inc.model:Destroy()
	end
	local m = StudStyle.Model(inc.plot.model, "Incubator")
	inc.model = m
	local base = StudStyle.OnGround(m, Vector3.new(12, 1.5, 7), inc.pos, Color3.fromRGB(140, 96, 60), { name = "Nest" })
	for i = 1, self:IncubatorSlots(player) do
		local slotPos = inc.pos + inc.plot.cf:VectorToWorldSpace(Vector3.new((i - 2.5) * 3, 1.5, 0))
		StudStyle.Block(m, Vector3.new(2.6, 0.5, 2.6), CFrame.new(slotPos + Vector3.new(0, 0.25, 0)), Color3.fromRGB(230, 200, 130), { shadow = false })
		local entry = d.incubators[i]
		if entry then
			Props.Egg(m, CFrame.new(slotPos + Vector3.new(0, 0.5, 0)), Eggs.List[entry.egg], 0.55)
		end
	end
	inc.label = StudStyle.Label(base, "🥚 Incubator (steal eggs in heists!)", Color3.fromRGB(255, 230, 150), 90, 1)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Hatch"
	prompt.ObjectText = "Incubator"
	prompt.HoldDuration = 0.5
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("OwnerUserId", player.UserId)
	CollectionService:AddTag(prompt, "OwnerOnlyPrompt")
	prompt.Parent = base
	prompt.Triggered:Connect(function(who)
		if who == player then
			self:HatchReady(player)
		end
	end)
	self:UpdateIncubatorLabel(player, inc)
end

function EggHeistService:UpdateIncubatorLabel(player: Player, inc)
	local d = S.DataService:Get(player)
	if not d or not inc.label then
		return
	end
	local text = inc.label:FindFirstChild("Text") :: TextLabel?
	if not text then
		return
	end
	if #d.incubators == 0 then
		text.Text = "🥚 Incubator (steal eggs in heists!)"
		return
	end
	local lines = {}
	for _, entry in d.incubators do
		local left = entry.readyAt - os.time()
		table.insert(lines, Eggs.List[entry.egg].displayName .. ": " .. (if left <= 0 then "READY!" else Format.Duration(left)))
	end
	text.Text = table.concat(lines, "\n")
end

function EggHeistService:Incubate(player: Player, eggId: string)
	local d = S.DataService:Get(player)
	local egg = Eggs.List[eggId]
	table.insert(d.incubators, { egg = eggId, readyAt = os.time() + egg.incubateSeconds })
	S.DataService:Replicate(player, "incubators")
	self:RebuildIncubator(player)
end

function EggHeistService:SkipIncubation(player: Player): boolean
	local d = S.DataService:Get(player)
	for _, entry in d.incubators do
		if entry.readyAt > os.time() then
			entry.readyAt = os.time()
			S.DataService:Replicate(player, "incubators")
			self:RebuildIncubator(player)
			return true
		end
	end
	return false
end

function EggHeistService:HatchReady(player: Player)
	local d = S.DataService:Get(player)
	if not d then
		return
	end
	local results = {}
	local remaining = {}
	local hatchedEgg = nil
	local now = os.time()
	for _, entry in d.incubators do
		if entry.readyAt <= now then
			hatchedEgg = hatchedEgg or entry.egg
			local species, variant = S.PetService:RollEgg(player, entry.egg)
			local uid = S.PetService:GrantPet(player, species, variant, { ignoreCap = true })
			table.insert(results, { uid = uid, species = species, variant = variant })
		else
			table.insert(remaining, entry)
		end
	end
	if #results == 0 then
		S.AnnounceService:Notify(player, "Nothing is ready to hatch yet.", "info")
		return
	end
	d.incubators = remaining
	S.DataService:Replicate(player, "incubators")
	S.DataService:IncrementStat(player, "eggsHatched", #results)
	self:RebuildIncubator(player)
	Net.Event("HatchResult"):FireClient(player, { ok = true, results = results, egg = hatchedEgg })
end

return EggHeistService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">EntityService</string>
            <string name="Source"><![CDATA[--[[
	EntityService: registry + replication for every simulated creature
	(pets, zombies, bosses, heist guardians).

	Entities are plain Lua tables on the server. Nothing physical exists in
	the server's Workspace for them; clients build and animate the blocks.
	That is what lets a phone render 60 zombies and 30 pets at once.

	Replication (10 Hz):
	  * EntitySpawned / EntityRemoved / EntityAppearance: reliable, rare
	  * EntitySnapshot: unreliable binary, per player, interest-managed
	    (your own pets always, everything else within INTEREST studs)
	  * CombatEvents: reliable batches of hit/ability/death FX, sent only
	    to players close enough to see them
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Protocol = require(Shared.Util.EntityProtocol)

local INTEREST = 340
local EVENT_RADIUS = 260

local EntityService = { Name = "EntityService" }

local entities: { [number]: any } = {}
local byKind: { [string]: { [number]: any } } = { Pet = {}, Zombie = {} }
local nextId = 1
local eventQueue = {}

local snapshotRemote: UnreliableRemoteEvent
local spawnRemote: RemoteEvent
local removeRemote: RemoteEvent
local appearanceRemote: RemoteEvent
local combatRemote: RemoteEvent

local function allocateId(): number
	for _ = 1, 65535 do
		local id = nextId
		nextId = if nextId >= 65535 then 1 else nextId + 1
		if not entities[id] then
			return id
		end
	end
	error("entity id space exhausted")
end

local function canSee(player: Player, e): boolean
	return e.visibleTo == nil or e.visibleTo == player.UserId
end

function EntityService:Start()
	snapshotRemote = Net.Unreliable("EntitySnapshot")
	spawnRemote = Net.Event("EntitySpawned")
	removeRemote = Net.Event("EntityRemoved")
	appearanceRemote = Net.Event("EntityAppearance")
	combatRemote = Net.Event("CombatEvents")

	Players.PlayerAdded:Connect(function(player)
		self:SendAll(player)
	end)
	for _, player in Players:GetPlayers() do
		self:SendAll(player)
	end
end

function EntityService:Describe(e)
	return {
		id = e.id,
		kind = e.kind,
		ownerId = e.ownerId,
		uid = e.uid,
		name = e.name,
		appearance = e.appearance,
		maxHp = e.maxHp,
		boss = e.boss,
		level = e.level,
		rarity = e.rarity,
		x = e.pos.X,
		y = e.pos.Y,
		z = e.pos.Z,
	}
end

function EntityService:SendAll(player: Player)
	local list = {}
	for _, e in entities do
		if canSee(player, e) then
			table.insert(list, self:Describe(e))
		end
	end
	if #list > 0 then
		spawnRemote:FireClient(player, list)
	end
end

-- Registers an entity table. Required fields: pos (Vector3), maxHp,
-- appearance. Optional: ownerId, visibleTo (userId), radius, name, boss.
function EntityService:Create(kind: string, e)
	e.id = allocateId()
	e.kind = kind
	e.state = e.state or Protocol.State.Idle
	e.yaw = e.yaw or 0
	e.effects = e.effects or {}
	e.hp = e.hp or e.maxHp
	e.radius = e.radius or 1.5
	entities[e.id] = e
	byKind[kind] = byKind[kind] or {}
	byKind[kind][e.id] = e

	local desc = { self:Describe(e) }
	if e.visibleTo then
		local player = Players:GetPlayerByUserId(e.visibleTo)
		if player then
			spawnRemote:FireClient(player, desc)
		end
	else
		spawnRemote:FireAllClients(desc)
	end
	return e
end

function EntityService:Remove(e, fx: string?)
	if not entities[e.id] or entities[e.id] ~= e then
		return
	end
	entities[e.id] = nil
	byKind[e.kind][e.id] = nil
	e.removed = true
	if e.visibleTo then
		local player = Players:GetPlayerByUserId(e.visibleTo)
		if player then
			removeRemote:FireClient(player, e.id, fx)
		end
	else
		removeRemote:FireAllClients(e.id, fx)
	end
end

function EntityService:SetAppearance(e, appearance, maxHp: number?)
	e.appearance = appearance
	if maxHp then
		e.maxHp = maxHp
	end
	if e.visibleTo then
		local player = Players:GetPlayerByUserId(e.visibleTo)
		if player then
			appearanceRemote:FireClient(player, e.id, appearance, e.maxHp)
		end
	else
		appearanceRemote:FireAllClients(e.id, appearance, e.maxHp)
	end
end

function EntityService:Get(id: number?)
	return if id then entities[id] else nil
end

function EntityService:OfKind(kind: string)
	return byKind[kind] or {}
end

-- Queue an FX/combat event for players near `pos`.
function EntityService:Event(pos: Vector3, ev: { any }, visibleTo: number?)
	table.insert(eventQueue, { pos = pos, ev = ev, visibleTo = visibleTo })
end

function EntityService:RootOf(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return root :: BasePart?
end

function EntityService:Replicate(_dt: number)
	local players = Players:GetPlayers()
	local interest2 = INTEREST * INTEREST
	local event2 = EVENT_RADIUS * EVENT_RADIUS

	for _, player in players do
		local root = self:RootOf(player)
		local center = if root then root.Position else nil
		local entries = {}
		for _, e in entities do
			if canSee(player, e) then
				local include = e.ownerId == player.UserId
				if not include and center then
					local d = e.pos - center
					include = d.X * d.X + d.Z * d.Z < interest2
				end
				if include then
					table.insert(entries, {
						id = e.id,
						x = e.pos.X,
						y = e.pos.Y,
						z = e.pos.Z,
						yaw = e.yaw,
						state = e.state,
						hp = if e.maxHp > 0 then math.clamp(e.hp / e.maxHp, 0, 1) else 0,
					})
				end
			end
		end
		local per = Protocol.MaxPerPacket
		for from = 1, #entries, per do
			snapshotRemote:FireClient(player, Protocol.Pack(entries, from, math.min(#entries, from + per - 1)))
		end

		if #eventQueue > 0 and center then
			local batch = {}
			for _, item in eventQueue do
				if item.visibleTo == nil or item.visibleTo == player.UserId then
					local d = item.pos - center
					if d.X * d.X + d.Z * d.Z < event2 then
						table.insert(batch, item.ev)
					end
				end
			end
			if #batch > 0 then
				combatRemote:FireClient(player, batch)
			end
		end
	end
	table.clear(eventQueue)
end

return EntityService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">FruitService</string>
            <string name="Source"><![CDATA[--[[
	FruitService: Beast Fruits in the world, the Fruit Dealer, fruit
	storage, and feeding a fruit to a pet (the core mutation moment).

	World spawns: every few minutes a fruit appears at one of the tagged
	"FruitSpawn" anchors WorldBuilder placed (some hidden on parkour tops
	and in secret spots). Everyone gets a vague "a fruit spawned!" banner;
	Fruit Notifier owners get the exact fruit, location and a beam.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Fruits = require(Shared.Config.Fruits)
local Rarity = require(Shared.Config.Rarity)
local Pets = require(Shared.Config.Pets)
local World = require(Shared.Config.World)
local Props = require(Shared.Art.Props)
local StudStyle = require(Shared.Art.StudStyle)
local Rng = require(Shared.Util.Rng)
local Format = require(Shared.Util.Format)

local FruitService = { Name = "FruitService" }

local S
local worldFruits: { [string]: any } = {}
local nextSpawn = 0
local folder: Folder
local counter = 0

function FruitService:Init(services)
	S = services
end

function FruitService:Start()
	folder = Instance.new("Folder")
	folder.Name = "WorldFruits"
	folder.Parent = workspace
	nextSpawn = os.clock() + 45 -- first fruit soon after server start

	Net.Function("FeedFruit").OnServerInvoke = function(player, petUid, fruitId)
		if type(petUid) ~= "string" or type(fruitId) ~= "string" then
			return false
		end
		return self:Feed(player, petUid, fruitId)
	end
	Net.Function("RollFruit").OnServerInvoke = function(player, mode)
		if mode == "coins" then
			return self:DealerRoll(player)
		elseif mode == "robux" then
			S.MonetizationService:RequestPurchase(player, "product", "FruitRoll")
			return { ok = true, prompted = true }
		end
		return { ok = false }
	end

	S.DataService.PlayerLoaded:Connect(function(player)
		-- Late joiners with the notifier see fruits already out there.
		if S.MonetizationService:HasPass(player, "FruitNotifier") then
			for id, wf in worldFruits do
				Net.Event("FruitSpawned"):FireClient(player, id, wf.fruitId, wf.position, wf.hidden)
			end
		end
	end)
end

function FruitService:Storage(player: Player): number
	return Fruits.BaseStorage + (if S.MonetizationService:HasPass(player, "FruitStorage") then 10 else 0)
end

function FruitService:CountFruits(player: Player): number
	local d = S.DataService:Get(player)
	local n = 0
	for _, c in d.fruits do
		n += c
	end
	return n
end

function FruitService:PickFruit(weightKey: string): string
	local entries = {}
	for _, id in Fruits.Order do
		table.insert(entries, { id = id, w = Fruits.List[id][weightKey] })
	end
	return Rng.Pick(entries, function(e)
		return e.w
	end).id
end

-- Returns true if the fruit went into storage.
function FruitService:Grant(player: Player, fruitId: string, source: string, force: boolean?): boolean
	local d = S.DataService:Get(player)
	if not d then
		return false
	end
	if not force and self:CountFruits(player) >= self:Storage(player) then
		S.AnnounceService:Notify(player, "🧺 Fruit storage full! Feed a fruit to a pet first.", "warn")
		return false
	end
	d.fruits[fruitId] = (d.fruits[fruitId] or 0) + 1
	S.DataService:Replicate(player, "fruits")
	S.DataService:IncrementStat(player, "fruitsCollected")
	local fruit = Fruits.List[fruitId]
	S.AnnounceService:Notify(player, ("%s You got a %s!"):format(fruit.emoji, fruit.displayName), "reward")
	if Rarity.Rank(fruit.rarity) >= 5 then
		S.AnnounceService:Announce(("%s found a %s %s! (%s)"):format(player.DisplayName, fruit.emoji, fruit.displayName, source), "reward", fruit.rarity == "Mythical")
	end
	return true
end

function FruitService:GrantRandom(player: Player, source: string)
	return self:Grant(player, self:PickFruit("spawnWeight"), source, true)
end

-- Robux roll (called by MonetizationService after a receipt).
function FruitService:Roll(player: Player, mode: string)
	local fruitId = self:PickFruit(if mode == "robux" then "robuxWeight" else "spawnWeight")
	self:Grant(player, fruitId, "roll", true)
	Net.Event("MutationCinematic"):FireClient(player, { kind = "FruitRoll", id = fruitId })
	return fruitId
end

-- Coin roll at the Fruit Dealer: free currency, hourly cooldown.
function FruitService:DealerRoll(player: Player)
	local d = S.DataService:Get(player)
	if not d then
		return { ok = false }
	end
	local root = S.EntityService:RootOf(player)
	if not root or (root.Position - World.FruitDealer).Magnitude > 30 then
		return { ok = false, err = "Visit the Fruit Dealer in the hub." }
	end
	local wait = d.lastFruitDealer + Fruits.DealerCooldown - os.time()
	if wait > 0 then
		return { ok = false, err = ("Dealer restocks in %s"):format(Format.Duration(wait)) }
	end
	if self:CountFruits(player) >= self:Storage(player) then
		return { ok = false, err = "Fruit storage full!" }
	end
	if not S.DataService:Spend(player, "coins", Fruits.DealerCost) then
		return { ok = false, err = ("Need 💰%s"):format(Format.Short(Fruits.DealerCost)) }
	end
	d.lastFruitDealer = os.time()
	S.DataService:Replicate(player, "lastFruitDealer")
	local fruitId = self:PickFruit("spawnWeight")
	self:Grant(player, fruitId, "dealer", true)
	return { ok = true, fruit = fruitId }
end

----------------------------------------------------------------------------
-- Feeding: the mutation moment
----------------------------------------------------------------------------

function FruitService:Feed(player: Player, petUid: string, fruitId: string): boolean
	local d = S.DataService:Get(player)
	local pet = d and d.pets[petUid]
	local fruit = Fruits.List[fruitId]
	if not pet or not fruit or (d.fruits[fruitId] or 0) < 1 then
		return false
	end
	d.fruits[fruitId] -= 1
	if d.fruits[fruitId] <= 0 then
		d.fruits[fruitId] = nil
	end
	pet.fruit = { id = fruitId, mastery = 0 }
	S.DataService:Replicate(player, "fruits")
	S.DataService:IncrementStat(player, "fruitsEaten")
	S.PetService:RefreshPet(player, petUid)
	Net.Event("MutationCinematic"):FireClient(player, { kind = "Fruit", uid = petUid, id = fruitId })
	if Rarity.Rank(fruit.rarity) >= 5 then
		S.AnnounceService:Announce(("%s's %s ate a %s %s and MUTATED!"):format(player.DisplayName, Pets.Species[pet.species].displayName, fruit.emoji, fruit.displayName), "reward")
	end
	return true
end

----------------------------------------------------------------------------
-- World spawns
----------------------------------------------------------------------------

function FruitService:Step(_dt: number)
	local now = os.clock()
	for id, wf in worldFruits do
		if now - wf.spawnedAt > Fruits.Despawn then
			self:RemoveWorldFruit(id)
		end
	end
	local count = 0
	for _ in worldFruits do
		count += 1
	end
	if now >= nextSpawn then
		nextSpawn = now + Fruits.SpawnInterval
		if count < Fruits.MaxWorldFruits then
			self:SpawnWorldFruit()
		end
	end
end

function FruitService:SpawnWorldFruit()
	local anchors = CollectionService:GetTagged("FruitSpawn")
	local free = {}
	for _, a in anchors do
		if a:IsA("BasePart") and not a:GetAttribute("Occupied") then
			table.insert(free, a)
		end
	end
	if #free == 0 then
		return
	end
	local anchor = free[math.random(1, #free)] :: BasePart
	local fruitId = self:PickFruit("spawnWeight")
	local fruit = Fruits.List[fruitId]
	counter += 1
	local id = "wf" .. counter
	local pos = anchor.Position + Vector3.new(0, 2, 0)
	local hidden = anchor:GetAttribute("Hidden") == true

	local model = Props.Fruit(folder, CFrame.new(pos), fruit, 1.2)
	local primary = model.PrimaryPart :: BasePart
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Color = ColorSequence.new(fruit.color)
	sparkle.LightEmission = 0.6
	sparkle.Rate = 6
	sparkle.Lifetime = NumberRange.new(0.8, 1.4)
	sparkle.Speed = NumberRange.new(1, 3)
	sparkle.Size = NumberSequence.new(0.4, 0)
	sparkle.Parent = primary
	if not hidden then
		StudStyle.Label(primary, fruit.emoji .. " " .. fruit.displayName, fruit.color, 70, 0.8)
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Pick up"
	prompt.ObjectText = fruit.displayName
	prompt.HoldDuration = 0.4
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = primary
	prompt.Triggered:Connect(function(player)
		if worldFruits[id] and self:Grant(player, fruitId, "wild") then
			self:RemoveWorldFruit(id)
		end
	end)

	anchor:SetAttribute("Occupied", true)
	worldFruits[id] = { fruitId = fruitId, model = model, anchor = anchor, spawnedAt = os.clock(), position = pos, hidden = hidden }

	local zone = World.ZoneAt(pos.Z)
	for _, player in Players:GetPlayers() do
		if S.MonetizationService:HasPass(player, "FruitNotifier") then
			Net.Event("FruitSpawned"):FireClient(player, id, fruitId, pos, hidden)
		else
			S.AnnounceService:Notify(player, ("🍉 A Beast Fruit spawned somewhere in %s!"):format(zone.name), "info")
		end
	end
end

function FruitService:RemoveWorldFruit(id: string)
	local wf = worldFruits[id]
	if not wf then
		return
	end
	worldFruits[id] = nil
	wf.anchor:SetAttribute("Occupied", nil)
	wf.model:Destroy()
	Net.Event("FruitDespawned"):FireAllClients(id)
end

return FruitService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[--[[
	MonetizationService: game passes, developer products, VIP subscription,
	server-wide boosts, and paid random item compliance.

	Compliance: anything flagged `randomItem` in Config/Monetization is
	hidden from, and refused for, players whose PolicyService info says
	ArePaidRandomItemsRestricted. Odds for those items are sent to the client
	with the shop info so they are visible before purchase.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local PolicyService = game:GetService("PolicyService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Monetization = require(Shared.Config.Monetization)
local Fruits = require(Shared.Config.Fruits)
local Eggs = require(Shared.Config.Eggs)

local MonetizationService = { Name = "MonetizationService" }

local S
local owned: { [Player]: { [string]: boolean } } = {}
local vip: { [Player]: boolean } = {}
local randomRestricted: { [Player]: boolean } = {}
local serverLuckUntil = 0

local IS_STUDIO = RunService:IsStudio()

local function productByKey(key: string)
	return Monetization.Products[key]
end

local function findProductById(id: number)
	for key, p in Monetization.Products do
		if p.id == id and id ~= 0 then
			return key, p
		end
	end
	return nil, nil
end

local function findPassById(id: number)
	for key, p in Monetization.GamePasses do
		if p.id == id and id ~= 0 then
			return key, p
		end
	end
	return nil, nil
end

function MonetizationService:Init(services)
	S = services
end

function MonetizationService:Start()
	MarketplaceService.ProcessReceipt = function(info)
		return self:ProcessReceipt(info)
	end

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local key = findPassById(passId)
		if key then
			self:GrantPass(player, key)
		end
	end)

	Players.UserSubscriptionStatusChanged:Connect(function(player, subscriptionId)
		if subscriptionId == Monetization.Subscription.id then
			self:RefreshVip(player)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		owned[player] = nil
		vip[player] = nil
		randomRestricted[player] = nil
	end)

	Net.Event("Purchase").OnServerEvent:Connect(function(player, kind, key)
		if type(kind) ~= "string" or type(key) ~= "string" then
			return
		end
		self:RequestPurchase(player, kind, key)
	end)

	Net.Function("GetShopInfo").OnServerInvoke = function(player)
		return self:ShopInfo(player)
	end
end

function MonetizationService:LoadPlayer(player: Player)
	owned[player] = owned[player] or {}
	-- Policy first: it decides what the shop is allowed to show.
	local ok, policy = pcall(PolicyService.GetPolicyInfoForPlayerAsync, PolicyService, player)
	if ok and policy then
		randomRestricted[player] = policy.ArePaidRandomItemsRestricted == true
	else
		-- Fail closed in live servers; allow testing in Studio.
		randomRestricted[player] = not IS_STUDIO
	end

	for key, pass in Monetization.GamePasses do
		if pass.id ~= 0 then
			local okOwn, has = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.id)
			if okOwn and has then
				owned[player][key] = true
			end
		end
	end
	for key in owned[player] do
		player:SetAttribute("Pass_" .. key, true)
	end
	player:SetAttribute("RandomRestricted", randomRestricted[player])
	self:RefreshVip(player)
end

function MonetizationService:RefreshVip(player: Player)
	local isVip = owned[player] ~= nil and owned[player].VIP == true
	local subId = Monetization.Subscription.id
	if subId ~= "" then
		local ok, status = pcall(MarketplaceService.GetUserSubscriptionStatusAsync, MarketplaceService, player, subId)
		if ok and status and status.IsSubscribed then
			isVip = true
		end
	end
	local was = vip[player]
	vip[player] = isVip
	player:SetAttribute("VIP", isVip)
	if was ~= nil and was ~= isVip then
		S.PetService:RefreshEquipSlots(player)
	end
end

----------------------------------------------------------------------------
-- Queries used by other services
----------------------------------------------------------------------------

function MonetizationService:HasPass(player: Player, key: string): boolean
	local pass = Monetization.GamePasses[key]
	if pass and pass.randomItem and randomRestricted[player] then
		return false
	end
	local o = owned[player]
	return o ~= nil and o[key] == true
end

function MonetizationService:IsVIP(player: Player): boolean
	return vip[player] == true
end

function MonetizationService:CanBuyRandomItems(player: Player): boolean
	return randomRestricted[player] == false
end

function MonetizationService:CoinMult(player: Player): number
	return if self:IsVIP(player) then Monetization.VipCoinMult else 1
end

function MonetizationService:ServerLuckActive(): boolean
	return os.time() < serverLuckUntil
end

-- Luck used for eggs. Paid luck is ignored for restricted players.
function MonetizationService:Luck(player: Player): number
	if randomRestricted[player] then
		return 1
	end
	local luck = 1
	if self:HasPass(player, "LuckyHatch") then
		luck *= Monetization.GamePasses.LuckyHatch.luck
	end
	if self:ServerLuckActive() then
		luck *= 2
	end
	return luck
end

----------------------------------------------------------------------------
-- Purchasing
----------------------------------------------------------------------------

function MonetizationService:RequestPurchase(player: Player, kind: string, key: string)
	if kind == "pass" then
		local pass = Monetization.GamePasses[key]
		if not pass then
			return
		end
		if pass.randomItem and not self:CanBuyRandomItems(player) then
			S.AnnounceService:Notify(player, "This item isn't available in your region.", "warn")
			return
		end
		if self:HasPass(player, key) then
			S.AnnounceService:Notify(player, "You already own " .. pass.name .. "!", "info")
			return
		end
		if pass.id == 0 then
			if IS_STUDIO then
				self:GrantPass(player, key)
				S.AnnounceService:Notify(player, "[Studio] Granted " .. pass.name .. " for testing.", "good")
			else
				S.AnnounceService:Notify(player, "Coming soon!", "info")
			end
			return
		end
		MarketplaceService:PromptGamePassPurchase(player, pass.id)
	elseif kind == "product" then
		local product = productByKey(key)
		if not product then
			return
		end
		if product.randomItem and not self:CanBuyRandomItems(player) then
			S.AnnounceService:Notify(player, "This item isn't available in your region.", "warn")
			return
		end
		if product.id == 0 then
			if IS_STUDIO then
				self:GrantProduct(player, key, product)
				S.AnnounceService:Notify(player, "[Studio] Granted " .. product.name .. " for testing.", "good")
			else
				S.AnnounceService:Notify(player, "Coming soon!", "info")
			end
			return
		end
		MarketplaceService:PromptProductPurchase(player, product.id)
	elseif kind == "subscription" then
		local subId = Monetization.Subscription.id
		if subId == "" then
			-- Subscription not configured yet: sell the lifetime VIP pass.
			self:RequestPurchase(player, "pass", "VIP")
			return
		end
		MarketplaceService:PromptSubscriptionPurchase(player, subId)
	end
end

function MonetizationService:GrantPass(player: Player, key: string)
	owned[player] = owned[player] or {}
	owned[player][key] = true
	if key == "VIP" then
		self:RefreshVip(player)
	end
	if key == "ExtraEquip" or key == "VIP" then
		S.PetService:RefreshEquipSlots(player)
	end
	if key == "MountBoost" then
		S.MountService:RefreshSpeed(player)
	end
	player:SetAttribute("Pass_" .. key, true)
	S.AnnounceService:Notify(player, "Unlocked " .. Monetization.GamePasses[key].name .. "!", "reward")
end

function MonetizationService:ProcessReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = S.DataService:Get(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local receiptId = tostring(info.PurchaseId)
	if data.purchases[receiptId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local key, product = findProductById(info.ProductId)
	if not key or not product then
		warn("[Monetization] unknown product", info.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, err = pcall(self.GrantProduct, self, player, key, product)
	if not ok then
		warn("[Monetization] grant failed:", err)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- Idempotency record (keep the last 100 receipts).
	data.purchases[receiptId] = true
	table.insert(data.purchaseOrder, receiptId)
	while #data.purchaseOrder > 100 do
		data.purchases[table.remove(data.purchaseOrder, 1)] = nil
	end
	task.spawn(S.DataService.Save, S.DataService, player, false)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService:GrantProduct(player: Player, key: string, product)
	local grant = product.grant
	local data = S.DataService:Get(player)
	if grant.heistTickets then
		data.heistTickets += grant.heistTickets
		S.DataService:Replicate(player, "heistTickets")
	end
	if grant.gems then
		S.DataService:Add(player, "gems", grant.gems, true)
	end
	if grant.fruitRoll then
		S.FruitService:Roll(player, "robux")
	end
	if grant.serverLuck then
		serverLuckUntil = math.max(serverLuckUntil, os.time()) + grant.serverLuck
		workspace:SetAttribute("ServerLuckUntil", serverLuckUntil)
		S.AnnounceService:Announce(("🌟 %s activated SERVER LUCK x2 for everyone!"):format(player.DisplayName), "reward")
	end
	if grant.nuke then
		S.ZombieService:Nuke(player)
		S.AnnounceService:Announce(("☢️ %s NUKED THE HORDE!"):format(player.DisplayName), "warn", true)
	end
	S.AnnounceService:Notify(player, "Thanks! " .. product.name .. " delivered.", "reward")
end

-- Everything the shop UI needs, including odds for random items.
function MonetizationService:ShopInfo(player: Player)
	local canRandom = self:CanBuyRandomItems(player)
	local passes = {}
	for _, key in Monetization.PassOrder do
		local p = Monetization.GamePasses[key]
		if (p.id ~= 0 or IS_STUDIO) and (canRandom or not p.randomItem) then
			table.insert(passes, {
				key = key,
				name = p.name,
				icon = p.icon,
				desc = p.desc,
				price = p.price,
				owned = self:HasPass(player, key),
				randomItem = p.randomItem,
			})
		end
	end
	local products = {}
	for _, key in Monetization.ProductOrder do
		local p = Monetization.Products[key]
		if (p.id ~= 0 or IS_STUDIO) and (canRandom or not p.randomItem) then
			local odds = nil
			if p.oddsFrom == "FruitRobux" then
				odds = {}
				local total = 0
				for _, id in Fruits.Order do
					total += Fruits.List[id].robuxWeight
				end
				for _, id in Fruits.Order do
					table.insert(odds, { name = Fruits.List[id].displayName, chance = Fruits.List[id].robuxWeight / total * 100 })
				end
			elseif p.oddsFrom and Eggs.List[p.oddsFrom] then
				odds = {}
				for _, entry in Eggs.List[p.oddsFrom].odds do
					table.insert(odds, { name = entry.pet, chance = entry.chance })
				end
			end
			table.insert(products, {
				key = key,
				name = p.name,
				icon = p.icon,
				price = p.price,
				randomItem = p.randomItem,
				odds = odds,
			})
		end
	end
	return {
		passes = passes,
		products = products,
		vip = self:IsVIP(player),
		subscription = {
			name = Monetization.Subscription.name,
			priceUsd = Monetization.Subscription.priceUsd,
			perks = Monetization.Subscription.perks,
			configured = Monetization.Subscription.id ~= "",
		},
		canBuyRandom = canRandom,
		serverLuckUntil = serverLuckUntil,
		studio = IS_STUDIO,
	}
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">MountService</string>
            <string name="Source"><![CDATA[--[[
	MountService: ride your Alpha pet.

	The mount is a normal pet entity flagged `mounted`. PetAIService glues it
	under the player every tick; clients draw it under the character and
	play the sit pose. The player's Humanoid does the moving, so riding
	uses Roblox's own responsive character controller (great on mobile).

	Mounted combat: MountAttack(aimDirection) swings a cone in front of the
	mount using the pet's power and fruit on-hit effects.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Pets = require(Shared.Config.Pets)
local Fruits = require(Shared.Config.Fruits)
local BlockyBuilder = require(Shared.Art.BlockyBuilder)
local Protocol = require(Shared.Util.EntityProtocol)

local BASE_WALK = 18
local CARRY_ON_FOOT = 0.8

local MountService = { Name = "MountService" }

local S
local mounts: { [Player]: any } = {}
local heightCache: { [string]: number } = {}

function MountService:Init(services)
	S = services
end

function MountService:Start()
	Net.Event("ToggleMount").OnServerEvent:Connect(function(player)
		if mounts[player] then
			self:Dismount(player)
		else
			self:Mount(player)
		end
	end)
	Net.Event("MountAttack").OnServerEvent:Connect(function(player, aim)
		if typeof(aim) == "Vector3" then
			self:Attack(player, aim)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		mounts[player] = nil
	end)
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			mounts[player] = nil
			Net.Event("MountState"):FireAllClients(player.UserId, nil)
			task.defer(self.RefreshSpeed, self, player)
		end)
	end)
end

function MountService:IsMounted(player: Player): boolean
	return mounts[player] ~= nil
end

-- Height of the pet's back, so the rider sits on top of it.
function MountService:RigHeight(entity): number
	local a = entity.appearance
	local key = ("%s:%s:%.2f"):format(a.species, tostring(a.fruit), a.scale or 1)
	local cached = heightCache[key]
	if cached then
		return cached
	end
	local body = Pets.Species[a.species].body
	local rig = BlockyBuilder.Build(body, { scale = a.scale, fruit = a.fruit })
	local back = rig.height * 0.72
	heightCache[key] = back
	return back
end

function MountService:Mount(player: Player)
	local d = S.DataService:Get(player)
	local squad = S.PetService:GetSquad(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not d or not squad or not humanoid or humanoid.Health <= 0 then
		return
	end
	local alpha = d.alpha and squad.pets[d.alpha]
	if not alpha then
		S.AnnounceService:Notify(player, "Equip a pet and set it as Alpha to ride it!", "warn")
		return
	end
	if alpha.fainted then
		S.AnnounceService:Notify(player, "Your Alpha is recovering!", "warn")
		return
	end
	local height = self:RigHeight(alpha)
	mounts[player] = { pet = alpha, baseHip = humanoid.HipHeight, height = height, nextAttack = 0 }
	alpha.mounted = true
	alpha.target = nil
	humanoid.HipHeight = mounts[player].baseHip + height
	self:RefreshSpeed(player)
	Net.Event("MountState"):FireAllClients(player.UserId, { entityId = alpha.id, height = height })
end

function MountService:Dismount(player: Player)
	local m = mounts[player]
	if not m then
		return
	end
	mounts[player] = nil
	m.pet.mounted = false
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.HipHeight = m.baseHip
	end
	self:RefreshSpeed(player)
	Net.Event("MountState"):FireAllClients(player.UserId, nil)
end

-- One place decides WalkSpeed: mount, pass, carrying loot.
function MountService:RefreshSpeed(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local m = mounts[player]
	local carry = S.CarryService:Get(player)
	local speed = BASE_WALK
	local jump = 50
	if m then
		speed = 28 + m.pet.stats.speed * 0.6
		if S.MonetizationService:HasPass(player, "MountBoost") then
			speed *= 1.3
		end
		jump = 65
		if carry then
			speed *= math.max(carry.opts.speedMult or 1, 0.9)
		end
	elseif carry then
		speed *= carry.opts.speedMult or CARRY_ON_FOOT
	end
	humanoid.WalkSpeed = speed
	humanoid.UseJumpPower = true
	humanoid.JumpPower = jump
end

function MountService:Attack(player: Player, aim: Vector3)
	local m = mounts[player]
	local root = S.EntityService:RootOf(player)
	if not m or not root then
		return
	end
	local now = os.clock()
	local pet = m.pet
	if now < m.nextAttack or pet.fainted then
		return
	end
	m.nextAttack = now + 1 / math.max(pet.stats.attackRate, 0.5)
	local dir = Vector3.new(aim.X, 0, aim.Z)
	if dir.Magnitude < 1e-3 then
		dir = root.CFrame.LookVector
	end
	local fruit = pet.fruitId and Fruits.List[pet.fruitId]
	local fx = if fruit then fruit.element else "Slash"
	local origin = Vector3.new(root.Position.X, pet.pos.Y, root.Position.Z)
	local range = pet.stats.range + 9
	for _, z in S.ZombieService:Query(origin, range, player.UserId) do
		local to = Vector3.new(z.pos.X - origin.X, 0, z.pos.Z - origin.Z)
		if to.Magnitude < 3 or to.Unit:Dot(dir.Unit) > 0.5 then
			S.CombatService:PetBasicHit(pet, z, pet.stats.power * 1.3, fx)
		end
	end
	S.EntityService:Event(origin, { Protocol.Event.Ability, pet.id, "Mount_" .. fx, origin.X, origin.Z, range, dir.Unit.X, dir.Unit.Z })
end

return MountService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">MutationService</string>
            <string name="Source"><![CDATA[--[[
	MutationService: Mutation Capsules and the Brainrot economy.

	  * Vault: each base shows its capsules on pedestals. Visitors can hold
	    "Steal" on a pedestal when the base is unlocked; they then have to
	    carry the capsule home while the owner's pets hunt them (CarryService).
	  * Brainrot Belt: a conveyor in the hub carrying random capsules with
	    price tags. First player to buy one gets it.
	  * Mutation Lab: apply a capsule to a pet for Mutagen (UI -> ApplyMutation).
]]

local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Mutations = require(Shared.Config.Mutations)
local Rarity = require(Shared.Config.Rarity)
local World = require(Shared.Config.World)
local Pets = require(Shared.Config.Pets)
local StudStyle = require(Shared.Art.StudStyle)
local Props = require(Shared.Art.Props)
local PetStats = require(Shared.Util.PetStats)
local Rng = require(Shared.Util.Rng)
local Format = require(Shared.Util.Format)

local BELT_SPAWN_EVERY = 6
local BELT_TRAVEL = 32
local BELT_MAX = 7
local STEAL_PROTECTION_SECONDS = 20 * 60 -- new players can't be robbed

local MutationService = { Name = "MutationService" }

local S
local vaults: { [Player]: any } = {}
local beltItems = {}
local nextBeltSpawn = 0
local beltFolder: Folder

function MutationService:Init(services)
	S = services
end

function MutationService:Start()
	beltFolder = Instance.new("Folder")
	beltFolder.Name = "BrainrotBelt"
	beltFolder.Parent = workspace

	Net.Event("ApplyMutation").OnServerEvent:Connect(function(player, capsuleId, petUid)
		if type(capsuleId) == "string" and type(petUid) == "string" then
			self:Apply(player, capsuleId, petUid)
		end
	end)
end

----------------------------------------------------------------------------
-- Rolling & granting
----------------------------------------------------------------------------

-- bias 0..2: higher biases favour rarer mutations.
function MutationService:RollMutation(bias: number): string
	local entries = {}
	for _, id in Mutations.Order do
		local m = Mutations.List[id]
		local rank = Rarity.Rank(m.rarity)
		table.insert(entries, { id = id, w = m.weight * (1 + bias * (rank - 1) * 0.5) })
	end
	return Rng.Pick(entries, function(e)
		return e.w
	end).id
end

function MutationService:VaultSize(player: Player): number
	local d = S.DataService:Get(player)
	return Mutations.VaultSize + (if S.MonetizationService:IsVIP(player) then Mutations.VipVaultBonus else 0) + (d and d.extraVault or 0)
end

function MutationService:AddCapsule(player: Player, mutationId: string, source: string): boolean
	local d = S.DataService:Get(player)
	if not d or not Mutations.List[mutationId] then
		return false
	end
	if #d.capsules >= self:VaultSize(player) then
		if source ~= "stolen" then
			S.AnnounceService:Notify(player, "Capsule vault full! Apply or sell capsules in the Mutation Lab.", "warn")
			return false
		end
	end
	table.insert(d.capsules, { id = S.DataService:NewUid(), mutation = mutationId })
	S.DataService:Replicate(player, "capsules")
	self:RefreshVault(player)
	local m = Mutations.List[mutationId]
	S.AnnounceService:Notify(player, ("%s New capsule: %s (%s)"):format(m.emoji, m.displayName, m.rarity), "reward")
	return true
end

----------------------------------------------------------------------------
-- Applying (Mutation Lab)
----------------------------------------------------------------------------

function MutationService:Apply(player: Player, capsuleId: string, petUid: string)
	local d = S.DataService:Get(player)
	local pet = d and d.pets[petUid]
	if not pet then
		return
	end
	local index = nil
	for i, c in d.capsules do
		if c.id == capsuleId then
			index = i
			break
		end
	end
	if not index then
		return
	end
	local mutationId = d.capsules[index].mutation
	local m = Mutations.List[mutationId]
	if table.find(pet.mutations, mutationId) then
		S.AnnounceService:Notify(player, "This pet already has " .. m.displayName .. ".", "warn")
		return
	end
	local cost = Mutations.ApplyCost[m.rarity]
	if not S.DataService:Spend(player, "mutagen", cost) then
		S.AnnounceService:Notify(player, ("Need %d Mutagen 🧪"):format(cost), "warn")
		return
	end
	table.remove(d.capsules, index)
	local slots = PetStats.MutationSlots(pet)
	if #pet.mutations >= slots then
		table.remove(pet.mutations, 1)
	end
	table.insert(pet.mutations, mutationId)
	S.DataService:Replicate(player, "capsules")
	self:RefreshVault(player)
	S.PetService:RefreshPet(player, petUid)
	Net.Event("MutationCinematic"):FireClient(player, { kind = "Mutation", uid = petUid, id = mutationId })
	if Rarity.Rank(m.rarity) >= 5 then
		S.AnnounceService:Announce(("%s gave their %s %s %s!"):format(player.DisplayName, Pets.Species[pet.species].displayName, m.emoji, m.displayName), "reward")
	end
end

----------------------------------------------------------------------------
-- Vault pedestals + stealing
----------------------------------------------------------------------------

local VAULT_ORIGIN = Vector3.new(44, 0, -24)
local VAULT_STEP = 9

function MutationService:OnPlotAssigned(player: Player, plot)
	vaults[player] = { plot = plot }
	self:RefreshVault(player)
end

function MutationService:OnPlotReleased(plot)
	for player, vault in vaults do
		if vault.plot == plot then
			if vault.model then
				vault.model:Destroy()
			end
			vaults[player] = nil
		end
	end
end

function MutationService:RefreshVault(player: Player)
	local vault = vaults[player]
	local d = S.DataService:Get(player)
	if not vault or not d then
		return
	end
	local plot = vault.plot
	if vault.model then
		vault.model:Destroy()
	end
	local m = StudStyle.Model(plot.model, "Vault")
	vault.model = m
	local size = self:VaultSize(player)
	for i = 1, size do
		local row = (i - 1) % 6
		local col = math.floor((i - 1) / 6)
		local offset = VAULT_ORIGIN + Vector3.new(-col * 8, 0, row * VAULT_STEP)
		local pos = plot.cf:PointToWorldSpace(offset)
		local pedestal = StudStyle.OnGround(m, Vector3.new(4, 2, 4), pos, Color3.fromRGB(70, 70, 86), { name = "Pedestal" .. i })
		local capsule = d.capsules[i]
		if capsule then
			local mut = Mutations.List[capsule.mutation]
			Props.Capsule(m, CFrame.new(pos + Vector3.new(0, 3.8, 0)), mut, 1)
			StudStyle.Label(pedestal, ("%s %s"):format(mut.emoji, mut.displayName), Rarity.Color(mut.rarity), 55, 0.65)
			local prompt = Instance.new("ProximityPrompt")
			prompt.ActionText = "Steal"
			prompt.ObjectText = mut.displayName
			prompt.HoldDuration = 1.6
			prompt.MaxActivationDistance = 9
			prompt.RequiresLineOfSight = false
			prompt:SetAttribute("OwnerUserId", player.UserId)
			CollectionService:AddTag(prompt, "VisitorPrompt")
			prompt.Parent = pedestal
			local capsuleId = capsule.id
			prompt.Triggered:Connect(function(thief)
				self:TrySteal(thief, player, capsuleId)
			end)
		end
	end
end

function MutationService:TrySteal(thief: Player, victim: Player, capsuleId: string)
	if thief == victim or not victim.Parent then
		return
	end
	local victimData = S.DataService:Get(victim)
	local thiefData = S.DataService:Get(thief)
	local vault = vaults[victim]
	if not victimData or not thiefData or not vault then
		return
	end
	if S.PlotService:IsLocked(vault.plot) then
		S.AnnounceService:Notify(thief, "🔒 This base is locked!", "warn")
		return
	end
	if os.time() - victimData.firstJoin < STEAL_PROTECTION_SECONDS then
		S.AnnounceService:Notify(thief, "🛡️ New farmers are protected. Find another target!", "warn")
		return
	end
	if S.CarryService:IsCarrying(thief) then
		return
	end
	local index = nil
	for i, c in victimData.capsules do
		if c.id == capsuleId then
			index = i
			break
		end
	end
	if not index then
		return
	end
	local capsule = table.remove(victimData.capsules, index)
	S.DataService:Replicate(victim, "capsules")
	self:RefreshVault(victim)
	local mut = Mutations.List[capsule.mutation]

	S.AnnounceService:Notify(victim, ("🚨 %s is stealing your %s! Your army is on it!"):format(thief.DisplayName, mut.displayName), "error")
	S.CarryService:StartCarry(thief, {
		kind = "Capsule",
		label = ("%s STOLEN %s"):format(mut.emoji, mut.displayName:upper()),
		victim = victim,
		speedMult = 0.8,
		timeout = 120,
		visual = function(parent: Instance, cf: CFrame)
			return Props.Capsule(parent, cf, mut, 0.9)
		end,
		deliverCheck = function()
			return S.PlotService:IsOnPlot(thief, -10)
		end,
		onDeliver = function()
			self:AddCapsule(thief, capsule.mutation, "stolen")
			S.DataService:IncrementStat(thief, "capsulesStolen")
			S.AnnounceService:Announce(("🦹 %s stole %s's %s %s!"):format(thief.DisplayName, victim.DisplayName, mut.emoji, mut.displayName), "warn")
		end,
		onDrop = function(reason: string)
			if victim.Parent and S.DataService:Get(victim) then
				table.insert(victimData.capsules, capsule)
				S.DataService:Replicate(victim, "capsules")
				self:RefreshVault(victim)
				if reason == "caught" then
					S.AnnounceService:Notify(victim, ("🛡️ Your army caught %s and got your capsule back!"):format(thief.DisplayName), "good")
				end
			end
		end,
	})
end

----------------------------------------------------------------------------
-- Hub Brainrot Belt
----------------------------------------------------------------------------

function MutationService:Step(_dt: number)
	local now = os.clock()
	if now >= nextBeltSpawn and #beltItems < BELT_MAX then
		nextBeltSpawn = now + BELT_SPAWN_EVERY
		self:SpawnBeltItem()
	end
end

function MutationService:SpawnBeltItem()
	local bias = if S.MonetizationService:ServerLuckActive() then 1.5 else 0.3
	local mutationId = self:RollMutation(bias)
	local mut = Mutations.List[mutationId]
	local price = Mutations.BeltPrice[mut.rarity]
	local from = World.BrainrotBelt.from + Vector3.new(0, 3.4, 0)
	local to = World.BrainrotBelt.to + Vector3.new(0, 3.4, 0)

	local model = Props.Capsule(beltFolder, CFrame.new(from), mut, 1.1)
	local anchor = model.PrimaryPart :: BasePart
	StudStyle.Label(anchor, ("%s %s\n💰%s"):format(mut.emoji, mut.displayName, Format.Short(price)), Rarity.Color(mut.rarity), 90, 0.9)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Buy"
	prompt.ObjectText = ("%s · 💰%s"):format(mut.displayName, Format.Short(price))
	prompt.HoldDuration = 0.2
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = anchor

	local item = { model = model, mutation = mutationId, price = price, sold = false }
	table.insert(beltItems, item)

	-- Move the whole capsule along the belt with one tween per part.
	local info = TweenInfo.new(BELT_TRAVEL, Enum.EasingStyle.Linear)
	local offset = to - from
	for _, p in model:GetChildren() do
		if p:IsA("BasePart") then
			TweenService:Create(p, info, { CFrame = p.CFrame + offset }):Play()
		end
	end

	prompt.Triggered:Connect(function(player)
		if item.sold then
			return
		end
		local d = S.DataService:Get(player)
		if not d then
			return
		end
		if #d.capsules >= self:VaultSize(player) then
			S.AnnounceService:Notify(player, "Capsule vault full!", "warn")
			return
		end
		if not S.DataService:Spend(player, "coins", price) then
			S.AnnounceService:Notify(player, ("Need 💰%s"):format(Format.Short(price)), "warn")
			return
		end
		item.sold = true
		self:AddCapsule(player, mutationId, "belt")
		if Rarity.Rank(mut.rarity) >= 5 then
			S.AnnounceService:Announce(("%s grabbed a %s %s off the Brainrot Belt!"):format(player.DisplayName, mut.emoji, mut.displayName), "reward")
		end
		self:RemoveBeltItem(item)
	end)

	task.delay(BELT_TRAVEL, function()
		self:RemoveBeltItem(item)
	end)
end

function MutationService:RemoveBeltItem(item)
	local i = table.find(beltItems, item)
	if i then
		table.remove(beltItems, i)
	end
	if item.model.Parent then
		item.model:Destroy()
	end
end


return MutationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">PetAIService</string>
            <string name="Source"><![CDATA[--[[
	PetAIService: the Animal Army brain. Runs at 10 Hz on the server.

	Per squad, per tick:
	  1. Context     owner position/facing, command mode, anchor (owner or
	                 base core), thieves, whether the owner stands on a
	                 structure (then pets raycast for floor height).
	  2. Separation  squadmates push apart so they never stack.
	  3. Per pet     a small state machine:

	       Fainted -> (timer) -> Follow
	       Mounted -> glued under the owner (MountService handles input)
	       Thief nearby -> Chase thief -> Catch (drops stolen loot)
	       Target?  -> TryAbility -> Engage (surround / kite) -> Attack
	       else     -> Formation slot (V behind owner, ring around core)

	Target choice is role-driven, which is what makes the army read as a
	team instead of a blob:
	  Tank     picks the zombie closest to the OWNER and taunts
	  Striker  picks the weakest zombie (finishing blows)
	  Ranged   kites at 85% range, fires projectiles
	  Support  stays near the owner, heals the squad on a pulse
	A "pressure" count spreads pets across targets; a focus command
	(tap a zombie) overrides everything.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Protocol = require(Shared.Util.EntityProtocol)
local World = require(Shared.Config.World)
local Pets = require(Shared.Config.Pets)
local Fruits = require(Shared.Config.Fruits)
local Rng = require(Shared.Util.Rng)

local State = Protocol.State
local EV = Protocol.Event

local AGGRO = { Follow = 38, Attack = 90, Guard = 60, Hunt = 90 }
local LEASH = { Follow = 70, Attack = 120, Guard = 75, Hunt = 150 }
local TELEPORT_DIST = 220
local SCAN_INTERVAL = 0.3
local SEPARATION = 3

local MEME_TEXT = {
	GravityFlip = "🌀 GRAVITY? NEVER HEARD OF HER",
	BruhFreeze = "💀 bruh.",
	ConfettiNuke = "🎉 CONFETTI NUKE",
	GigaMode = "🗿 GIGA MODE",
}

local PetAIService = { Name = "PetAIService" }

local S
local floorParams: RaycastParams

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function flatDist(a: Vector3, b: Vector3): number
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

local function yawFrom(dir: Vector3): number
	return math.atan2(-dir.X, -dir.Z)
end

function PetAIService:Init(services)
	S = services
end

function PetAIService:Start()
	floorParams = RaycastParams.new()
	floorParams.FilterType = Enum.RaycastFilterType.Include
	local filter = {}
	for _, name in { "World", "Plots" } do
		local folder = workspace:FindFirstChild(name)
		if folder then
			table.insert(filter, folder)
		end
	end
	floorParams.FilterDescendantsInstances = filter
end

----------------------------------------------------------------------------
-- Tick
----------------------------------------------------------------------------

function PetAIService:Step(dt: number)
	local now = os.clock()
	for player, squad in S.PetService:Squads() do
		local root = S.EntityService:RootOf(player)
		if root and #squad.order > 0 then
			self:StepSquad(player, squad, root, dt, now)
		end
	end
end

function PetAIService:StepSquad(player: Player, squad, root: BasePart, dt: number, now: number)
	local character = root.Parent :: Model
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local ownerPos = root.Position
	local hip = if humanoid then humanoid.HipHeight else 2
	local ownerFeetY = ownerPos.Y - root.Size.Y / 2 - hip
	local look = flat(root.CFrame.LookVector)
	look = if look.Magnitude > 1e-3 then look.Unit else Vector3.new(0, 0, -1)

	local ctx = {
		player = player,
		squad = squad,
		ownerPos = ownerPos,
		ownerFeetY = ownerFeetY,
		look = look,
		mode = squad.mode,
		anchor = ownerPos,
		onStructure = math.abs(ownerFeetY - World.GroundHeight(ownerPos.X, ownerPos.Z)) > 4,
		now = now,
		dt = dt,
		ownerYaw = yawFrom(look),
		count = #squad.order,
	}

	if ctx.mode == "Guard" then
		local plot = S.PlotService:GetPlot(player)
		if plot then
			ctx.anchor = plot.corePos
		else
			ctx.mode = "Follow"
		end
	end
	if squad.focusId then
		local focus = S.EntityService:Get(squad.focusId)
		if not focus or focus.dead then
			squad.focusId = nil
			if squad.mode == "Attack" then
				squad.mode = "Follow"
				ctx.mode = "Follow"
			end
		end
	end

	-- How many squadmates already hit each target (spreads damage).
	local pressure = {}
	for _, pet in squad.order do
		if pet.target then
			pressure[pet.target] = (pressure[pet.target] or 0) + 1
		end
	end
	ctx.pressure = pressure
	ctx.thieves = S.CarryService:ThievesFrom(player)

	-- Separation
	local order = squad.order
	for i, a in order do
		local push = Vector3.zero
		for j, b in order do
			if i ~= j and not b.fainted then
				local d = flat(a.pos - b.pos)
				local m = d.Magnitude
				if m < SEPARATION and m > 1e-3 then
					push += d.Unit * (SEPARATION - m)
				end
			end
		end
		a.sep = push
	end

	for i, pet in order do
		self:StepPet(ctx, pet, i)
	end
end

----------------------------------------------------------------------------
-- Per-pet state machine
----------------------------------------------------------------------------

function PetAIService:StepPet(ctx, pet, slot: number)
	local now = ctx.now
	local stats = pet.stats

	if pet.fainted then
		pet.state = State.Fainted
		if now >= pet.respawnAt then
			pet.fainted = false
			pet.hp = pet.maxHp
			pet.pos = self:FormationSlot(ctx, slot)
			S.CombatService:Text(pet, "Back in action!", "#7CFF6B")
		end
		return
	end

	if pet.mounted then
		pet.pos = Vector3.new(ctx.ownerPos.X, ctx.ownerFeetY, ctx.ownerPos.Z)
		pet.yaw = ctx.ownerYaw
		pet.state = State.Mounted
		return
	end

	self:Passives(ctx, pet)

	-- Hopelessly far (owner teleported or galloped off): snap to formation.
	local home = if ctx.mode == "Guard" then ctx.anchor else ctx.ownerPos
	if flatDist(pet.pos, home) > TELEPORT_DIST then
		pet.pos = self:FormationSlot(ctx, slot)
		pet.target = nil
		return
	end

	-- Thieves carrying our owner's loot take priority over zombies.
	for _, thief in ctx.thieves do
		local d = flatDist(pet.pos, thief.pos)
		if d < 55 then
			if d < 5 + pet.radius then
				S.CarryService:Catch(thief.player, ctx.player, pet)
			else
				self:MoveToward(ctx, pet, thief.pos, stats.speed * 1.3, 1)
			end
			return
		end
	end

	-- Validate / reacquire target
	local target = S.EntityService:Get(pet.target)
	if target and (target.dead or target.removed or flatDist(target.pos, ctx.anchor) > LEASH[ctx.mode] + 10) then
		target = nil
		pet.target = nil
	end
	if not target or now >= pet.nextScan then
		local best = self:ChooseTarget(ctx, pet)
		if best ~= target then
			if target then
				ctx.pressure[target.id] = math.max(0, (ctx.pressure[target.id] or 1) - 1)
			end
			if best then
				ctx.pressure[best.id] = (ctx.pressure[best.id] or 0) + 1
			end
		end
		target = best
		pet.target = if best then best.id else nil
		pet.nextScan = now + SCAN_INTERVAL + (pet.id % 4) * 0.025
	end

	if target then
		if self:TryAbility(ctx, pet, target) then
			return
		end
		self:Engage(ctx, pet, target, slot)
	else
		local speed = stats.speed
		local distOwner = flatDist(pet.pos, ctx.ownerPos)
		if distOwner > 14 then
			speed = math.max(speed, 30) * (if distOwner > 40 then 1.8 else 1.2)
		end
		self:MoveToward(ctx, pet, self:FormationSlot(ctx, slot), speed, 0.8)
	end
end

function PetAIService:Passives(ctx, pet)
	local now, dt = ctx.now, ctx.dt
	local stats = pet.stats
	local sp = stats.special
	local role = Pets.Roles[stats.role] or {}

	if sp.regen and now - (pet.lastHitAt or 0) > 3 and pet.hp < pet.maxHp then
		pet.hp = math.min(pet.maxHp, pet.hp + pet.maxHp * sp.regen * dt)
	end

	if stats.role == "Support" and now >= (pet.nextHeal or 0) then
		pet.nextHeal = now + role.healEvery
		local healed = false
		for _, mate in ctx.squad.order do
			if not mate.fainted and mate.hp < mate.maxHp and flatDist(mate.pos, pet.pos) < role.healRadius then
				local amount = mate.maxHp * role.healPct
				mate.hp = math.min(mate.maxHp, mate.hp + amount)
				S.EntityService:Event(mate.pos, { EV.Heal, mate.id, math.floor(amount) })
				healed = true
			end
		end
		if healed then
			S.EntityService:Event(pet.pos, { EV.Ability, pet.id, "Heal", pet.pos.X, pet.pos.Z, role.healRadius, 0, 0 })
		end
	end

	if (stats.role == "Tank" or sp.taunt) and now >= (pet.nextTaunt or 0) then
		local tank = Pets.Roles.Tank
		pet.nextTaunt = now + tank.tauntEvery
		local taunted = 0
		for _, z in S.ZombieService:Query(pet.pos, tank.tauntRadius, ctx.player.UserId) do
			if not z.boss then
				z.tauntedBy = pet
				z.tauntUntil = now + 3
				taunted += 1
			end
		end
		if taunted > 0 then
			S.EntityService:Event(pet.pos, { EV.Ability, pet.id, "Taunt", pet.pos.X, pet.pos.Z, tank.tauntRadius, 0, 0 })
		end
	end

	if pet.buff and now >= pet.buff.untilT then
		pet.buff = nil
		S.PetService:RefreshPet(ctx.player, pet.uid)
	end
end

----------------------------------------------------------------------------
-- Targeting
----------------------------------------------------------------------------

function PetAIService:ChooseTarget(ctx, pet)
	local stats = pet.stats
	local role = stats.role
	local center = if ctx.mode == "Guard" then ctx.anchor else ctx.ownerPos
	local candidates = S.ZombieService:Query(center, AGGRO[ctx.mode], ctx.player.UserId)
	local focusId = ctx.squad.focusId
	if focusId then
		local focus = S.EntityService:Get(focusId)
		if focus and not focus.dead and flatDist(focus.pos, center) < LEASH[ctx.mode] then
			return focus
		end
	end

	local best, bestScore = nil, math.huge
	for _, z in candidates do
		local d = flatDist(pet.pos, z.pos)
		local score
		if role == "Tank" then
			score = flatDist(z.pos, ctx.ownerPos) * 0.8 + d * 0.2
		elseif role == "Striker" then
			score = d - (1 - z.hp / z.maxHp) * 25
		elseif role == "Ranged" then
			score = d * 0.6
		else -- Support
			score = d + flatDist(z.pos, ctx.ownerPos) * 0.5
		end
		if z.boss then
			score -= if stats.special.bossDamage then 30 else 10
		end
		if role ~= "Tank" then
			score += (ctx.pressure[z.id] or 0) * 7
		end
		if score < bestScore then
			best, bestScore = z, score
		end
	end
	return best
end

----------------------------------------------------------------------------
-- Movement
----------------------------------------------------------------------------

function PetAIService:FloorY(ctx, x: number, z: number): number
	if not ctx.onStructure then
		return World.GroundHeight(x, z)
	end
	local origin = Vector3.new(x, ctx.ownerFeetY + 6, z)
	local hit = workspace:Raycast(origin, Vector3.new(0, -40, 0), floorParams)
	return if hit then hit.Position.Y else ctx.ownerFeetY
end

-- V formation behind the owner; alpha walks at their right hand.
function PetAIService:FormationSlot(ctx, i: number): Vector3
	local p
	if ctx.mode == "Guard" then
		local a = (i / math.max(1, ctx.count)) * math.pi * 2
		p = ctx.anchor + Vector3.new(math.cos(a) * 9, 0, math.sin(a) * 9)
	else
		local look = ctx.look
		local right = Vector3.new(-look.Z, 0, look.X)
		if i == 1 then
			p = ctx.ownerPos + right * 4 + look * 1.5
		else
			local row = math.floor((i - 2) / 3)
			local col = (i - 2) % 3 - 1
			p = ctx.ownerPos - look * (4.5 + row * 4) + right * (col * 4.5)
		end
	end
	return Vector3.new(p.X, self:FloorY(ctx, p.X, p.Z), p.Z)
end

function PetAIService:MoveToward(ctx, pet, goal: Vector3, speed: number, stopDist: number)
	local to = Vector3.new(goal.X - pet.pos.X, 0, goal.Z - pet.pos.Z)
	local dist = to.Magnitude
	local sep = pet.sep or Vector3.zero
	if dist <= stopDist and sep.Magnitude < 0.5 then
		if ctx.now > (pet.stateHold or 0) then
			pet.state = State.Idle
		end
		return
	end
	local dir = if dist > 1e-3 then to / dist else Vector3.zero
	local move = dir * math.min(dist, speed * ctx.dt) + sep * ctx.dt * 5
	local nx, nz = pet.pos.X + move.X, pet.pos.Z + move.Z
	if not ctx.onStructure then
		nx, nz = World.ClampToValley(nx, nz, 6)
	end
	if dist > 1e-3 then
		pet.yaw = yawFrom(dir)
	end
	pet.pos = Vector3.new(nx, self:FloorY(ctx, nx, nz), nz)
	if ctx.now > (pet.stateHold or 0) then
		pet.state = State.Move
	end
end

----------------------------------------------------------------------------
-- Combat
----------------------------------------------------------------------------

function PetAIService:Engage(ctx, pet, target, slot: number)
	local now = ctx.now
	local stats = pet.stats
	local reach = stats.range + target.radius + pet.radius * 0.5
	local to = flat(target.pos - pet.pos)
	local dist = to.Magnitude

	if stats.role == "Ranged" then
		if dist > reach then
			self:MoveToward(ctx, pet, target.pos - to.Unit * reach * 0.85, stats.speed, 0.5)
			return
		elseif dist < reach * 0.35 then
			self:MoveToward(ctx, pet, pet.pos - to.Unit * 6, stats.speed, 0.5)
		end
	elseif dist > reach then
		-- Surround: each pet approaches its own angle around the target.
		local angle = (slot / math.max(1, ctx.count)) * math.pi * 2 + (target.id % 7)
		local goal = target.pos + Vector3.new(math.cos(angle), 0, math.sin(angle)) * (reach * 0.8)
		self:MoveToward(ctx, pet, goal, stats.speed, 0.5)
		return
	end

	if dist > 1e-3 then
		pet.yaw = yawFrom(to.Unit)
	end
	if now >= pet.nextAttack then
		pet.nextAttack = now + 1 / stats.attackRate
		pet.state = State.Attack
		pet.stateHold = now + 0.3
		local fruit = pet.fruitId and Fruits.List[pet.fruitId]
		local fx = if fruit then fruit.element else "Hit"
		if stats.role == "Ranged" then
			S.EntityService:Event(pet.pos, { EV.Projectile, pet.id, target.id, fx })
		end
		S.CombatService:PetBasicHit(pet, target, stats.power, fx)
	elseif now > (pet.stateHold or 0) then
		pet.state = State.Idle
	end
end

function PetAIService:TryAbility(ctx, pet, target): boolean
	local abilities = pet.stats.abilities
	for i = #abilities, 1, -1 do
		local ability = abilities[i]
		if ctx.now >= (pet.cooldowns[ability.id] or 0) and self:Cast(ctx, pet, target, ability) then
			pet.cooldowns[ability.id] = ctx.now + ability.cooldown
			pet.state = State.Ability
			pet.stateHold = ctx.now + 0.6
			S.CombatService:Text(pet, ability.name .. "!", "#FFE45C")
			return true
		end
	end
	return false
end

-- Generic ability executor. New fruits only add data to Config/Fruits.
function PetAIService:Cast(ctx, pet, target, ability): boolean
	local viewer = ctx.player.UserId
	local power = pet.stats.power
	local kind = ability.kind
	local dist = flatDist(pet.pos, target.pos)
	local boss = target.boss == true
	local function enough(n: number): boolean
		return n >= (ability.minTargets or 1) or boss
	end

	if kind == "Burst" then
		if dist > ability.radius then
			return false
		end
		if not enough(#S.ZombieService:Query(pet.pos, ability.radius, viewer)) then
			return false
		end
		S.CombatService:Burst(pet, pet.pos, ability.radius, power * ability.damageMult, ability.status, ability.fx, viewer)
		if ability.grantsAura then
			pet.aura = math.min((pet.aura or 0) + ability.grantsAura, 50)
			S.CombatService:Text(pet, "✨ +1000 AURA", "#FFD700")
		end
		return true
	elseif kind == "Cone" then
		if dist > ability.range then
			return false
		end
		local dir = flat(target.pos - pet.pos)
		local cosHalf = math.cos(math.rad(ability.angle / 2))
		local n = 0
		for _, z in S.ZombieService:Query(pet.pos, ability.range, viewer) do
			local to = flat(z.pos - pet.pos)
			if to.Magnitude < 2 or (dir.Magnitude > 0 and to.Unit:Dot(dir.Unit) >= cosHalf) then
				n += 1
			end
		end
		if not enough(n) then
			return false
		end
		pet.yaw = yawFrom(dir.Unit)
		S.CombatService:Cone(pet, pet.pos, dir, ability.range, ability.angle, power * ability.damageMult, ability.status, ability.fx, viewer)
		return true
	elseif kind == "Chain" then
		if dist > pet.stats.range + 12 then
			return false
		end
		if not enough(#S.ZombieService:Query(target.pos, ability.jumpRange, viewer)) then
			return false
		end
		S.CombatService:ChainFrom(pet, target, ability.jumps, ability.jumpRange, power * ability.damageMult, ability.status, ability.fx, true)
		return true
	elseif kind == "Dash" then
		if dist > ability.dashRange then
			return false
		end
		-- Land on the densest cluster in reach.
		local best, bestN = target, 0
		local candidates = S.ZombieService:Query(pet.pos, ability.dashRange, viewer)
		for i = 1, math.min(#candidates, 12) do
			local z = candidates[i]
			local n = #S.ZombieService:Query(z.pos, ability.radius, viewer)
			if n > bestN then
				best, bestN = z, n
			end
		end
		if not enough(bestN) then
			return false
		end
		local from = pet.pos
		local back = flat(from - best.pos)
		local landing = best.pos + (if back.Magnitude > 1e-3 then back.Unit * 2 else Vector3.zero)
		pet.pos = Vector3.new(landing.X, self:FloorY(ctx, landing.X, landing.Z), landing.Z)
		S.EntityService:Event(from, { EV.Ability, pet.id, "Dash", from.X, from.Z, 0, landing.X - from.X, landing.Z - from.Z })
		S.CombatService:Burst(pet, best.pos, ability.radius, power * ability.damageMult, ability.status, ability.fx, viewer)
		return true
	elseif kind == "Meme" then
		if dist > ability.radius then
			return false
		end
		if not enough(#S.ZombieService:Query(pet.pos, ability.radius, viewer)) then
			return false
		end
		local effect = Rng.Pick(ability.memeEffects, function(e)
			return e.weight
		end)
		S.CombatService:Text(pet, MEME_TEXT[effect.id] or effect.id, "#FF46D2")
		if effect.buff then
			pet.buff = { power = effect.buff.power, untilT = ctx.now + effect.buff.duration }
			local look = table.clone(pet.appearance)
			look.scale = (look.scale or 1) * effect.buff.size
			S.EntityService:SetAppearance(pet, look)
			S.EntityService:Event(pet.pos, { EV.Ability, pet.id, "Meme_GigaMode", pet.pos.X, pet.pos.Z, 10, 0, 0 })
		else
			S.CombatService:Burst(pet, pet.pos, ability.radius, power * effect.damageMult, effect.status, "Meme_" .. effect.id, viewer)
		end
		return true
	end
	return false
end

return PetAIService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">PetService</string>
            <string name="Source"><![CDATA[--[[
	PetService: pet inventory, hatching, equipping, crafting, leveling and
	the lifecycle of pet entities in the world. The per-tick brain lives in
	PetAIService; this service owns data and spawning.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Pets = require(Shared.Config.Pets)
local Eggs = require(Shared.Config.Eggs)
local Rarity = require(Shared.Config.Rarity)
local Fruits = require(Shared.Config.Fruits)
local World = require(Shared.Config.World)
local Progression = require(Shared.Config.Progression)
local PetStats = require(Shared.Util.PetStats)
local Rng = require(Shared.Util.Rng)
local Protocol = require(Shared.Util.EntityProtocol)

local State = Protocol.State

local PetService = { Name = "PetService" }

local S
local squads: { [Player]: any } = {}
local lastHatch: { [Player]: number } = {}
local dirtyPets: { [Player]: { [string]: boolean } } = {}

local VALID_MODES = { Follow = true, Attack = true, Guard = true, Hunt = true }

function PetService:Init(services)
	S = services
end

function PetService:Start()
	S.DataService.PlayerLoaded:Connect(function(player)
		self:CreateSquad(player)
	end)
	S.DataService.PlayerLeaving:Connect(function(player)
		self:DestroySquad(player)
	end)

	Net.Event("EquipPet").OnServerEvent:Connect(function(player, uid)
		if type(uid) == "string" then
			self:Equip(player, uid)
		end
	end)
	Net.Event("UnequipPet").OnServerEvent:Connect(function(player, uid)
		if type(uid) == "string" then
			self:Unequip(player, uid)
		end
	end)
	Net.Event("EquipBest").OnServerEvent:Connect(function(player)
		self:EquipBest(player)
	end)
	Net.Event("SetAlpha").OnServerEvent:Connect(function(player, uid)
		if type(uid) == "string" then
			self:SetAlpha(player, uid)
		end
	end)
	Net.Event("LockPet").OnServerEvent:Connect(function(player, uid)
		local d = S.DataService:Get(player)
		if d and type(uid) == "string" and d.pets[uid] then
			d.pets[uid].locked = not d.pets[uid].locked
			S.DataService:ReplicatePet(player, uid)
		end
	end)
	Net.Event("SellPet").OnServerEvent:Connect(function(player, uids)
		if type(uids) == "table" then
			self:Sell(player, uids)
		end
	end)
	Net.Event("CraftPet").OnServerEvent:Connect(function(player, uid)
		if type(uid) == "string" then
			self:Craft(player, uid)
		end
	end)
	Net.Event("SquadCommand").OnServerEvent:Connect(function(player, mode, targetId)
		local squad = squads[player]
		if squad and type(mode) == "string" and VALID_MODES[mode] then
			squad.mode = mode
			squad.focusId = if mode == "Attack" and type(targetId) == "number" then targetId else nil
			squad.modeChangedAt = os.clock()
			for _, pet in squad.order do
				pet.target = nil
				pet.nextScan = 0
			end
		end
	end)
	Net.Function("HatchEgg").OnServerInvoke = function(player, eggId, count)
		if type(eggId) ~= "string" then
			return { ok = false, err = "Bad egg" }
		end
		return self:Hatch(player, eggId, if count == 3 then 3 else 1)
	end

	-- Flush pet XP progress to clients every few seconds (not every kill).
	task.spawn(function()
		while true do
			task.wait(3)
			for player, set in dirtyPets do
				for uid in set do
					S.DataService:ReplicatePet(player, uid)
				end
				dirtyPets[player] = nil
			end
		end
	end)
end

----------------------------------------------------------------------------
-- Squads & entities
----------------------------------------------------------------------------

function PetService:GetSquad(player: Player)
	return squads[player]
end

function PetService:Squads()
	return squads
end

function PetService:CreateSquad(player: Player)
	squads[player] = { pets = {}, order = {}, mode = "Follow", focusId = nil, player = player }
	self:RefreshEquipSlots(player)
	local d = S.DataService:Get(player)
	for _, uid in d.equipped do
		self:SpawnPet(player, uid)
	end
	player.CharacterAdded:Connect(function(character)
		local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
		local squad = squads[player]
		if root and squad then
			for i, pet in squad.order do
				pet.pos = root.Position + Vector3.new(math.cos(i) * 4, -3, math.sin(i) * 4)
				pet.target = nil
			end
		end
	end)
end

function PetService:DestroySquad(player: Player)
	local squad = squads[player]
	if not squad then
		return
	end
	for _, pet in squad.order do
		S.EntityService:Remove(pet)
	end
	squads[player] = nil
	lastHatch[player] = nil
	dirtyPets[player] = nil
end

function PetService:Appearance(pet, stats)
	return {
		source = "Pet",
		species = pet.species,
		variant = pet.variant,
		fruit = pet.fruit and pet.fruit.id,
		awakened = stats.special.awakened,
		mutations = pet.mutations,
		scale = stats.sizeMult,
	}
end

function PetService:SpawnPet(player: Player, uid: string)
	local squad = squads[player]
	local d = S.DataService:Get(player)
	local pet = d and d.pets[uid]
	if not squad or not pet or squad.pets[uid] then
		return
	end
	local stats = PetStats.Compute(pet)
	local root = S.EntityService:RootOf(player)
	local start = if root then root.Position - Vector3.new(0, 3, 0) else World.HubSpawn
	local body = Pets.Species[pet.species].body
	local length = (body.size and body.size.Z or 3)
	local entity = S.EntityService:Create("Pet", {
		ownerId = player.UserId,
		owner = player,
		uid = uid,
		name = Pets.Species[pet.species].displayName,
		rarity = Pets.Species[pet.species].rarity,
		level = pet.level,
		stats = stats,
		fruitId = pet.fruit and pet.fruit.id,
		maxHp = stats.hp,
		hp = stats.hp,
		pos = start + Vector3.new(math.random(-4, 4), 0, math.random(-4, 4)),
		radius = length * 0.5 * stats.sizeMult,
		appearance = self:Appearance(pet, stats),
		cooldowns = {},
		nextAttack = 0,
		nextScan = 0,
		aura = 0,
	})
	squad.pets[uid] = entity
	self:RebuildOrder(player)
end

function PetService:DespawnPet(player: Player, uid: string)
	local squad = squads[player]
	local entity = squad and squad.pets[uid]
	if not entity then
		return
	end
	if entity.mounted then
		S.MountService:Dismount(player)
	end
	S.EntityService:Remove(entity)
	squad.pets[uid] = nil
	self:RebuildOrder(player)
end

-- Alpha first, then by power: the formation reads strongest-in-front.
function PetService:RebuildOrder(player: Player)
	local squad = squads[player]
	local d = S.DataService:Get(player)
	if not squad or not d then
		return
	end
	local order = {}
	for _, e in squad.pets do
		e.isAlpha = e.uid == d.alpha
		table.insert(order, e)
	end
	table.sort(order, function(a, b)
		if a.isAlpha ~= b.isAlpha then
			return a.isAlpha
		end
		return a.stats.powerScore > b.stats.powerScore
	end)
	squad.order = order
end

-- Recompute stats + visuals after level/fruit/mutation/variant changes.
function PetService:RefreshPet(player: Player, uid: string)
	local d = S.DataService:Get(player)
	local pet = d and d.pets[uid]
	if not pet then
		return
	end
	S.DataService:ReplicatePet(player, uid)
	local squad = squads[player]
	local entity = squad and squad.pets[uid]
	if not entity then
		return
	end
	local stats = PetStats.Compute(pet)
	local ratio = if entity.maxHp > 0 then entity.hp / entity.maxHp else 1
	entity.stats = stats
	entity.level = pet.level
	entity.fruitId = pet.fruit and pet.fruit.id
	entity.hp = stats.hp * math.max(ratio, 0.01)
	entity.radius = (Pets.Species[pet.species].body.size and Pets.Species[pet.species].body.size.Z or 3) * 0.5 * stats.sizeMult
	S.EntityService:SetAppearance(entity, self:Appearance(pet, stats), stats.hp)
	self:RebuildOrder(player)
end

function PetService:OnFainted(entity, _killer)
	entity.fainted = true
	entity.dead = false -- pets faint, they never die
	entity.hp = 0
	entity.state = State.Fainted
	entity.target = nil
	entity.respawnAt = os.clock() + Pets.FaintSeconds
	if entity.mounted and entity.owner then
		S.MountService:Dismount(entity.owner)
	end
end

----------------------------------------------------------------------------
-- Equip management
----------------------------------------------------------------------------

function PetService:EquipSlots(player: Player): number
	local d = S.DataService:Get(player)
	if not d then
		return Pets.BaseEquipSlots
	end
	local slots = Pets.BaseEquipSlots
	if S.MonetizationService:HasPass(player, "ExtraEquip") then
		slots += 1
	end
	if S.MonetizationService:IsVIP(player) then
		slots += 1
	end
	for rebirth in Progression.Rebirth.equipSlotAt do
		if d.rebirths >= rebirth then
			slots += 1
		end
	end
	return math.min(slots, Pets.MaxEquipSlots)
end

function PetService:InventoryMax(player: Player): number
	return Pets.BaseInventory + (if S.MonetizationService:IsVIP(player) then 40 else 0)
end

function PetService:RefreshEquipSlots(player: Player)
	local d = S.DataService:Get(player)
	if not d then
		return
	end
	local slots = self:EquipSlots(player)
	player:SetAttribute("EquipSlots", slots)
	while #d.equipped > slots do
		local uid = table.remove(d.equipped)
		self:DespawnPet(player, uid)
	end
	S.DataService:Replicate(player, "equipped")
end

function PetService:Equip(player: Player, uid: string)
	local d = S.DataService:Get(player)
	if not d or not d.pets[uid] or table.find(d.equipped, uid) then
		return
	end
	if #d.equipped >= self:EquipSlots(player) then
		S.AnnounceService:Notify(player, "Army is full! Unequip a pet or get more slots.", "warn")
		return
	end
	table.insert(d.equipped, uid)
	if not d.alpha or not table.find(d.equipped, d.alpha) then
		d.alpha = uid
		S.DataService:Replicate(player, "alpha")
	end
	S.DataService:Replicate(player, "equipped")
	self:SpawnPet(player, uid)
end

function PetService:Unequip(player: Player, uid: string)
	local d = S.DataService:Get(player)
	local i = d and table.find(d.equipped, uid)
	if not i then
		return
	end
	table.remove(d.equipped, i)
	if d.alpha == uid then
		d.alpha = d.equipped[1]
		S.DataService:Replicate(player, "alpha")
	end
	S.DataService:Replicate(player, "equipped")
	self:DespawnPet(player, uid)
end

function PetService:EquipBest(player: Player)
	local d = S.DataService:Get(player)
	if not d then
		return
	end
	local list = {}
	for uid, pet in d.pets do
		table.insert(list, { uid = uid, score = PetStats.Compute(pet).powerScore })
	end
	table.sort(list, function(a, b)
		return a.score > b.score
	end)
	for _, uid in table.clone(d.equipped) do
		self:Unequip(player, uid)
	end
	for i = 1, math.min(#list, self:EquipSlots(player)) do
		self:Equip(player, list[i].uid)
	end
	d.alpha = d.equipped[1]
	S.DataService:Replicate(player, "alpha")
	self:RebuildOrder(player)
end

function PetService:SetAlpha(player: Player, uid: string)
	local d = S.DataService:Get(player)
	if not d or not table.find(d.equipped, uid) then
		return
	end
	if S.MountService:IsMounted(player) then
		S.MountService:Dismount(player)
	end
	d.alpha = uid
	S.DataService:Replicate(player, "alpha")
	self:RebuildOrder(player)
end

----------------------------------------------------------------------------
-- Granting, hatching, selling, crafting
----------------------------------------------------------------------------

function PetService:CountPets(player: Player): number
	local d = S.DataService:Get(player)
	local n = 0
	for _ in d.pets do
		n += 1
	end
	return n
end

function PetService:GrantPet(player: Player, species: string, variant: string?, opts: { [string]: any }?): string?
	local d = S.DataService:Get(player)
	if not d or not Pets.Species[species] then
		return nil
	end
	local o = opts or {}
	if not o.ignoreCap and self:CountPets(player) >= self:InventoryMax(player) then
		S.AnnounceService:Notify(player, "Pet inventory full! Sell or craft some pets.", "warn")
		return nil
	end
	local uid = S.DataService:NewUid()
	d.pets[uid] = {
		uid = uid,
		species = species,
		level = o.level or 1,
		xp = 0,
		variant = variant or "Normal",
		mutations = o.mutations or {},
		fruit = o.fruit,
	}
	S.DataService:ReplicatePet(player, uid)
	if #d.equipped < self:EquipSlots(player) then
		self:Equip(player, uid)
	end
	if not o.silent then
		self:AnnounceHatch(player, species, variant or "Normal")
	end
	return uid
end

function PetService:AnnounceHatch(player: Player, species: string, variant: string)
	local def = Pets.Species[species]
	local info = Rarity.Info[def.rarity]
	local isShiny = variant == "Shiny"
	if info.announce == "none" and not isShiny then
		return
	end
	local variantInfo = Pets.Variants[variant]
	local prefix = if variantInfo and variantInfo.label ~= "" then variantInfo.label .. " " else ""
	local text = ("%s hatched a %s%s %s! (%s)"):format(player.DisplayName, prefix, def.emoji, def.displayName, def.rarity)
	S.AnnounceService:Announce(text, if def.rarity == "Secret" then "secret" else "reward", info.announce == "global")
end

function PetService:Hatch(player: Player, eggId: string, count: number)
	local d = S.DataService:Get(player)
	local egg = Eggs.List[eggId]
	if not d or not egg or egg.source ~= "Shop" then
		return { ok = false, err = "That egg can't be hatched here." }
	end
	local now = os.clock()
	if lastHatch[player] and now - lastHatch[player] < Eggs.HatchCooldown then
		return { ok = false, err = "cooldown" }
	end
	if egg.levelReq and d.level < egg.levelReq then
		return { ok = false, err = ("Reach Lv %d to hatch this egg."):format(egg.levelReq) }
	end
	if count == 3 and not S.MonetizationService:HasPass(player, "TripleHatch") then
		count = 1
	end
	local root = S.EntityService:RootOf(player)
	local standPos = World.EggStands[eggId]
	if not root or not standPos or (root.Position - standPos).Magnitude > Eggs.HatchRange + 8 then
		return { ok = false, err = "Walk up to the egg to hatch it." }
	end
	if self:CountPets(player) + count > self:InventoryMax(player) then
		return { ok = false, err = "Pet inventory full! Sell or craft some pets." }
	end
	if not S.DataService:Spend(player, "coins", egg.price * count) then
		return { ok = false, err = "Not enough coins!" }
	end
	lastHatch[player] = now

	local odds = Rng.LuckAdjustedOdds(egg.odds, S.MonetizationService:Luck(player), Eggs.LuckMaxChance)
	local results = {}
	for _ = 1, count do
		local pick = Rng.Pick(odds, function(e)
			return e.chance
		end)
		local variant = if math.random() < Pets.Variants.Shiny.hatchChance then "Shiny" else "Normal"
		local uid = self:GrantPet(player, pick.pet, variant, { ignoreCap = true })
		table.insert(results, { uid = uid, species = pick.pet, variant = variant })
	end
	S.DataService:IncrementStat(player, "eggsHatched", count)
	S.DataService:AddXP(player, 5 * count)
	return { ok = true, results = results, egg = eggId }
end

-- Rolls a heist egg's table (no cost; used by the incubator).
function PetService:RollEgg(player: Player, eggId: string)
	local egg = Eggs.List[eggId]
	local odds = Rng.LuckAdjustedOdds(egg.odds, S.MonetizationService:Luck(player), Eggs.LuckMaxChance)
	local pick = Rng.Pick(odds, function(e)
		return e.chance
	end)
	local variant = if math.random() < Pets.Variants.Shiny.hatchChance * 2 then "Shiny" else "Normal"
	return pick.pet, variant
end

function PetService:Sell(player: Player, uids: { any })
	local d = S.DataService:Get(player)
	local total = 0
	for _, uid in uids do
		local pet = type(uid) == "string" and d.pets[uid]
		if pet and not pet.locked and not table.find(d.equipped, uid) then
			local def = Pets.Species[pet.species]
			total += Rarity.Info[def.rarity].sellValue * (Pets.Variants[pet.variant] or Pets.Variants.Normal).mult
			d.pets[uid] = nil
			S.DataService:ReplicatePet(player, uid)
		end
	end
	if total > 0 then
		S.DataService:Add(player, "coins", math.floor(total), true)
		S.AnnounceService:Notify(player, ("Sold for 💰%d"):format(math.floor(total)), "good")
	end
end

-- Five of the same species+variant -> one of the next variant.
function PetService:Craft(player: Player, uid: string)
	local d = S.DataService:Get(player)
	local base = d and d.pets[uid]
	if not base then
		return
	end
	local nextVariant = if base.variant == "Normal" then "Golden" elseif base.variant == "Golden" then "Rainbow" else nil
	if not nextVariant then
		S.AnnounceService:Notify(player, "This pet can't be crafted further.", "warn")
		return
	end
	local need = Pets.Variants[nextVariant].craftCount
	local picks = { uid }
	for otherUid, pet in d.pets do
		if #picks >= need then
			break
		end
		if otherUid ~= uid and pet.species == base.species and pet.variant == base.variant and not pet.locked and not table.find(d.equipped, otherUid) then
			table.insert(picks, otherUid)
		end
	end
	if #picks < need then
		S.AnnounceService:Notify(player, ("Need %d unequipped, unlocked %s %s to craft."):format(need, base.variant, Pets.Species[base.species].displayName), "warn")
		return
	end
	local level = 1
	for _, pickUid in picks do
		level = math.max(level, d.pets[pickUid].level)
	end
	local fruit, mutations = base.fruit, base.mutations
	for _, pickUid in picks do
		self:Unequip(player, pickUid)
		d.pets[pickUid] = nil
		S.DataService:ReplicatePet(player, pickUid)
	end
	self:GrantPet(player, base.species, nextVariant, { level = level, fruit = fruit, mutations = mutations, ignoreCap = true, silent = true })
	S.AnnounceService:Notify(player, ("Crafted a %s %s!"):format(nextVariant, Pets.Species[base.species].displayName), "reward")
end

----------------------------------------------------------------------------
-- Growth: XP, fruit mastery
----------------------------------------------------------------------------

function PetService:AddPetXP(player: Player, entity, amount: number)
	local d = S.DataService:Get(player)
	local pet = d and d.pets[entity.uid]
	if not pet then
		return
	end
	local maxLevel = Rarity.Info[Pets.Species[pet.species].rarity].maxLevel
	if pet.level >= maxLevel then
		return
	end
	pet.xp += amount
	local leveled = false
	while pet.level < maxLevel and pet.xp >= Progression.PetXpToNext(pet.level) do
		pet.xp -= Progression.PetXpToNext(pet.level)
		pet.level += 1
		leveled = true
	end
	if leveled then
		S.CombatService:Text(entity, ("LEVEL %d!"):format(pet.level), "#7CFF6B")
		self:RefreshPet(player, entity.uid)
	else
		dirtyPets[player] = dirtyPets[player] or {}
		dirtyPets[player][entity.uid] = true
	end
end

function PetService:AddMastery(player: Player, entity, amount: number)
	local d = S.DataService:Get(player)
	local pet = d and d.pets[entity.uid]
	if not pet or not pet.fruit then
		return
	end
	local fruit = Fruits.List[pet.fruit.id]
	local before = pet.fruit.mastery or 0
	local after = before + amount
	pet.fruit.mastery = after
	local milestone = false
	for _, ability in fruit.abilities do
		if before < ability.mastery and after >= ability.mastery then
			milestone = true
			S.AnnounceService:Notify(player, ("%s learned %s!"):format(entity.name, ability.name), "reward")
		end
	end
	if fruit.awaken and before < fruit.awaken.mastery and after >= fruit.awaken.mastery then
		milestone = true
		S.AnnounceService:Announce(("%s's %s AWAKENED its %s!"):format(player.DisplayName, entity.name, fruit.displayName), "reward")
	end
	if milestone then
		self:RefreshPet(player, entity.uid)
	else
		dirtyPets[player] = dirtyPets[player] or {}
		dirtyPets[player][entity.uid] = true
	end
end

-- Kill credit: the killer gets full XP and mastery, squadmates share half.
function PetService:AwardKill(player: Player, killer, xp: number, isBoss: boolean)
	local squad = squads[player]
	if not squad then
		return
	end
	for _, pet in squad.order do
		if pet == killer then
			self:AddPetXP(player, pet, xp)
			self:AddMastery(player, pet, if isBoss then 10 else 1)
			local sp = pet.stats.special
			if sp.auraPerKill then
				pet.aura = math.min((pet.aura or 0) + sp.auraPerKill, sp.auraMax or 50)
			end
		elseif not pet.fainted then
			self:AddPetXP(player, pet, xp * 0.5)
		end
	end
end

return PetService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[--[[
	PlotService: the eight Farm Bases on Farm Row.

	Each plot has: a Barn Heart (core) the zombies want, a Graveyard Rift
	they pour out of, six Build Pads for Build & Kill defenses, a conveyor
	(ConveyorService), a capsule vault (MutationService), an incubator
	(EggHeistService), a Start Wave button and a Lock Base button.

	Prompt visibility: prompts tagged "OwnerOnlyPrompt" are shown only to
	the plot owner and "VisitorPrompt" only to everyone else (the client
	filters by the prompt's OwnerUserId attribute).
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local World = require(Shared.Config.World)
local Base = require(Shared.Config.Base)
local StudStyle = require(Shared.Art.StudStyle)
local Protocol = require(Shared.Util.EntityProtocol)
local Format = require(Shared.Util.Format)

local EV = Protocol.Event
local C = StudStyle.Colors

local PlotService = { Name = "PlotService" }

local S
local plots = {}
local byPlayer: { [Player]: any } = {}
local infoFolder: Folder

local function lcf(plot, pos: Vector3, yaw: number?): CFrame
	return plot.cf * CFrame.new(pos) * CFrame.Angles(0, yaw or 0, 0)
end

local function at(plot, pos: Vector3): Vector3
	return plot.cf:PointToWorldSpace(pos)
end

function PlotService:Init(services)
	S = services
end

function PlotService:Start()
	infoFolder = Instance.new("Folder")
	infoFolder.Name = "PlotInfo"
	infoFolder.Parent = ReplicatedStorage

	local root = workspace:FindFirstChild("Plots") or Instance.new("Folder")
	root.Name = "Plots"
	root.Parent = workspace

	for i = 1, World.PlotCount do
		plots[i] = self:BuildPlot(i, root)
	end

	S.DataService.PlayerLoaded:Connect(function(player)
		self:Assign(player)
	end)
	S.DataService.PlayerLeaving:Connect(function(player)
		self:Release(player)
	end)
	Net.Event("LockBase").OnServerEvent:Connect(function(player)
		self:Lock(player)
	end)
end

----------------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------------

local function prompt(parent: Instance, action: string, object: string, tag: string, hold: number?): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = hold or 0.25
	p.MaxActivationDistance = 12
	p.RequiresLineOfSight = false
	p.Style = Enum.ProximityPromptStyle.Default
	p.Parent = parent
	CollectionService:AddTag(p, tag)
	return p
end

function PlotService:BuildPlot(index: number, parentFolder: Instance)
	local plot = {
		index = index,
		cf = World.PlotCFrame(index),
		owner = nil,
		defenses = {},
		pads = {},
		lockedUntil = 0,
		lockCooldownUntil = 0,
		coreMax = Base.Core.maxHp,
		coreHp = Base.Core.maxHp,
	}
	plot.corePos = at(plot, Base.CoreOffset)
	plot.riftPos = at(plot, Base.RiftOffset)
	plot.spawnCF = lcf(plot, Base.SpawnOffset + Vector3.new(0, 4, 0), math.pi)

	local model = StudStyle.Model(parentFolder, "Plot_" .. index)
	plot.model = model
	local size = Base.PlotSize
	local half = size / 2

	-- Farm floor + field rows
	StudStyle.Block(model, Vector3.new(size, 0.2, size), lcf(plot, Vector3.new(0, 0.1, 0)), Color3.fromRGB(110, 190, 84))
	StudStyle.Block(model, Vector3.new(14, 0.3, 30), lcf(plot, Vector3.new(0, 0.15, 44)), C.Path, { name = "Path" })

	-- Fence with a gate gap at the front (+Z)
	local fence = StudStyle.Model(model, "Fence")
	local function rail(pos: Vector3, len: number, alongX: boolean)
		local s = if alongX then Vector3.new(len, 0.5, 0.5) else Vector3.new(0.5, 0.5, len)
		StudStyle.Block(fence, s, lcf(plot, pos + Vector3.new(0, 2.6, 0)), C.White, { shadow = false })
		StudStyle.Block(fence, s, lcf(plot, pos + Vector3.new(0, 1.4, 0)), C.White, { shadow = false })
	end
	rail(Vector3.new(0, 0, -half), size, true)
	rail(Vector3.new(-half, 0, 0), size, false)
	rail(Vector3.new(half, 0, 0), size, false)
	local gap = 16
	local seg = (size - gap) / 2
	rail(Vector3.new(-half + seg / 2, 0, half), seg, true)
	rail(Vector3.new(half - seg / 2, 0, half), seg, true)
	for k = 0, 10 do
		local t = -half + k * (size / 10)
		for _, p in { Vector3.new(t, 0, -half), Vector3.new(-half, 0, t), Vector3.new(half, 0, t) } do
			StudStyle.OnGround(fence, Vector3.new(0.9, 3.4, 0.9), at(plot, p), C.White, { shadow = false })
		end
	end

	-- Graveyard Rift (zombie spawn)
	local rift = StudStyle.Model(model, "Rift")
	for _, sx in { -1, 1 } do
		StudStyle.OnGround(rift, Vector3.new(3, 12, 3), at(plot, Base.RiftOffset + Vector3.new(sx * 8, 0, 0)), C.DarkStone)
	end
	StudStyle.Block(rift, Vector3.new(20, 2, 3.4), lcf(plot, Base.RiftOffset + Vector3.new(0, 13, 0)), C.DarkStone)
	StudStyle.Neon(rift, Vector3.new(13, 11, 0.6), lcf(plot, Base.RiftOffset + Vector3.new(0, 5.8, 0)), Color3.fromRGB(150, 60, 220))
	for k, x in { -16, 14, 22 } do
		StudStyle.OnGround(rift, Vector3.new(2.4, 3.2, 0.8), at(plot, Base.RiftOffset + Vector3.new(x, 0, 6 + k)), C.Stone, { shadow = false })
	end

	-- Barn Heart (core)
	local core = StudStyle.Model(model, "BarnHeart")
	local cpos = Base.CoreOffset
	StudStyle.OnGround(core, Vector3.new(12, 7, 9), at(plot, cpos), C.Red)
	StudStyle.Block(core, Vector3.new(12.4, 0.6, 9.4), lcf(plot, cpos + Vector3.new(0, 7.1, 0)), C.White)
	for _, sx in { -1, 1 } do
		StudStyle.Block(core, Vector3.new(7.2, 0.8, 9.8), lcf(plot, cpos + Vector3.new(sx * 3.1, 9, 0)) * CFrame.Angles(0, 0, sx * -0.55), C.DarkWood)
	end
	StudStyle.Block(core, Vector3.new(3.4, 4.6, 0.4), lcf(plot, cpos + Vector3.new(0, 2.3, 4.6)), C.White, { collide = false })
	local gem = StudStyle.Neon(core, Vector3.new(2.4, 2.4, 2.4), lcf(plot, cpos + Vector3.new(0, 14, 0)) * CFrame.Angles(0, 0, math.rad(45)), Color3.fromRGB(255, 60, 90))
	gem.Name = "HeartGem"
	plot.coreBar = self:MakeBar(gem, "Barn Heart")

	-- Build pads
	for i, offset in Base.BuildPads do
		local pad = StudStyle.Block(model, Vector3.new(7, 0.6, 7), lcf(plot, offset + Vector3.new(0, 0.3, 0)), Color3.fromRGB(150, 110, 70), { name = "BuildPad" .. i })
		local pr = prompt(pad, "Build", "", "OwnerOnlyPrompt")
		pr.Triggered:Connect(function(player)
			self:OnPadTriggered(player, plot, i)
		end)
		plot.pads[i] = { part = pad, prompt = pr, offset = offset }
	end

	-- Buttons: Start Wave / Lock Base
	local waveBtn = StudStyle.OnGround(model, Vector3.new(5, 1, 5), at(plot, Base.WaveButtonOffset), Color3.fromRGB(70, 200, 90), { name = "WaveButton" })
	StudStyle.Label(waveBtn, "🧟 START WAVE", Color3.fromRGB(140, 255, 140), 60, 0.7)
	prompt(waveBtn, "Start Wave", "Barn Heart", "OwnerOnlyPrompt").Triggered:Connect(function(player)
		if self:GetPlot(player) == plot then
			S.ZombieService:StartWave(player)
		end
	end)
	local lockBtn = StudStyle.OnGround(model, Vector3.new(5, 1, 5), at(plot, Base.LockButtonOffset), Color3.fromRGB(220, 70, 70), { name = "LockButton" })
	StudStyle.Label(lockBtn, "🔒 LOCK BASE", Color3.fromRGB(255, 150, 150), 60, 0.7)
	prompt(lockBtn, "Lock Base", "Stops thieves", "OwnerOnlyPrompt").Triggered:Connect(function(player)
		if self:GetPlot(player) == plot then
			self:Lock(player)
		end
	end)

	-- Laser gate shown while locked
	local laser = StudStyle.Neon(model, Vector3.new(16, 6, 0.3), lcf(plot, Vector3.new(0, 3, half)), Color3.fromRGB(255, 40, 40))
	laser.Name = "LockLaser"
	laser.Transparency = 1
	plot.laser = laser

	-- Sign
	StudStyle.OnGround(model, Vector3.new(1, 7, 1), at(plot, Vector3.new(-12, 0, half + 2)), C.DarkWood)
	local board = StudStyle.Block(model, Vector3.new(14, 4, 0.8), lcf(plot, Vector3.new(-12, 8, half + 2)), C.Wood, { name = "Sign" })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.LightInfluence = 0
	gui.PixelsPerStud = 30
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.FredokaOne
	text.TextScaled = true
	text.TextColor3 = Color3.new(1, 1, 1)
	text.Text = "Empty Farm"
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Parent = text
	text.Parent = gui
	gui.Parent = board
	plot.signText = text

	-- Replicated info for client-side visuals (conveyor items, lock timer)
	local info = Instance.new("Folder")
	info.Name = "Plot_" .. index
	info:SetAttribute("Index", index)
	info:SetAttribute("OwnerUserId", 0)
	info.Parent = infoFolder
	plot.info = info

	return plot
end

function PlotService:MakeBar(adornee: BasePart, title: string)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(180, 42)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
	gui.MaxDistance = 150
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0.5, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Text = title
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = label
	label.Parent = gui
	local back = Instance.new("Frame")
	back.Position = UDim2.fromScale(0, 0.55)
	back.Size = UDim2.fromScale(1, 0.4)
	back.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
	back.BorderSizePixel = 0
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = back
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(255, 70, 100)
	fill.BorderSizePixel = 0
	corner:Clone().Parent = fill
	fill.Parent = back
	back.Parent = gui
	gui.Parent = adornee
	return fill
end

----------------------------------------------------------------------------
-- Ownership
----------------------------------------------------------------------------

function PlotService:Assign(player: Player)
	local plot = nil
	for _, p in plots do
		if not p.owner then
			plot = p
			break
		end
	end
	if not plot then
		S.AnnounceService:Notify(player, "All farms are taken on this server!", "error")
		return
	end
	plot.owner = player
	byPlayer[player] = plot
	plot.signText.Text = player.DisplayName .. "'s Farm"
	plot.info:SetAttribute("OwnerUserId", player.UserId)
	plot.info:SetAttribute("OwnerName", player.DisplayName)
	for _, prompt in plot.model:GetDescendants() do
		if prompt:IsA("ProximityPrompt") then
			prompt:SetAttribute("OwnerUserId", player.UserId)
		end
	end
	player:SetAttribute("PlotIndex", plot.index)

	local d = S.DataService:Get(player)
	for i = 1, #Base.BuildPads do
		local tier = d.base.defenses[tostring(i)] or 0
		self:SetDefense(plot, i, tier)
	end
	self:SetCoreHp(plot, plot.coreMax)

	local function toPlot(character: Model)
		task.defer(function()
			if character.Parent and byPlayer[player] == plot then
				character:PivotTo(plot.spawnCF)
			end
		end)
	end
	plot.charConn = player.CharacterAdded:Connect(toPlot)
	if player.Character then
		toPlot(player.Character)
	end

	S.ConveyorService:OnPlotAssigned(player, plot)
	S.MutationService:OnPlotAssigned(player, plot)
	S.EggHeistService:OnPlotAssigned(player, plot)
end

function PlotService:Release(player: Player)
	local plot = byPlayer[player]
	if not plot then
		return
	end
	S.ZombieService:EndWave(player, "left")
	byPlayer[player] = nil
	if plot.charConn then
		plot.charConn:Disconnect()
		plot.charConn = nil
	end
	for i in plot.defenses do
		self:ClearDefenseModel(plot, i)
	end
	plot.defenses = {}
	plot.owner = nil
	plot.lockedUntil = 0
	plot.laser.Transparency = 1
	plot.signText.Text = "Empty Farm"
	plot.info:SetAttribute("OwnerUserId", 0)
	plot.info:SetAttribute("OwnerName", nil)
	S.ConveyorService:OnPlotReleased(plot)
	S.MutationService:OnPlotReleased(plot)
	S.EggHeistService:OnPlotReleased(plot)
end

function PlotService:GetPlot(player: Player)
	return byPlayer[player]
end

function PlotService:Plots()
	return plots
end

function PlotService:IsOnPlot(player: Player, margin: number?): boolean
	local plot = byPlayer[player]
	local root = S.EntityService:RootOf(player)
	if not plot or not root then
		return false
	end
	local localPos = plot.cf:PointToObjectSpace(root.Position)
	local half = Base.PlotSize / 2 + (margin or 0)
	return math.abs(localPos.X) < half and math.abs(localPos.Z) < half
end

function PlotService:PlotAt(pos: Vector3)
	for _, plot in plots do
		local l = plot.cf:PointToObjectSpace(pos)
		if math.abs(l.X) < Base.PlotSize / 2 and math.abs(l.Z) < Base.PlotSize / 2 then
			return plot
		end
	end
	return nil
end

----------------------------------------------------------------------------
-- Core
----------------------------------------------------------------------------

function PlotService:SetCoreHp(plot, hp: number)
	plot.coreHp = math.clamp(hp, 0, plot.coreMax)
	plot.coreBar.Size = UDim2.fromScale(plot.coreHp / plot.coreMax, 1)
end

function PlotService:DamageCore(plot, amount: number)
	self:SetCoreHp(plot, plot.coreHp - amount)
	S.EntityService:Event(plot.corePos, { EV.Beam, "CoreHit", plot.corePos.X, plot.corePos.Y + 14, plot.corePos.Z, plot.corePos.X, plot.corePos.Y + 14, plot.corePos.Z })
end

----------------------------------------------------------------------------
-- Build & Kill defenses
----------------------------------------------------------------------------

function PlotService:OnPadTriggered(player: Player, plot, padIndex: number)
	if plot.owner ~= player then
		return
	end
	local d = S.DataService:Get(player)
	local key = tostring(padIndex)
	local tier = d.base.defenses[key] or 0
	local nextDef = Base.Defenses[tier + 1]
	if not nextDef then
		S.AnnounceService:Notify(player, "This defense is fully upgraded!", "info")
		return
	end
	if not S.DataService:Spend(player, "coins", nextDef.price) then
		S.AnnounceService:Notify(player, ("Need 💰%s for %s."):format(Format.Short(nextDef.price), nextDef.name), "warn")
		return
	end
	d.base.defenses[key] = tier + 1
	S.DataService:Replicate(player, "base")
	self:SetDefense(plot, padIndex, tier + 1)
	S.AnnounceService:Notify(player, ("Built %s!"):format(nextDef.name), "good")
end

function PlotService:ClearDefenseModel(plot, padIndex: number)
	local d = plot.defenses[padIndex]
	if d and d.model then
		d.model:Destroy()
	end
end

function PlotService:SetDefense(plot, padIndex: number, tier: number)
	self:ClearDefenseModel(plot, padIndex)
	plot.defenses[padIndex] = nil
	local pad = plot.pads[padIndex]
	local nextDef = Base.Defenses[tier + 1]
	pad.prompt.ActionText = if nextDef then (if tier == 0 then "Build " else "Upgrade: ") .. nextDef.name else "Maxed"
	pad.prompt.ObjectText = if nextDef then "💰" .. Format.Short(nextDef.price) else ""
	pad.prompt.Enabled = nextDef ~= nil
	if tier <= 0 then
		return
	end
	local def = Base.Defenses[tier]
	local pos = at(plot, pad.offset)
	local defense = {
		pad = padIndex,
		tier = tier,
		def = def,
		hp = def.hp,
		maxHp = def.hp,
		pos = pos,
		radius = def.radius,
		broken = false,
		nextFire = 0,
	}
	defense.model = self:BuildDefenseModel(plot, pad.offset, def)
	plot.defenses[padIndex] = defense
end

function PlotService:BuildDefenseModel(plot, offset: Vector3, def)
	local m = StudStyle.Model(plot.model, "Defense_" .. def.id)
	local base = offset + Vector3.new(0, 0.6, 0)
	if def.id == "HayWall" then
		for k = 0, 1 do
			StudStyle.OnGround(m, Vector3.new(7, 2.4, 3), at(plot, base + Vector3.new(0, k * 2.4, 0)), C.Hay)
		end
	elseif def.id == "SpikeWall" then
		StudStyle.OnGround(m, Vector3.new(7.5, 5, 2), at(plot, base), C.Wood)
		for k = -1, 1 do
			StudStyle.Block(m, Vector3.new(0.6, 0.6, 3.2), lcf(plot, base + Vector3.new(k * 2.4, 3, -2)) * CFrame.Angles(0.5, 0, 0), C.Stone, { shadow = false })
		end
	else
		local color = if def.id == "BlazeCannon" then C.Red else Color3.fromRGB(80, 170, 255)
		StudStyle.OnGround(m, Vector3.new(4, 2.5, 4), at(plot, base), C.DarkStone)
		StudStyle.OnGround(m, Vector3.new(3, 2.4, 3), at(plot, base + Vector3.new(0, 2.5, 0)), color)
		StudStyle.Block(m, Vector3.new(1, 1, 3.6), lcf(plot, base + Vector3.new(0, 3.7, -2.4)), C.DarkStone, { shadow = false })
		StudStyle.Neon(m, Vector3.new(0.7, 0.7, 0.3), lcf(plot, base + Vector3.new(0, 3.7, -4.3)), if def.id == "BlazeCannon" then C.Lava else C.Crystal)
	end
	return m
end

function PlotService:SetDefenseBroken(d, broken: boolean)
	d.broken = broken
	for _, p in d.model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Transparency = if broken then 0.6 else 0
			p.CanCollide = not broken
		end
	end
end

function PlotService:DamageDefense(plot, d, amount: number, attacker)
	if d.broken then
		return
	end
	d.hp -= amount
	if d.def.thorns and attacker then
		S.CombatService:Damage(nil, attacker, d.def.thorns * (1 + (plot.owner and S.DataService:Get(plot.owner).base.wave or 0) * 0.15), { fx = "Thorns", canCrit = false })
	end
	if d.hp <= 0 then
		self:SetDefenseBroken(d, true)
		S.EntityService:Event(d.pos, { EV.Beam, "DefenseBroken", d.pos.X, d.pos.Y + 2, d.pos.Z, d.pos.X, d.pos.Y + 6, d.pos.Z })
	end
end

function PlotService:RepairDefenses(plot)
	for _, d in plot.defenses do
		d.hp = d.maxHp
		if d.broken then
			self:SetDefenseBroken(d, false)
		end
	end
end

-- First intact defense a zombie walking from `from` to `to` would bump.
function PlotService:BlockingDefense(plot, from: Vector3, to: Vector3, radius: number)
	local seg = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
	local len2 = seg:Dot(seg)
	local best, bestT = nil, math.huge
	for _, d in plot.defenses do
		if not d.broken then
			local rel = Vector3.new(d.pos.X - from.X, 0, d.pos.Z - from.Z)
			local near = rel.Magnitude < d.radius + radius + 1.5
			local t = if len2 > 0 then math.clamp(rel:Dot(seg) / len2, 0, 1) else 0
			local closest = seg * t
			local off = (rel - closest).Magnitude
			if near or (d.def.block and off < d.radius + radius and t > 0 and t < 1) then
				local score = if near then -1 else t
				if score < bestT then
					best, bestT = d, score
				end
			end
		end
	end
	return best
end

-- Turrets fire at the plot's wave zombies.
function PlotService:StepDefenses(_dt: number)
	local now = os.clock()
	for _, plot in plots do
		local owner = plot.owner
		if owner and S.ZombieService:GetWave(owner) then
			for _, d in plot.defenses do
				local def = d.def
				if def.range and not d.broken and now >= d.nextFire then
					local targets = S.ZombieService:Query(d.pos, def.range, owner.UserId)
					local best, bestD = nil, math.huge
					for _, z in targets do
						local dist = (z.pos - d.pos).Magnitude
						if dist < bestD then
							best, bestD = z, dist
						end
					end
					if best then
						d.nextFire = now + 1 / def.fireRate
						local wave = S.DataService:Get(owner).base.wave
						local damage = def.damage * (1 + wave * 0.12)
						local muzzle = d.pos + Vector3.new(0, 4.5, 0)
						S.EntityService:Event(d.pos, { EV.Beam, def.id, muzzle.X, muzzle.Y, muzzle.Z, best.pos.X, best.pos.Y + 2, best.pos.Z })
						if def.splash then
							S.CombatService:Burst(nil, best.pos, def.splash, damage, if def.burn then { status = "Burn", dps = 0.4, duration = 3 } else nil, "FireBurst", owner.UserId)
						else
							S.CombatService:Damage(nil, best, damage, { fx = "Turret" })
						end
					end
				end
			end
		end
	end
end

----------------------------------------------------------------------------
-- Base lock (anti-steal)
----------------------------------------------------------------------------

function PlotService:IsLocked(plot): boolean
	return os.time() < plot.lockedUntil
end

function PlotService:Lock(player: Player)
	local plot = byPlayer[player]
	if not plot then
		return
	end
	local now = os.time()
	if now < plot.lockCooldownUntil then
		S.AnnounceService:Notify(player, ("Lock recharging: %s"):format(Format.Duration(plot.lockCooldownUntil - now)), "warn")
		return
	end
	local duration = if S.MonetizationService:IsVIP(player) then Base.Lock.durationVip else Base.Lock.duration
	plot.lockedUntil = now + duration
	plot.lockCooldownUntil = plot.lockedUntil + Base.Lock.cooldown
	plot.info:SetAttribute("LockedUntil", plot.lockedUntil)
	plot.laser.Transparency = 0.35
	S.AnnounceService:Notify(player, ("🔒 Base locked for %ds"):format(duration), "good")
	task.delay(duration, function()
		if plot.owner == player and os.time() >= plot.lockedUntil then
			plot.laser.Transparency = 1
		end
	end)
end

return PlotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">RewardsService</string>
            <string name="Source"><![CDATA[--[[
	RewardsService: retention loops.
	  * 7-day login streak (resets if you miss a day)
	  * 3 daily quests, picked deterministically per player per day
	  * free Heist Ticket regeneration (+VIP daily tickets)
	  * codes, rebirth ("Evolve Farm"), deterministic Gem shop
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Progression = require(Shared.Config.Progression)
local Monetization = require(Shared.Config.Monetization)
local Format = require(Shared.Util.Format)

local DAY = 86400

local RewardsService = { Name = "RewardsService" }

local S

local function dayNumber(t: number): number
	return math.floor(t / DAY)
end

function RewardsService:Init(services)
	S = services
end

function RewardsService:Start()
	S.DataService.PlayerLoaded:Connect(function(player)
		self:RollQuests(player)
		self:RegenTickets(player)
	end)
	Net.Event("ClaimDaily").OnServerEvent:Connect(function(player)
		self:ClaimDaily(player)
	end)
	Net.Event("ClaimQuest").OnServerEvent:Connect(function(player, index)
		if type(index) == "number" then
			self:ClaimQuest(player, index)
		end
	end)
	Net.Event("RedeemCode").OnServerEvent:Connect(function(player, code)
		if type(code) == "string" and #code <= 32 then
			self:Redeem(player, code)
		end
	end)
	Net.Event("Rebirth").OnServerEvent:Connect(function(player)
		self:Rebirth(player)
	end)
	Net.Event("GemPurchase").OnServerEvent:Connect(function(player, key)
		if type(key) == "string" then
			self:GemPurchase(player, key)
		end
	end)
end

function RewardsService:Step(dt: number)
	for _, player in Players:GetPlayers() do
		local d = S.DataService:Get(player)
		if d then
			d.stats.playtime += dt
			-- quest tracker progress lives in stats; sync it a few times a minute
			S.DataService:Replicate(player, "stats")
			self:RegenTickets(player)
			if dayNumber(os.time()) ~= d.quests.day then
				self:RollQuests(player)
			end
		end
	end
end

----------------------------------------------------------------------------
-- Grants
----------------------------------------------------------------------------

function RewardsService:Grant(player: Player, reward)
	local d = S.DataService:Get(player)
	if reward.coins then
		S.DataService:Add(player, "coins", reward.coins, true)
	end
	if reward.mutagen then
		S.DataService:Add(player, "mutagen", reward.mutagen, true)
	end
	if reward.gems then
		S.DataService:Add(player, "gems", reward.gems, true)
	end
	if reward.heistTickets then
		d.heistTickets += reward.heistTickets
		S.DataService:Replicate(player, "heistTickets")
	end
	if reward.fruit then
		if reward.fruit == "Random" then
			S.FruitService:GrantRandom(player, "reward")
		else
			S.FruitService:Grant(player, reward.fruit, "reward", true)
		end
	end
	if reward.capsule then
		local bias = if reward.capsule == "Rare" then 1 else 0
		S.MutationService:AddCapsule(player, S.MutationService:RollMutation(bias), "reward")
	end
end

----------------------------------------------------------------------------
-- Daily streak
----------------------------------------------------------------------------

function RewardsService:ClaimDaily(player: Player)
	local d = S.DataService:Get(player)
	if not d then
		return
	end
	local today = dayNumber(os.time())
	local last = dayNumber(d.daily.lastClaim)
	if d.daily.lastClaim > 0 and today == last then
		S.AnnounceService:Notify(player, "Come back tomorrow for your next reward!", "info")
		return
	end
	if d.daily.lastClaim > 0 and today - last > 1 then
		d.daily.streak = 0
	end
	d.daily.streak += 1
	d.daily.lastClaim = os.time()
	local index = (d.daily.streak - 1) % #Progression.DailyRewards + 1
	self:Grant(player, Progression.DailyRewards[index])
	S.DataService:Replicate(player, "daily")
	S.AnnounceService:Notify(player, ("🎁 Day %d reward claimed!"):format(d.daily.streak), "reward")
end

----------------------------------------------------------------------------
-- Daily quests
----------------------------------------------------------------------------

function RewardsService:RollQuests(player: Player)
	local d = S.DataService:Get(player)
	if not d then
		return
	end
	local today = dayNumber(os.time())
	if d.quests.day == today and #d.quests.list > 0 then
		return
	end
	local rng = Random.new(today * 31 + player.UserId)
	local pool = table.clone(Progression.QuestPool)
	local list = {}
	for _ = 1, 3 do
		local q = table.remove(pool, rng:NextInteger(1, #pool))
		table.insert(list, { id = q.id, stat = q.stat, goal = q.goal, text = q.text:format(q.goal), reward = q.reward, base = d.stats[q.stat] or 0 })
	end
	d.quests = { day = today, list = list, claimed = {} }
	S.DataService:Replicate(player, "quests")
end

function RewardsService:ClaimQuest(player: Player, index: number)
	local d = S.DataService:Get(player)
	local q = d and d.quests.list[index]
	if not q or d.quests.claimed[tostring(index)] then
		return
	end
	local progress = (d.stats[q.stat] or 0) - q.base
	if progress < q.goal then
		S.AnnounceService:Notify(player, ("Quest progress: %d/%d"):format(progress, q.goal), "info")
		return
	end
	d.quests.claimed[tostring(index)] = true
	self:Grant(player, q.reward)
	S.DataService:Replicate(player, "quests")
	S.AnnounceService:Notify(player, "✅ Quest complete!", "reward")
end

----------------------------------------------------------------------------
-- Heist tickets
----------------------------------------------------------------------------

function RewardsService:RegenTickets(player: Player)
	local d = S.DataService:Get(player)
	if not d then
		return
	end
	local now = os.time()
	local every = Progression.FreeTicketEvery
	local gained = math.floor((now - d.lastTicketRegen) / every)
	if gained > 0 then
		d.lastTicketRegen += gained * every
		local room = math.max(0, Progression.FreeTicketCap - d.heistTickets)
		local add = math.min(gained, room)
		if add > 0 then
			d.heistTickets += add
			S.DataService:Replicate(player, "heistTickets")
			S.AnnounceService:Notify(player, "🎟️ Free Heist Ticket ready!", "reward")
		end
	end
	if S.MonetizationService:IsVIP(player) and dayNumber(now) ~= dayNumber(d.lastVipTickets) then
		d.lastVipTickets = now
		d.heistTickets += Monetization.VipDailyTickets
		S.DataService:Replicate(player, "heistTickets")
		S.AnnounceService:Notify(player, ("👑 VIP: +%d Heist Tickets today!"):format(Monetization.VipDailyTickets), "reward")
	end
end

----------------------------------------------------------------------------
-- Codes
----------------------------------------------------------------------------

function RewardsService:Redeem(player: Player, raw: string)
	local d = S.DataService:Get(player)
	local code = raw:upper():gsub("%s", "")
	local reward = Progression.Codes[code]
	if not d or not reward then
		S.AnnounceService:Notify(player, "Invalid code.", "error")
		return
	end
	if d.codes[code] then
		S.AnnounceService:Notify(player, "Code already redeemed.", "warn")
		return
	end
	d.codes[code] = true
	self:Grant(player, reward)
	S.AnnounceService:Notify(player, ("Code %s redeemed!"):format(code), "reward")
end

----------------------------------------------------------------------------
-- Rebirth: reset coins + conveyor, keep pets/fruits, gain permanent bonus
----------------------------------------------------------------------------

function RewardsService:Rebirth(player: Player)
	local d = S.DataService:Get(player)
	if not d then
		return
	end
	local cost = Progression.RebirthCost(d.rebirths)
	if d.coins < cost then
		S.AnnounceService:Notify(player, ("Evolve Farm needs 💰%s"):format(Format.Short(cost)), "warn")
		return
	end
	d.coins = 0
	d.rebirths += 1
	S.DataService:Replicate(player, "coins")
	S.DataService:Replicate(player, "rebirths")
	S.ConveyorService:ResetForRebirth(player)
	S.PetService:RefreshEquipSlots(player)
	S.AnnounceService:Announce(("🧬 %s EVOLVED their farm! (Rebirth %d)"):format(player.DisplayName, d.rebirths), "reward")
end

----------------------------------------------------------------------------
-- Gem shop (deterministic items only)
----------------------------------------------------------------------------

function RewardsService:GemPurchase(player: Player, key: string)
	local item = Monetization.GemShop[key]
	local d = S.DataService:Get(player)
	if not item or not d then
		return
	end
	if key == "ExtraVaultSlot" and d.extraVault >= item.max then
		S.AnnounceService:Notify(player, "Vault is at max size.", "warn")
		return
	end
	if not S.DataService:Spend(player, "gems", item.gems) then
		S.AnnounceService:Notify(player, ("Need %d 💎"):format(item.gems), "warn")
		Net.Event("OpenPanel"):FireClient(player, "Shop", "Gems")
		return
	end
	if key == "SkipIncubation" then
		if not S.EggHeistService:SkipIncubation(player) then
			S.DataService:Add(player, "gems", item.gems, true)
			S.AnnounceService:Notify(player, "No eggs are incubating.", "info")
			return
		end
	elseif key == "RepairCore" then
		local plot = S.PlotService:GetPlot(player)
		if plot then
			S.PlotService:SetCoreHp(plot, plot.coreMax)
		end
	elseif key == "ExtraVaultSlot" then
		d.extraVault += 1
		S.MutationService:RefreshVault(player)
	end
	S.AnnounceService:Notify(player, item.name .. " ✔", "good")
end

return RewardsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[--[[
	WorldBuilder: builds The Long Valley from studded blocks at server start.

	Layout (walking away from spawn along +Z):
	  Barnyard Plaza (hub)  eggs, Fruit Dealer, Brainrot Belt, rebirth
	  Farm Row              8 player bases (PlotService)
	  Meadow Fields         camps, Hay Tower parkour, Chicken Coop heist
	  Whispering Woods  10  pine forest, Treetop Trail, Hollow Stump dungeon
	  Crystal Canyon    25  narrow canyon, Crystal Spire parkour
	  Volcano Ridge     40  lava, the volcano rim secret
	  Dragon's Nest     50  the Dragon Egg heist

	Performance budget: ~4-5k parts total, all Plastic/SmoothPlastic/Neon,
	flat rows merged into single parts, props without shadows, and
	StreamingEnabled so phones only load what is near them.
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local World = require(Shared.Config.World)
local Eggs = require(Shared.Config.Eggs)
local Fruits = require(Shared.Config.Fruits)
local Pets = require(Shared.Config.Pets)
local StudStyle = require(Shared.Art.StudStyle)
local Props = require(Shared.Art.Props)
local BlockyBuilder = require(Shared.Art.BlockyBuilder)
local Format = require(Shared.Util.Format)

local C = StudStyle.Colors
local T = World.Tile

local WorldBuilder = { Name = "WorldBuilder" }

local S
local rng = Random.new(World.Seed)
local worldFolder: Folder

function WorldBuilder:Init(services)
	S = services
end

function WorldBuilder:Start()
	worldFolder = Instance.new("Folder")
	worldFolder.Name = "World"
	worldFolder.Parent = workspace
	if not workspace:FindFirstChild("Plots") then
		local plots = Instance.new("Folder")
		plots.Name = "Plots"
		plots.Parent = workspace
	end

	self:Atmosphere()
	self:Ground()
	self:Road()
	self:Hub()
	self:ZoneGates()
	self:Decorate()
	self:Landmarks()
	self:HeistStructures()
	self:Dungeon()
	self:FruitSpawns()
end

----------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------

local function folder(name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = worldFolder
	return f
end

local function ground(x: number, z: number): Vector3
	return Vector3.new(x, World.GroundHeight(x, z), z)
end

local function fruitAnchor(parent: Instance, pos: Vector3, hidden: boolean)
	local a = Instance.new("Part")
	a.Name = "FruitSpawn"
	a.Anchored = true
	a.CanCollide = false
	a.CanQuery = false
	a.CanTouch = false
	a.Transparency = 1
	a.Size = Vector3.new(1, 1, 1)
	a.Position = pos + Vector3.new(0, 0.5, 0)
	a:SetAttribute("Hidden", hidden)
	a.Parent = parent
	CollectionService:AddTag(a, "FruitSpawn")
end

-- Turns a BlockyBuilder rig into static parts (statues, mascots).
function WorldBuilder:Statue(parent: Instance, body, cf: CFrame, opts, tint: Color3?): Model
	local rig = BlockyBuilder.Build(body, opts)
	local model = StudStyle.Model(parent, "Statue")
	for _, spec in rig.parts do
		local color = if tint and spec.role ~= "eye" then spec.color:Lerp(tint, 0.75) else spec.color
		StudStyle.Block(model, spec.size, cf * rig.groups[spec.group] * spec.localCF, color, {
			material = if spec.material == Enum.Material.Neon then Enum.Material.Neon else Enum.Material.SmoothPlastic,
			studs = false,
			shadow = true,
		})
	end
	return model
end

local function prompt(parent: Instance, action: string, object: string, tag: string?, distance: number?): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = 0.2
	p.MaxActivationDistance = distance or 12
	p.RequiresLineOfSight = false
	p.Parent = parent
	if tag then
		CollectionService:AddTag(p, tag)
	end
	return p
end

----------------------------------------------------------------------------
-- Sky
----------------------------------------------------------------------------

function WorldBuilder:Atmosphere()
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.28
	atmosphere.Offset = 0.1
	atmosphere.Color = Color3.fromRGB(200, 225, 255)
	atmosphere.Decay = Color3.fromRGB(120, 150, 200)
	atmosphere.Glare = 0.2
	atmosphere.Haze = 1.4
	atmosphere.Parent = Lighting
	local sky = Instance.new("Sky")
	sky.CelestialBodiesShown = true
	sky.Parent = Lighting
end

----------------------------------------------------------------------------
-- Ground + cliffs
----------------------------------------------------------------------------

function WorldBuilder:Ground()
	local groundFolder = folder("Ground")
	local cliffFolder = folder("Cliffs")
	local iz0 = math.floor(World.StartZ / T)
	local iz1 = math.floor(World.Length / T)
	for iz = iz0, iz1 do
		local zc = (iz + 0.5) * T
		local zone = World.ZoneAt(zc)
		local pal = zone.palette
		local rowColor = if iz % 2 == 0 then pal.ground else pal.groundAlt
		local cx = World.CenterX(zc)
		local hw = World.HalfWidth(zc)
		local ixStart = math.floor((cx - hw) / T) - 2
		local ixEnd = math.floor((cx + hw) / T) + 2

		-- Floor: merge runs of equal height into one part.
		local runStart, runHeight = nil, nil
		local function flush(ixEndExclusive: number)
			if runStart then
				local x0 = runStart * T
				local x1 = ixEndExclusive * T
				local top = runHeight
				local bottom = -12
				StudStyle.Block(groundFolder, Vector3.new(x1 - x0, top - bottom, T), CFrame.new((x0 + x1) / 2, (top + bottom) / 2, zc), rowColor, { shadow = false })
			end
			runStart = nil
		end
		for ix = ixStart, ixEnd do
			local tx = (ix + 0.5) * T
			local d = math.abs(tx - cx)
			if d <= hw then
				local h = World.GroundHeight(tx, zc)
				if runStart and h ~= runHeight then
					flush(ix)
				end
				if not runStart then
					runStart, runHeight = ix, h
				end
			else
				flush(ix)
				-- Cliff column: inner step + taller outer wall, grassy tops.
				local h = World.CliffHeight(ix, iz)
				local outer = (ix < ixStart + 2) or (ix > ixEnd - 2)
				if outer then
					h += 14
				end
				StudStyle.Block(cliffFolder, Vector3.new(T, h + 12, T), CFrame.new(tx, (h - 12) / 2, zc), pal.cliff)
				StudStyle.Block(cliffFolder, Vector3.new(T, 2, T), CFrame.new(tx, h + 1, zc), pal.cliffTop, { shadow = false })
			end
		end
		flush(ixEnd + 1)
	end

	-- End caps so nobody walks off the ends of the valley.
	for _, z in { World.StartZ - T / 2, World.Length + T / 2 } do
		local zone = World.ZoneAt(z)
		local cx = World.CenterX(z)
		StudStyle.Block(cliffFolder, Vector3.new(World.HalfWidth(z) * 2 + T * 4, 110, T), CFrame.new(cx, 43, z), zone.palette.cliff)
	end
end

-- The Long Valley Road: a dirt path down the centre so players on phones
-- always know which way is "further".
function WorldBuilder:Road()
	local road = folder("Road")
	local step = T / 2
	for z = World.StartZ + step / 2, World.Length - step / 2, step do
		local x = World.CenterX(z)
		local h = World.GroundHeight(x, z)
		StudStyle.Block(road, Vector3.new(14, 0.4, step + 0.2), CFrame.new(x, h + 0.2, z) * CFrame.Angles(0, math.atan(math.cos((z - 880) / 260) * 80 / 260 * math.clamp((z - 880) / 300, 0, 1)), 0), C.Path, { shadow = false })
	end
end

----------------------------------------------------------------------------
-- Barnyard Plaza (hub)
----------------------------------------------------------------------------

function WorldBuilder:Hub()
	local hub = folder("Hub")

	-- Plaza floor
	StudStyle.Block(hub, Vector3.new(170, 0.2, 230), CFrame.new(0, 0.1, 140), Color3.fromRGB(220, 200, 150), { shadow = false })

	-- Welcome arch
	for _, sx in { -1, 1 } do
		StudStyle.OnGround(hub, Vector3.new(6, 26, 6), Vector3.new(sx * 30, 0, 18), C.Wood)
	end
	local beam = StudStyle.Block(hub, Vector3.new(68, 8, 4), CFrame.new(0, 28, 18), C.Red)
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.PixelsPerStud = 20
		gui.LightInfluence = 0
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(255, 230, 90)
		label.Text = "GROW YOUR PETS\nANIMAL FARM"
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 4
		stroke.Color = Color3.fromRGB(60, 20, 20)
		stroke.Parent = label
		label.Parent = gui
		gui.Parent = beam
	end

	-- Fountain with a golden Griffin
	local fountain = StudStyle.Model(hub, "Fountain")
	StudStyle.OnGround(fountain, Vector3.new(30, 2, 30), Vector3.new(0, 0, 100), C.Stone)
	StudStyle.OnGround(fountain, Vector3.new(26, 0.6, 26), Vector3.new(0, 2, 100), C.Water, { material = Enum.Material.SmoothPlastic, studs = false })
	StudStyle.OnGround(fountain, Vector3.new(8, 8, 8), Vector3.new(0, 2, 100), C.Stone)
	self:Statue(fountain, Pets.Species.Griffin.body, CFrame.new(0, 10, 100) * CFrame.Angles(0, math.pi, 0), { scale = 2.2 }, C.Gold)

	-- Mascot: giant Farm Pup by the arch
	self:Statue(hub, Pets.Species.Pup.body, CFrame.new(-48, 0.4, 40) * CFrame.Angles(0, math.pi * 0.85, 0), { scale = 3.2 })

	-- Spawn
	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.Position = World.HubSpawn + Vector3.new(0, 0.5, 0)
	spawn.Color = Color3.fromRGB(90, 200, 90)
	spawn.Material = Enum.Material.Plastic
	spawn.TopSurface = Enum.SurfaceType.Studs
	spawn.Duration = 3
	spawn.Neutral = true
	spawn.Parent = hub

	-- Egg stands (prompt opens the egg panel with odds on the client)
	for eggId, pos in World.EggStands do
		local egg = Eggs.List[eggId]
		local stand = StudStyle.OnGround(hub, Vector3.new(9, 3, 9), pos, Color3.fromRGB(250, 240, 210), { name = eggId .. "_Stand" })
		StudStyle.OnGround(hub, Vector3.new(10, 0.6, 10), pos, egg.spotColor, { shadow = false })
		Props.Egg(hub, CFrame.new(pos + Vector3.new(0, 3, 0)), egg, 1.9)
		local label = if egg.levelReq then ("%s\n💰%s · Lv%d"):format(egg.displayName, Format.Short(egg.price), egg.levelReq) else ("%s\n💰%s"):format(egg.displayName, Format.Short(egg.price))
		StudStyle.Label(stand, label, Color3.new(1, 1, 1), 90, 1.2).StudsOffsetWorldSpace = Vector3.new(0, 9, 0)
		local p = prompt(stand, "Hatch", egg.displayName, "EggPrompt", 14)
		p:SetAttribute("EggId", eggId)
	end

	-- Fruit Dealer stall
	local dealer = StudStyle.Model(hub, "FruitDealer")
	local dp = World.FruitDealer
	local counter = StudStyle.OnGround(dealer, Vector3.new(16, 4, 5), dp, C.Wood)
	for _, sx in { -1, 1 } do
		StudStyle.OnGround(dealer, Vector3.new(1, 11, 1), dp + Vector3.new(sx * 8, 0, -4), C.DarkWood)
		StudStyle.OnGround(dealer, Vector3.new(1, 11, 1), dp + Vector3.new(sx * 8, 0, 3), C.DarkWood)
	end
	for k = 0, 5 do
		StudStyle.Block(dealer, Vector3.new(2.8, 0.6, 9), CFrame.new(dp + Vector3.new(-7 + k * 2.8, 11.3, -0.5)), if k % 2 == 0 then C.Red else C.White, { shadow = false })
	end
	for i, fruitId in Fruits.Order do
		Props.Fruit(dealer, CFrame.new(dp + Vector3.new(-6 + (i - 1) * 3, 5.2, 0)), Fruits.List[fruitId], 0.9)
	end
	StudStyle.Label(counter, "🍉 FRUIT DEALER", Color3.fromRGB(255, 200, 120), 90, 1).StudsOffsetWorldSpace = Vector3.new(0, 10, 0)
	prompt(counter, "Browse", "Fruit Dealer", "DealerPrompt")

	-- Rebirth statue
	local rp = World.RebirthStatue
	local pedestal = StudStyle.OnGround(hub, Vector3.new(10, 4, 10), rp, C.Gold)
	for k = 0, 7 do
		local a = k * 0.8
		StudStyle.Neon(hub, Vector3.new(1.2, 1.2, 1.2), CFrame.new(rp + Vector3.new(math.cos(a) * 2.5, 5 + k * 1.3, math.sin(a) * 2.5)), if k % 2 == 0 then Color3.fromRGB(120, 255, 200) else Color3.fromRGB(255, 120, 220))
	end
	StudStyle.Label(pedestal, "🧬 EVOLVE FARM (Rebirth)", Color3.fromRGB(150, 255, 220), 90, 1).StudsOffsetWorldSpace = Vector3.new(0, 16, 0)
	prompt(pedestal, "Evolve", "Rebirth", "RebirthPrompt")

	-- Mutation Lab kiosk
	local lab = StudStyle.OnGround(hub, Vector3.new(10, 8, 8), Vector3.new(118, 0, 60), Color3.fromRGB(150, 70, 220))
	StudStyle.Neon(hub, Vector3.new(6, 3, 0.4), CFrame.new(118, 5, 55.8), Color3.fromRGB(120, 255, 180))
	StudStyle.Label(lab, "🧪 MUTATION LAB", Color3.fromRGB(210, 160, 255), 90, 1)
	prompt(lab, "Open", "Mutation Lab", "LabPrompt")

	-- Brainrot Belt
	local belt = StudStyle.Model(hub, "BrainrotBelt")
	local from, to = World.BrainrotBelt.from, World.BrainrotBelt.to
	local mid = (from + to) / 2
	local len = (to - from).Magnitude
	StudStyle.Block(belt, Vector3.new(len, 1.6, 6), CFrame.new(mid + Vector3.new(0, 0.8, 0)), C.Belt, { studs = false, material = Enum.Material.SmoothPlastic })
	for _, sz in { -1, 1 } do
		StudStyle.Block(belt, Vector3.new(len, 2.4, 0.6), CFrame.new(mid + Vector3.new(0, 1.2, sz * 3.3)), Color3.fromRGB(250, 200, 40), { studs = false, material = Enum.Material.SmoothPlastic })
	end
	local machine = StudStyle.OnGround(belt, Vector3.new(10, 12, 10), from + Vector3.new(-6, 0, 0), Color3.fromRGB(150, 70, 220))
	StudStyle.Neon(belt, Vector3.new(5, 4, 5), CFrame.new(from + Vector3.new(-6, 14, 0)), Color3.fromRGB(255, 120, 220))
	StudStyle.Label(machine, "🧠 BRAINROT BELT\nBuy capsules as they roll by!", Color3.fromRGB(255, 170, 240), 120, 1.3).StudsOffsetWorldSpace = Vector3.new(0, 14, 0)
	StudStyle.OnGround(belt, Vector3.new(8, 6, 8), to + Vector3.new(6, 0, 0), C.DarkStone)

	-- Lamps and hay bales
	for k = -3, 3 do
		for _, sx in { -1, 1 } do
			local p = Vector3.new(sx * 80, 0, 140 + k * 30)
			StudStyle.OnGround(hub, Vector3.new(1, 9, 1), p, C.DarkStone, { shadow = false })
			StudStyle.Neon(hub, Vector3.new(1.8, 1.8, 1.8), CFrame.new(p + Vector3.new(0, 9.9, 0)), Color3.fromRGB(255, 230, 150))
		end
	end
	for _ = 1, 8 do
		local p = Vector3.new(rng:NextNumber(-150, 150), 0, rng:NextNumber(20, 270))
		if math.abs(p.X) > 90 then
			StudStyle.OnGround(hub, Vector3.new(4, 3, 3), p, C.Hay, nil, rng:NextNumber(0, 3))
		end
	end
end

----------------------------------------------------------------------------
-- Zone gates
----------------------------------------------------------------------------

function WorldBuilder:ZoneGates()
	local gates = folder("ZoneGates")
	for _, zone in World.Zones do
		if zone.levelReq > 1 then
			local z = zone.zStart
			local cx = World.CenterX(z)
			local hw = World.HalfWidth(z)
			local barrier = StudStyle.Block(gates, Vector3.new(hw * 2 + 8, 60, 2), CFrame.new(cx, 30, z), zone.palette.accent, {
				material = Enum.Material.Neon,
				studs = false,
				shadow = false,
				name = "ZoneGate",
			})
			barrier.Transparency = 0.75
			barrier:SetAttribute("LevelReq", zone.levelReq)
			barrier:SetAttribute("ZoneName", zone.name)
			CollectionService:AddTag(barrier, "ZoneGate")
			for _, sx in { -1, 1 } do
				StudStyle.OnGround(gates, Vector3.new(8, 34, 8), Vector3.new(cx + sx * 20, 0, z), zone.palette.cliff)
			end
			local sign = StudStyle.Block(gates, Vector3.new(48, 9, 3), CFrame.new(cx, 38, z), zone.palette.cliffTop)
			StudStyle.Label(sign, ("%s\n🔒 Lv %d"):format(zone.name, zone.levelReq), Color3.new(1, 1, 1), 250, 2).StudsOffsetWorldSpace = Vector3.new(0, 0, -3)
		end
	end
end

----------------------------------------------------------------------------
-- Trees, rocks, flowers
----------------------------------------------------------------------------

local function blockedForDecor(x: number, z: number): boolean
	if z < 830 then
		return true -- hub + Farm Row stay clean
	end
	if math.abs(x - World.CenterX(z)) < 22 then
		return true -- road
	end
	if not World.IsInsideValley(x, z, 18) then
		return true
	end
	for _, heist in World.Heists do
		local c = World.Resolve(heist.center)
		if (Vector3.new(x, 0, z) - Vector3.new(c.X, 0, c.Z)).Magnitude < 85 then
			return true
		end
	end
	for _, zone in World.Zones do
		if math.abs(z - zone.zStart) < 30 then
			return true
		end
	end
	return false
end

function WorldBuilder:Tree(parent: Instance, pos: Vector3, style: string, zone)
	local s = rng:NextNumber(0.8, 1.4)
	if style == "Round" then
		StudStyle.OnGround(parent, Vector3.new(1.6, 6, 1.6) * s, pos, C.Wood, { shadow = false })
		StudStyle.OnGround(parent, Vector3.new(7, 5, 7) * s, pos + Vector3.new(0, 5.5 * s, 0), C.Leaf)
		StudStyle.OnGround(parent, Vector3.new(4.6, 2.4, 4.6) * s, pos + Vector3.new(0, 10.5 * s, 0), Color3.fromRGB(90, 190, 90), { shadow = false })
	elseif style == "Pine" then
		StudStyle.OnGround(parent, Vector3.new(1.4, 5, 1.4) * s, pos, C.DarkWood, { shadow = false })
		for k, w in { 8, 6, 3.6 } do
			StudStyle.OnGround(parent, Vector3.new(w, 3.2, w) * s, pos + Vector3.new(0, (3 + (k - 1) * 3) * s, 0), C.DarkLeaf, { shadow = k == 1 })
		end
	elseif style == "Crystal" then
		for k = 1, 3 do
			local h = rng:NextNumber(5, 12) * s
			local off = Vector3.new(rng:NextNumber(-2, 2), 0, rng:NextNumber(-2, 2))
			StudStyle.Block(parent, Vector3.new(2, h, 2), CFrame.new(pos + off + Vector3.new(0, h / 2, 0)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), 0, rng:NextNumber(-0.3, 0.3)), if k == 1 then C.Crystal else zone.palette.accent, {
				material = if k == 1 then Enum.Material.Neon else Enum.Material.SmoothPlastic,
				studs = false,
				shadow = false,
			})
		end
	elseif style == "Dead" then
		StudStyle.OnGround(parent, Vector3.new(1.4, 9, 1.4) * s, pos, Color3.fromRGB(60, 50, 46), { shadow = false })
		for _, sx in { -1, 1 } do
			StudStyle.Block(parent, Vector3.new(4, 0.8, 0.8) * s, CFrame.new(pos + Vector3.new(sx * 1.6 * s, 6.5 * s, 0)) * CFrame.Angles(0, 0, sx * 0.5), Color3.fromRGB(60, 50, 46), { shadow = false })
		end
	end
end

function WorldBuilder:Decorate()
	local decor = folder("Decor")
	for _, zone in World.Zones do
		local placed = 0
		local attempts = 0
		while placed < zone.trees and attempts < zone.trees * 6 do
			attempts += 1
			local z = rng:NextNumber(zone.zStart, zone.zEnd)
			local hw = World.HalfWidth(z)
			local x = World.CenterX(z) + rng:NextNumber(-hw, hw)
			if not blockedForDecor(x, z) then
				placed += 1
				local style = zone.treeStyle or "Round"
				self:Tree(decor, ground(x, z), style, zone)
			end
		end
		-- Rocks + flowers
		for _ = 1, math.floor((zone.zEnd - zone.zStart) / 40) do
			local z = rng:NextNumber(zone.zStart, zone.zEnd)
			local hw = World.HalfWidth(z)
			local x = World.CenterX(z) + rng:NextNumber(-hw, hw)
			if not blockedForDecor(x, z) then
				local size = Vector3.new(rng:NextNumber(3, 7), rng:NextNumber(2, 5), rng:NextNumber(3, 7))
				StudStyle.OnGround(decor, size, ground(x, z), zone.palette.cliff, { shadow = false }, rng:NextNumber(0, 3))
			end
		end
		if zone.id == "Meadow" then
			for _ = 1, 60 do
				local z = rng:NextNumber(zone.zStart, zone.zEnd)
				local hw = World.HalfWidth(z)
				local x = World.CenterX(z) + rng:NextNumber(-hw, hw)
				if not blockedForDecor(x, z) then
					local colors = { Color3.fromRGB(255, 90, 120), Color3.fromRGB(255, 230, 80), Color3.fromRGB(180, 120, 255), Color3.new(1, 1, 1) }
					StudStyle.OnGround(decor, Vector3.new(0.8, 0.8, 0.8), ground(x, z), colors[rng:NextInteger(1, #colors)], { collide = false, shadow = false, studs = false, material = Enum.Material.SmoothPlastic })
				end
			end
		end
	end
end

----------------------------------------------------------------------------
-- Landmarks + parkour (hidden fruit spots on top)
----------------------------------------------------------------------------

function WorldBuilder:Landmarks()
	local marks = folder("Landmarks")

	-- Farm Row windmill
	local wm = Vector3.new(0, 0, 820)
	StudStyle.OnGround(marks, Vector3.new(10, 26, 10), wm + Vector3.new(60, 0, 0), C.White)
	StudStyle.Block(marks, Vector3.new(12, 3, 12), CFrame.new(wm + Vector3.new(60, 27.5, 0)), C.Red)
	for k = 0, 3 do
		StudStyle.Block(marks, Vector3.new(2, 18, 0.6), CFrame.new(wm + Vector3.new(60, 22, -5.4)) * CFrame.Angles(0, 0, k * math.pi / 2) * CFrame.new(0, 9, 0), C.Wood, { shadow = false })
	end

	-- Meadow: Hay Tower parkour (spiral)
	do
		local base = World.Resolve(Vector3.new(-120, 0, 1010))
		for k = 0, 15 do
			local a = k * 0.75
			local p = base + Vector3.new(math.cos(a) * 11, k * 4.5, math.sin(a) * 11)
			StudStyle.Block(marks, Vector3.new(6, 2, 6), CFrame.new(p + Vector3.new(0, 1, 0)), C.Hay)
		end
		local topY = base.Y + 16 * 4.5
		StudStyle.Block(marks, Vector3.new(10, 2, 10), CFrame.new(base + Vector3.new(0, topY - base.Y + 1, 0)), C.Red)
		StudStyle.OnGround(marks, Vector3.new(4, topY - base.Y, 4), base, C.Wood)
		fruitAnchor(marks, base + Vector3.new(0, topY - base.Y + 2, 0), true)
		-- ponds
		for k = 1, 3 do
			local pp = World.Resolve(Vector3.new(rng:NextNumber(-150, 150), 0, 880 + k * 120))
			if not blockedForDecor(pp.X, pp.Z) then
				StudStyle.Block(marks, Vector3.new(24, 0.3, 16), CFrame.new(pp + Vector3.new(0, 0.2, 0)), C.Water, { material = Enum.Material.SmoothPlastic, studs = false, collide = false })
			end
		end
	end

	-- Woods: Treetop Trail (floating platforms between giant pines)
	do
		local start = World.Resolve(Vector3.new(110, 0, 1420))
		for k = 0, 9 do
			local p = start + Vector3.new(math.sin(k) * 14, 6 + k * 3.2, k * 13)
			StudStyle.Block(marks, Vector3.new(7, 1.4, 7), CFrame.new(p), C.Wood)
			if k % 3 == 0 then
				StudStyle.OnGround(marks, Vector3.new(2, p.Y - start.Y, 2), Vector3.new(p.X, start.Y, p.Z + 4), C.DarkWood, { shadow = false })
			end
		end
		fruitAnchor(marks, start + Vector3.new(math.sin(9) * 14, 6 + 9 * 3.2 + 0.7, 9 * 13), true)
	end

	-- Canyon: Crystal Spire (neon stepping stones)
	do
		local base = World.Resolve(Vector3.new(-70, 0, 2150))
		for k = 0, 13 do
			local a = k * 1.1
			local p = base + Vector3.new(math.cos(a) * 9, 4 + k * 4, math.sin(a) * 9)
			StudStyle.Block(marks, Vector3.new(4.5, 1.2, 4.5), CFrame.new(p) * CFrame.Angles(0, a, 0), C.Crystal, { material = Enum.Material.Neon, studs = false })
		end
		StudStyle.OnGround(marks, Vector3.new(6, 60, 6), base, Color3.fromRGB(150, 90, 200))
		fruitAnchor(marks, base + Vector3.new(0, 61, 0), true)
	end

	-- Volcano Ridge: the volcano (stepped cone) with a lava crater secret
	do
		local base = World.Resolve(Vector3.new(90, 0, 2650))
		for k = 0, 6 do
			local w = 70 - k * 9
			StudStyle.Block(marks, Vector3.new(w, 6, w), CFrame.new(base + Vector3.new(0, 3 + k * 6, 0)), if k % 2 == 0 then Color3.fromRGB(70, 60, 62) else Color3.fromRGB(86, 70, 70))
		end
		StudStyle.Block(marks, Vector3.new(10, 1, 10), CFrame.new(base + Vector3.new(0, 42.6, 0)), C.Lava, { material = Enum.Material.Neon, studs = false })
		fruitAnchor(marks, base + Vector3.new(12, 42, 0), true)
		for k = 1, 5 do
			local lp = World.Resolve(Vector3.new(rng:NextNumber(-120, 120), 0, 2450 + k * 85))
			if not blockedForDecor(lp.X, lp.Z) then
				StudStyle.Block(marks, Vector3.new(rng:NextNumber(10, 22), 0.3, rng:NextNumber(8, 16)), CFrame.new(lp + Vector3.new(0, 0.2, 0)), C.Lava, { material = Enum.Material.Neon, studs = false, collide = false })
			end
		end
	end
end

----------------------------------------------------------------------------
-- Heist structures (interactive parts come from EggHeistService)
----------------------------------------------------------------------------

function WorldBuilder:HeistStructures()
	local heists = folder("HeistSites")

	-- Chicken Coop
	do
		local c = World.Resolve(World.Heists.ChickenCoop.center)
		local coop = c + Vector3.new(0, 0, 36)
		StudStyle.OnGround(heists, Vector3.new(26, 10, 14), coop, C.Red)
		for _, sx in { -1, 1 } do
			StudStyle.Block(heists, Vector3.new(15, 1, 16), CFrame.new(coop + Vector3.new(sx * 6.5, 12.5, 0)) * CFrame.Angles(0, 0, sx * -0.5), C.White)
		end
		for k = 0, 23 do
			local a = k / 24 * math.pi * 2
			if not (a > math.pi * 1.35 and a < math.pi * 1.65) then -- gap facing the valley start
				StudStyle.OnGround(heists, Vector3.new(1, 4, 1), c + Vector3.new(math.cos(a) * 46, 0, math.sin(a) * 46), C.White, { shadow = false })
				StudStyle.Block(heists, Vector3.new(12.2, 0.6, 0.6), CFrame.new(c + Vector3.new(math.cos(a + 0.13) * 46, 3, math.sin(a + 0.13) * 46)) * CFrame.Angles(0, -a - 0.13 - math.pi / 2, 0), C.White, { shadow = false })
			end
		end
		for _ = 1, 6 do
			StudStyle.OnGround(heists, Vector3.new(4, 3, 3), c + Vector3.new(rng:NextNumber(-35, 35), 0, rng:NextNumber(-20, 20)), C.Hay, { shadow = false }, rng:NextNumber(0, 3))
			end
	end

	-- Dragon's Nest
	do
		local c = World.Resolve(World.Heists.DragonNest.center)
		for k = 0, 17 do
			local a = k / 18 * math.pi * 2
			if not (a > math.pi * 1.4 and a < math.pi * 1.6) then
				local h = rng:NextNumber(14, 30)
				StudStyle.Block(heists, Vector3.new(7, h, 7), CFrame.new(c + Vector3.new(math.cos(a) * 60, h / 2, math.sin(a) * 60)) * CFrame.Angles(rng:NextNumber(-0.2, 0.2), a, rng:NextNumber(-0.2, 0.2)), Color3.fromRGB(40, 26, 50))
			end
		end
		local nest = c + Vector3.new(0, 0, 22)
		for k = 0, 11 do
			local a = k / 12 * math.pi * 2
			StudStyle.Block(heists, Vector3.new(7, 3, 3), CFrame.new(nest + Vector3.new(math.cos(a) * 9, 1.5, math.sin(a) * 9)) * CFrame.Angles(0, -a, 0.2), Color3.fromRGB(120, 80, 50), { shadow = false })
		end
		for _ = 1, 5 do
			StudStyle.Block(heists, Vector3.new(rng:NextNumber(10, 18), 0.3, rng:NextNumber(8, 14)), CFrame.new(c + Vector3.new(rng:NextNumber(-45, 45), 0.2, rng:NextNumber(-40, 0))), C.Lava, { material = Enum.Material.Neon, studs = false, collide = false })
			StudStyle.OnGround(heists, Vector3.new(3, 1.5, 3), c + Vector3.new(rng:NextNumber(-40, 40), 0, rng:NextNumber(10, 45)), C.Gold, { shadow = false })
			end
	end
end

----------------------------------------------------------------------------
-- The Hollow Stump dungeon (entrance in the Woods, arena far below)
----------------------------------------------------------------------------

function WorldBuilder:Dungeon()
	local dun = folder("Dungeon")
	local def = World.Dungeon
	local entrance = World.Resolve(def.entrance)
	local stump = StudStyle.Block(dun, Vector3.new(10, 18, 18), CFrame.new(entrance + Vector3.new(0, 5, 0)) * CFrame.Angles(0, 0, math.pi / 2), C.Wood, {
		shape = Enum.PartType.Cylinder,
		studs = false,
		material = Enum.Material.SmoothPlastic,
	})
	StudStyle.Block(dun, Vector3.new(0.6, 12, 12), CFrame.new(entrance + Vector3.new(0, 10.2, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(20, 14, 10), {
		shape = Enum.PartType.Cylinder,
		studs = false,
		material = Enum.Material.SmoothPlastic,
		collide = false,
	})
	StudStyle.Label(stump, "🪵 THE HOLLOW STUMP\nSecret dungeon", Color3.fromRGB(255, 200, 120), 120, 1.2).StudsOffsetWorldSpace = Vector3.new(0, 12, 0)
	prompt(stump, "Enter", "The Hollow", nil, 16).Triggered:Connect(function(player)
		S.ZombieService:StartDungeon(player)
	end)

	local center = Vector3.new(World.CenterX(def.arena.Z) + def.arena.X, def.arena.Y, def.arena.Z)
	StudStyle.Block(dun, Vector3.new(120, 4, 120), CFrame.new(center - Vector3.new(0, 2, 0)), Color3.fromRGB(70, 56, 44))
	for _, side in { Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1) } do
		local size = if side.X ~= 0 then Vector3.new(4, 26, 124) else Vector3.new(124, 26, 4)
		StudStyle.Block(dun, size, CFrame.new(center + side * 62 + Vector3.new(0, 13, 0)), Color3.fromRGB(50, 40, 34))
		StudStyle.Neon(dun, Vector3.new(1.5, 2.5, 1.5), CFrame.new(center + side * 58 + Vector3.new(0, 8, 0)), Color3.fromRGB(255, 150, 40))
	end
	StudStyle.Block(dun, Vector3.new(124, 2, 124), CFrame.new(center + Vector3.new(0, 27, 0)), Color3.fromRGB(40, 32, 28), { shadow = false })
	for _ = 1, 6 do
		StudStyle.OnGround(dun, Vector3.new(3, 10, 3), center + Vector3.new(rng:NextNumber(-45, 45), 0, rng:NextNumber(-45, 45)), Color3.fromRGB(96, 70, 50))
	end
end

----------------------------------------------------------------------------
-- Fruit spawn anchors (open ground + hidden spots added by Landmarks)
----------------------------------------------------------------------------

function WorldBuilder:FruitSpawns()
	local spawns = folder("FruitSpawns")
	for _, zone in World.Zones do
		if zone.id ~= "Hub" then
			local count = if zone.id == "FarmRow" then 2 else 5
			local made = 0
			local tries = 0
			while made < count and tries < 60 do
				tries += 1
				local z = rng:NextNumber(zone.zStart + 30, zone.zEnd - 30)
				if zone.id == "FarmRow" then
					-- between the road and the bases, never inside a plot
					local side = if rng:NextNumber() < 0.5 then -1 else 1
					fruitAnchor(spawns, ground(World.CenterX(z) + side * rng:NextNumber(28, 80), z), false)
					made += 1
				else
					local hw = World.HalfWidth(z) - 30
					local x = World.CenterX(z) + rng:NextNumber(-hw, hw)
					if not blockedForDecor(x, z) then
						fruitAnchor(spawns, ground(x, z), false)
						made += 1
					end
				end
			end
		end
	end
end

return WorldBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">ZombieService</string>
            <string name="Source"><![CDATA[--[[
	ZombieService: zombie simulation, spatial queries and encounters.

	Encounters own groups of zombies:
	  Wave     Build & Kill base defense. Zombies pour out of the plot's
	           Graveyard Rift and march on the Barn Heart; walls block,
	           turrets shoot, the Animal Army intercepts.
	  Camp     Zombie camps along the Long Valley (grind spots). Only
	           simulated while a player is near; a zone boss rises every
	           10 minutes and is announced to the whole server.
	  Dungeon  The Hollow Stump: an instanced arena under the Woods.
	  Heist    Guardians spawned by EggHeistService.

	Spatial hash (24-stud cells) is rebuilt every tick; Query() is what the
	Pet AI, abilities and turrets use to find zombies.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Zombies = require(Shared.Config.Zombies)
local World = require(Shared.Config.World)
local Protocol = require(Shared.Util.EntityProtocol)

local State = Protocol.State
local EV = Protocol.Event

local CELL = 24
local CAMP_RANGE = 320
local CAMP_SLEEP = 30
local CAMP_RESPAWN = 15
local ZONE_BOSS_EVERY = 600
local REMOVE_DELAY = 0.3

local ZONE_BOSSES = {
	Meadow = { type = "FarmerZed", level = 8 },
	Woods = { type = "FarmerZed", level = 22 },
	Canyon = { type = "BrainrotTitan", level = 36 },
	Volcano = { type = "BrainrotTitan", level = 56 },
}

local ZombieService = { Name = "ZombieService" }

local S
local grid: { [number]: { any } } = {}
local waves: { [Player]: any } = {}
local camps: { any } = {}
local dungeons: { [Player]: any } = {}
local extraEncounters: { any } = {}
local dying: { any } = {}
local lastCampCheck = 0

local function cellKey(cx: number, cz: number): number
	return (cx + 4096) * 8192 + (cz + 4096)
end

local function flatDist(a: Vector3, b: Vector3): number
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

local function yawFrom(dir: Vector3): number
	return math.atan2(-dir.X, -dir.Z)
end

function ZombieService:Init(services)
	S = services
end

function ZombieService:Start()
	for _, camp in World.Camps() do
		local boss = ZONE_BOSSES[camp.zone]
		table.insert(camps, {
			kind = "Camp",
			camp = camp,
			alive = {},
			respawnAt = {},
			active = false,
			lastNear = 0,
			-- the last camp in each zone hosts that zone's boss
			boss = boss,
			bossAt = os.clock() + ZONE_BOSS_EVERY,
		})
	end
	-- only keep boss duty on the last camp of each zone
	local lastOfZone = {}
	for i, c in camps do
		lastOfZone[c.camp.zone] = i
	end
	for i, c in camps do
		if lastOfZone[c.camp.zone] ~= i then
			c.boss = nil
		end
	end

	Net.Event("StartWave").OnServerEvent:Connect(function(player)
		self:StartWave(player)
	end)
	S.DataService.PlayerLeaving:Connect(function(player)
		self:EndWave(player, "left")
		self:EndDungeon(player, false)
	end)
end

----------------------------------------------------------------------------
-- Spatial queries
----------------------------------------------------------------------------

function ZombieService:RebuildGrid()
	table.clear(grid)
	for _, z in S.EntityService:OfKind("Zombie") do
		if not z.dead then
			local key = cellKey(math.floor(z.pos.X / CELL), math.floor(z.pos.Z / CELL))
			local list = grid[key]
			if not list then
				list = {}
				grid[key] = list
			end
			table.insert(list, z)
		end
	end
end

-- Living zombies within `radius` of `pos` that `viewerId` may interact with.
function ZombieService:Query(pos: Vector3, radius: number, viewerId: number?)
	local out = {}
	local x0, x1 = math.floor((pos.X - radius - 4) / CELL), math.floor((pos.X + radius + 4) / CELL)
	local z0, z1 = math.floor((pos.Z - radius - 4) / CELL), math.floor((pos.Z + radius + 4) / CELL)
	for cx = x0, x1 do
		for cz = z0, z1 do
			local list = grid[cellKey(cx, cz)]
			if list then
				for _, z in list do
					if not z.dead and (z.visibleTo == nil or viewerId == nil or z.visibleTo == viewerId) then
						local r = radius + z.radius
						local dx, dz = z.pos.X - pos.X, z.pos.Z - pos.Z
						if dx * dx + dz * dz <= r * r and math.abs(z.pos.Y - pos.Y) < 40 then
							table.insert(out, z)
						end
					end
				end
			end
		end
	end
	return out
end

----------------------------------------------------------------------------
-- Spawning
----------------------------------------------------------------------------

-- opts: { encounter, visibleTo, leash, floorY, goal = "core"|"hunt"|nil, aggro }
function ZombieService:Spawn(typeId: string, level: number, pos: Vector3, opts: { [string]: any }?)
	local o = opts or {}
	local def = Zombies.Types[typeId]
	local scaled = Zombies.Scale(typeId, level)
	local scale = def.body.scale or 1
	local y = o.floorY or World.GroundHeight(pos.X, pos.Z)
	local z = S.EntityService:Create("Zombie", {
		typeId = typeId,
		def = def,
		level = level,
		name = def.displayName,
		boss = def.boss,
		guard = def.guard,
		maxHp = scaled.hp,
		hp = scaled.hp,
		damage = scaled.damage,
		speed = def.speed,
		attackRate = def.attackRate,
		range = def.range,
		aggro = o.aggro or def.aggro,
		rewards = { coins = scaled.coins, xp = scaled.xp, mutagen = scaled.mutagen },
		pos = Vector3.new(pos.X, y, pos.Z),
		home = Vector3.new(pos.X, y, pos.Z),
		radius = 1.3 * scale,
		appearance = { source = "Zombie", type = typeId },
		visibleTo = o.visibleTo,
		encounter = o.encounter,
		floorY = o.floorY,
		leash = o.leash,
		goal = o.goal,
		nextAttack = 0,
		nextScan = 0,
	})
	if o.encounter then
		o.encounter.alive[z.id] = z
	end
	return z
end

----------------------------------------------------------------------------
-- Tick
----------------------------------------------------------------------------

function ZombieService:Step(dt: number)
	local now = os.clock()
	self:RebuildGrid()

	for _, z in S.EntityService:OfKind("Zombie") do
		if not z.dead then
			self:StepZombie(z, dt, now)
		end
	end

	-- Deferred removal so the killing-blow numbers land first.
	for i = #dying, 1, -1 do
		local item = dying[i]
		if now >= item.at then
			S.EntityService:Remove(item.z, item.fx)
			table.remove(dying, i)
		end
	end

	for player, wave in waves do
		self:StepWave(player, wave, now)
	end
	for player, dungeon in dungeons do
		self:StepDungeon(player, dungeon, now)
	end
	if now - lastCampCheck > 1 then
		lastCampCheck = now
		for _, camp in camps do
			self:StepCamp(camp, now)
		end
	end
end

function ZombieService:GroundAt(z, x: number, zz: number): number
	return z.floorY or World.GroundHeight(x, zz)
end

function ZombieService:StepZombie(z, dt: number, now: number)
	local speedMult, stun, yOffset = S.CombatService:StepEffects(z, dt, now)
	if z.dead then
		return
	end
	local ground = self:GroundAt(z, z.pos.X, z.pos.Z)
	if stun then
		z.state = if stun == "Frozen" then State.Frozen else State.Stunned
		z.pos = Vector3.new(z.pos.X, ground + yOffset, z.pos.Z)
		return
	end

	if now >= z.nextScan then
		z.targetInfo = self:PickTarget(z, now)
		z.nextScan = now + 0.4 + (z.id % 5) * 0.02
	end
	local t = z.targetInfo
	local goalPos, reach
	if t then
		if t.kind == "pet" then
			if t.e.removed or t.e.fainted then
				z.targetInfo = nil
				z.nextScan = 0
				return
			end
			goalPos, reach = t.e.pos, z.range + t.e.radius
		elseif t.kind == "player" then
			local root = S.EntityService:RootOf(t.player)
			if not root then
				z.targetInfo = nil
				return
			end
			goalPos, reach = root.Position, z.range + 1
		elseif t.kind == "defense" then
			if t.d.broken then
				z.targetInfo = nil
				z.nextScan = 0
				return
			end
			goalPos, reach = t.d.pos, z.range + t.d.radius
		elseif t.kind == "core" then
			goalPos, reach = t.plot.corePos, z.range + 4
		elseif t.kind == "move" then
			goalPos, reach = t.pos, 2
		end
	end
	if not goalPos then
		z.state = State.Idle
		return
	end

	local to = Vector3.new(goalPos.X - z.pos.X, 0, goalPos.Z - z.pos.Z)
	local dist = to.Magnitude
	if dist > 1e-3 then
		z.yaw = yawFrom(to / dist)
	end

	if dist > reach then
		local speed = z.speed * speedMult * (if t and t.chase then 1.15 else 1)
		local step = math.min(dist - reach * 0.9, speed * dt)
		local nx, nz = z.pos.X + to.X / dist * step, z.pos.Z + to.Z / dist * step
		-- light separation inside the cell
		local list = grid[cellKey(math.floor(z.pos.X / CELL), math.floor(z.pos.Z / CELL))]
		if list then
			for _, other in list do
				if other ~= z then
					local dx, dz = nx - other.pos.X, nz - other.pos.Z
					local d2 = dx * dx + dz * dz
					local min = z.radius + other.radius
					if d2 < min * min and d2 > 1e-4 then
						local d = math.sqrt(d2)
						nx += dx / d * (min - d) * 0.5
						nz += dz / d * (min - d) * 0.5
					end
				end
			end
		end
		if not z.floorY then
			nx, nz = World.ClampToValley(nx, nz, 8)
		end
		z.pos = Vector3.new(nx, self:GroundAt(z, nx, nz) + yOffset, nz)
		z.state = State.Move
		return
	end

	z.pos = Vector3.new(z.pos.X, ground + yOffset, z.pos.Z)
	if t.kind == "move" then
		z.state = State.Idle
		z.targetInfo = nil
		if z.returningHome then
			z.returningHome = false
			z.hp = z.maxHp
		end
		return
	end
	if now < z.nextAttack then
		if now > (z.stateHold or 0) then
			z.state = State.Idle
		end
		return
	end
	z.nextAttack = now + 1 / z.attackRate
	z.state = State.Attack
	z.stateHold = now + 0.35
	if z.def.ranged then
		S.EntityService:Event(z.pos, { EV.Projectile, z.id, if t.kind == "pet" then t.e.id else 0, "Spit" }, z.visibleTo)
	end

	if t.kind == "pet" then
		S.CombatService:Damage(z, t.e, z.damage, { fx = if z.boss then "Smash" else "Claw" })
	elseif t.kind == "player" then
		local playerDamage = math.min(if z.boss then 40 else 25, 6 + z.level * 0.4)
		S.CombatService:DamagePlayer(t.player, playerDamage, z)
	elseif t.kind == "defense" then
		S.PlotService:DamageDefense(t.plot, t.d, z.damage, z)
	elseif t.kind == "core" then
		S.PlotService:DamageCore(t.plot, z.damage)
	end
end

function ZombieService:PickTarget(z, now: number)
	local enc = z.encounter

	-- Leash: camp zombies and guards walk home and heal.
	local leash = z.leash
	if leash and flatDist(z.pos, z.home) > leash then
		z.returningHome = true
	end
	if z.returningHome then
		return { kind = "move", pos = z.home }
	end

	-- Taunted by a Tank pet
	local taunter = z.tauntedBy
	if taunter and now < (z.tauntUntil or 0) and not taunter.removed and not taunter.fainted then
		return { kind = "pet", e = taunter }
	end

	-- Heist guards chase whoever carries their egg.
	if enc and enc.kind == "Heist" and enc.carrier then
		local root = S.EntityService:RootOf(enc.carrier)
		if root and flatDist(root.Position, z.pos) < (z.leash or 300) then
			return { kind = "player", player = enc.carrier, chase = true }
		end
	end

	local aggro = z.aggro
	local best, bestD = nil, aggro
	for _, pet in S.EntityService:OfKind("Pet") do
		if not pet.fainted and not pet.mounted and (z.visibleTo == nil or pet.ownerId == z.visibleTo) then
			local d = flatDist(pet.pos, z.pos)
			if d < bestD and math.abs(pet.pos.Y - z.pos.Y) < 30 then
				best, bestD = { kind = "pet", e = pet }, d
			end
		end
	end
	local playerAggro = aggro * 0.7
	for _, player in Players:GetPlayers() do
		if z.visibleTo == nil or player.UserId == z.visibleTo then
			local root = S.EntityService:RootOf(player)
			if root then
				local d = flatDist(root.Position, z.pos)
				if d < math.min(bestD, playerAggro) and math.abs(root.Position.Y - z.pos.Y) < 20 then
					best, bestD = { kind = "player", player = player }, d
				end
			end
		end
	end
	if best then
		return best
	end

	if z.goal == "core" and enc and enc.plot then
		local blocking = S.PlotService:BlockingDefense(enc.plot, z.pos, enc.plot.corePos, z.radius)
		if blocking then
			return { kind = "defense", d = blocking, plot = enc.plot }
		end
		return { kind = "core", plot = enc.plot }
	elseif z.goal == "hunt" and enc then
		-- Dungeon zombies hunt the runner's army anywhere in the arena.
		local owner = enc.player
		local squad = S.PetService:GetSquad(owner)
		if squad then
			for _, pet in squad.order do
				if not pet.fainted then
					return { kind = "pet", e = pet }
				end
			end
		end
		return { kind = "player", player = owner }
	elseif z.patrol then
		local p = z.patrol
		if flatDist(z.pos, p.points[p.i]) < 3 then
			p.i = p.i % #p.points + 1
		end
		return { kind = "move", pos = p.points[p.i] }
	elseif flatDist(z.pos, z.home) > 6 then
		return { kind = "move", pos = z.home }
	end
	return nil
end

----------------------------------------------------------------------------
-- Death & rewards
----------------------------------------------------------------------------

function ZombieService:OnKilled(z, killer, opts)
	z.state = State.Dead
	local enc = z.encounter
	if enc then
		enc.alive[z.id] = nil
		enc.killed = (enc.killed or 0) + 1
		if enc.kind == "Camp" then
			-- camps refill only after you stop killing for a moment
			enc.nextSpawn = math.max(enc.nextSpawn or 0, os.clock() + CAMP_RESPAWN)
		end
		if enc.onKilled then
			task.spawn(enc.onKilled, z, killer)
		end
	end

	local owner: Player? = nil
	if killer and killer.kind == "Pet" and killer.owner then
		owner = killer.owner
	elseif enc and enc.player then
		owner = enc.player
	elseif z.lastAttacker and z.lastAttacker.owner then
		owner = z.lastAttacker.owner
	end

	if owner and S.DataService:IsLoaded(owner) then
		local r = z.rewards
		local coins = S.DataService:Add(owner, "coins", r.coins)
		S.DataService:Add(owner, "mutagen", r.mutagen, true)
		S.DataService:AddXP(owner, r.xp)
		S.DataService:IncrementStat(owner, "zombiesKilled")
		if z.boss then
			S.DataService:IncrementStat(owner, "bossesKilled")
		end
		S.PetService:AwardKill(owner, if killer and killer.kind == "Pet" then killer else nil, r.xp, z.boss == true)
		S.EntityService:Event(z.pos, { EV.Text, z.id, "+💰" .. math.floor(coins), "#FFD84A" }, owner.UserId)
		if z.def.fruitDrop and math.random() < z.def.fruitDrop then
			S.FruitService:GrantRandom(owner, "boss")
		end
		if z.boss and not enc then
			S.AnnounceService:Announce(("%s's army defeated %s!"):format(owner.DisplayName, z.name), "reward")
		end
	end

	local fx = if opts and opts.fx then opts.fx else "Hit"
	table.insert(dying, { z = z, at = os.clock() + REMOVE_DELAY, fx = "Death:" .. fx })
end

-- Robux "Zombie Nuke": clears the buyer's wave and everything near them.
function ZombieService:Nuke(player: Player)
	local root = S.EntityService:RootOf(player)
	local wave = waves[player]
	local victims = {}
	if wave then
		for _, z in wave.alive do
			victims[z] = true
		end
		wave.queue = {}
	end
	if root then
		self:RebuildGrid()
		for _, z in self:Query(root.Position, 220, player.UserId) do
			if not z.guard then
				victims[z] = true
			end
		end
		S.EntityService:Event(root.Position, { EV.Ability, 0, "Nuke", root.Position.X, root.Position.Z, 220, 0, 0 })
	end
	for z in victims do
		S.CombatService:Kill(z, nil, { fx = "Nuke" })
	end
end

----------------------------------------------------------------------------
-- Base-defense waves (Build & Kill)
----------------------------------------------------------------------------

function ZombieService:GetWave(player: Player)
	return waves[player]
end

function ZombieService:StartWave(player: Player)
	local plot = S.PlotService:GetPlot(player)
	local d = S.DataService:Get(player)
	if not plot or not d then
		return
	end
	local wave = waves[player]
	if wave and wave.state == "Fighting" then
		return
	end
	local n = d.base.wave + 1
	wave = {
		kind = "Wave",
		player = player,
		plot = plot,
		wave = n,
		queue = Zombies.WaveComposition(n),
		alive = {},
		spawnTimer = 0,
		state = "Fighting",
		killed = 0,
	}
	wave.total = #wave.queue
	waves[player] = wave
	S.PlotService:SetCoreHp(plot, plot.coreMax)
	self:SendWaveState(player)
	S.AnnounceService:Notify(player, ("🧟 WAVE %d INCOMING!"):format(n), "warn")
end

function ZombieService:StepWave(player: Player, wave, now: number)
	local plot = wave.plot
	if wave.state == "Fighting" then
		local aliveCount = 0
		for _ in wave.alive do
			aliveCount += 1
		end
		if #wave.queue > 0 and now >= wave.spawnTimer and aliveCount < Zombies.MaxAlivePerPlot then
			wave.spawnTimer = now + Zombies.WaveSpawnInterval
			local typeId = table.remove(wave.queue, 1)
			local rift = plot.riftPos
			local jitter = Vector3.new(math.random(-8, 8), 0, math.random(-3, 3))
			self:Spawn(typeId, Zombies.WaveLevel(wave.wave), rift + plot.cf:VectorToWorldSpace(jitter), {
				encounter = wave,
				goal = "core",
				aggro = 22,
			})
			if Zombies.Types[typeId].boss then
				S.AnnounceService:Notify(player, ("👹 %s has entered your farm!"):format(Zombies.Types[typeId].displayName), "warn")
			end
		end
		if plot.coreHp <= 0 then
			self:EndWave(player, "failed")
			return
		end
		if #wave.queue == 0 and aliveCount == 0 then
			self:CompleteWave(player, wave, now)
		end
		if now - (wave.lastSync or 0) > 1 then
			wave.lastSync = now
			self:SendWaveState(player)
		end
	elseif wave.state == "Break" then
		local d = S.DataService:Get(player)
		if now >= wave.breakUntil and d and d.settings.autoWave and S.PlotService:IsOnPlot(player, 30) then
			self:StartWave(player)
		end
	end
end

function ZombieService:CompleteWave(player: Player, wave, now: number)
	local d = S.DataService:Get(player)
	local n = wave.wave
	d.base.wave = n
	d.base.bestWave = math.max(d.base.bestWave, n)
	S.DataService:Replicate(player, "base")
	S.DataService:IncrementStat(player, "wavesCleared")
	local coins = S.DataService:Add(player, "coins", math.floor(60 * n ^ 1.35))
	S.DataService:Add(player, "mutagen", 3 * n, true)
	S.DataService:AddXP(player, 20 * n)
	S.AnnounceService:Notify(player, ("✅ WAVE %d CLEARED! +💰%d"):format(n, math.floor(coins)), "reward")
	if n % 10 == 0 then
		S.AnnounceService:Announce(("%s survived WAVE %d on their farm!"):format(player.DisplayName, n), "reward")
	end
	wave.state = "Break"
	wave.breakUntil = now + Zombies.WaveBreak
	S.PlotService:SetCoreHp(wave.plot, wave.plot.coreMax)
	S.PlotService:RepairDefenses(wave.plot)
	self:SendWaveState(player)
end

function ZombieService:EndWave(player: Player, reason: string)
	local wave = waves[player]
	if not wave then
		return
	end
	for _, z in wave.alive do
		z.dead = true
		S.EntityService:Remove(z, "Death:Poof")
	end
	wave.alive = {}
	if reason == "failed" then
		S.AnnounceService:Notify(player, "💔 The horde broke your Barn Heart! Upgrade walls, turrets and pets, then try again.", "error")
		S.PlotService:SetCoreHp(wave.plot, wave.plot.coreMax)
		S.PlotService:RepairDefenses(wave.plot)
		wave.state = "Idle"
		self:SendWaveState(player)
	else
		waves[player] = nil
	end
end

function ZombieService:SendWaveState(player: Player)
	local wave = waves[player]
	if not wave then
		Net.Event("WaveState"):FireClient(player, nil)
		return
	end
	local alive = 0
	for _ in wave.alive do
		alive += 1
	end
	Net.Event("WaveState"):FireClient(player, {
		wave = wave.wave,
		state = wave.state,
		remaining = alive + #wave.queue,
		total = wave.total,
		coreHp = wave.plot.coreHp,
		coreMax = wave.plot.coreMax,
		breakLeft = if wave.breakUntil then math.max(0, wave.breakUntil - os.clock()) else 0,
	})
end

----------------------------------------------------------------------------
-- Valley camps + zone bosses
----------------------------------------------------------------------------

function ZombieService:StepCamp(c, now: number)
	local campPos = c.camp.position
	local near = false
	for _, player in Players:GetPlayers() do
		local root = S.EntityService:RootOf(player)
		if root and flatDist(root.Position, campPos) < CAMP_RANGE then
			near = true
			break
		end
	end
	if near then
		c.lastNear = now
		c.active = true
	elseif c.active and now - c.lastNear > CAMP_SLEEP then
		c.active = false
		for _, z in c.alive do
			z.dead = true
			S.EntityService:Remove(z)
		end
		c.alive = {}
		return
	end
	if not c.active then
		return
	end

	local count = 0
	for _ in c.alive do
		count += 1
	end
	if count < c.camp.size and now >= (c.nextSpawn or 0) then
		c.nextSpawn = now + 0.5
		local types = c.camp.types
		local typeId = types[math.random(1, #types)]
		local offset = Vector3.new(math.random(-14, 14), 0, math.random(-14, 14))
		local level = math.max(1, c.camp.level + math.random(-1, 1))
		self:Spawn(typeId, level, campPos + offset, { encounter = c, leash = 70 })
	end

	if c.boss and now >= c.bossAt then
		c.bossAt = now + ZONE_BOSS_EVERY
		local boss = self:Spawn(c.boss.type, c.boss.level, campPos, { encounter = c, leash = 90 })
		local zone = World.ZoneById(c.camp.zone)
		S.AnnounceService:Announce(("👹 %s has risen in %s!"):format(boss.name, if zone then zone.name else "the valley"), "warn")
	end
end

----------------------------------------------------------------------------
-- The Hollow Stump dungeon
----------------------------------------------------------------------------

function ZombieService:StartDungeon(player: Player): boolean
	local d = S.DataService:Get(player)
	if not d or dungeons[player] then
		return false
	end
	if os.time() < (d.dungeonCooldown or 0) then
		S.AnnounceService:Notify(player, ("The Hollow is sealed for %ds."):format(d.dungeonCooldown - os.time()), "warn")
		return false
	end
	local dun = World.Dungeon
	local center = Vector3.new(World.CenterX(dun.arena.Z) + dun.arena.X, dun.arena.Y, dun.arena.Z)
	local run = {
		kind = "Dungeon",
		player = player,
		wave = 0,
		maxWaves = dun.waves,
		level = d.level + dun.levelOffset,
		alive = {},
		center = center,
		floorY = center.Y,
		state = "Starting",
		nextWaveAt = os.clock() + 3,
	}
	dungeons[player] = run
	local character = player.Character
	if character then
		character:PivotTo(CFrame.new(center + Vector3.new(0, 5, 20)))
	end
	S.AnnounceService:Notify(player, "🪵 You entered THE HOLLOW STUMP. Survive 4 waves!", "warn")
	return true
end

function ZombieService:StepDungeon(player: Player, run, now: number)
	local alive = 0
	for _ in run.alive do
		alive += 1
	end
	local root = S.EntityService:RootOf(player)
	if not root or root.Position.Y > run.floorY + 60 then
		self:EndDungeon(player, false)
		return
	end
	if alive == 0 and now >= run.nextWaveAt then
		if run.wave >= run.maxWaves then
			self:EndDungeon(player, true)
			return
		end
		run.wave += 1
		local types = { "Walker", "Runner", "Spitter", "Brute" }
		local count = 6 + run.wave * 3
		for i = 1, count do
			local a = (i / count) * math.pi * 2
			local pos = run.center + Vector3.new(math.cos(a) * 45, 0, math.sin(a) * 45)
			self:Spawn(types[math.random(1, math.min(#types, run.wave + 1))], run.level, pos, {
				encounter = run,
				visibleTo = player.UserId,
				floorY = run.floorY,
				goal = "hunt",
				aggro = 200,
			})
		end
		if run.wave == run.maxWaves then
			self:Spawn("FarmerZed", run.level + 2, run.center + Vector3.new(0, 0, -40), {
				encounter = run,
				visibleTo = player.UserId,
				floorY = run.floorY,
				goal = "hunt",
				aggro = 200,
			})
		end
		S.AnnounceService:Notify(player, ("Hollow wave %d/%d"):format(run.wave, run.maxWaves), "warn")
		run.nextWaveAt = now + 2
	end
end

function ZombieService:EndDungeon(player: Player, won: boolean)
	local run = dungeons[player]
	if not run then
		return
	end
	dungeons[player] = nil
	for _, z in run.alive do
		z.dead = true
		S.EntityService:Remove(z, "Death:Poof")
	end
	local d = S.DataService:Get(player)
	if d then
		d.dungeonCooldown = os.time() + World.Dungeon.cooldown
	end
	if won and d then
		local coins = S.DataService:Add(player, "coins", 800 * run.level)
		S.DataService:Add(player, "mutagen", 25 * run.level, true)
		S.AnnounceService:Notify(player, ("🏆 HOLLOW CLEARED! +💰%d"):format(math.floor(coins)), "reward")
		if math.random() < 0.25 then
			S.FruitService:GrantRandom(player, "dungeon")
		end
		if math.random() < 0.5 then
			S.MutationService:AddCapsule(player, S.MutationService:RollMutation(1), "dungeon")
		end
	end
	task.delay(if won then 3 else 0, function()
		local character = player.Character
		if character and player.Parent then
			local entrance = World.Resolve(World.Dungeon.entrance)
			character:PivotTo(CFrame.new(entrance + Vector3.new(0, 5, -16)))
		end
	end)
end

-- Heist/other services register encounters they create here for cleanup.
function ZombieService:DespawnEncounter(enc)
	for _, z in enc.alive do
		z.dead = true
		S.EntityService:Remove(z, "Death:Poof")
	end
	enc.alive = {}
	local i = table.find(extraEncounters, enc)
	if i then
		table.remove(extraEncounters, i)
	end
end

return ZombieService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">ZoneService</string>
            <string name="Source"><![CDATA[--[[
	ZoneService: level-gated zones of the Long Valley.

	Gates are physical barriers built by WorldBuilder. The client turns
	collision off locally for gates the player has unlocked; the server
	double-checks positions so exploiters can't skip ahead.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local World = require(Shared.Config.World)

local ZoneService = { Name = "ZoneService" }

local S
local lastZone: { [Player]: string } = {}

function ZoneService:Init(services)
	S = services
end

function ZoneService:Start()
	Players.PlayerRemoving:Connect(function(player)
		lastZone[player] = nil
	end)
end

function ZoneService:Step(_dt: number)
	for _, player in Players:GetPlayers() do
		local d = S.DataService:Get(player)
		local root = S.EntityService:RootOf(player)
		if d and root and root.Position.Y > -100 then
			local zone = World.ZoneAt(root.Position.Z)
			if zone.levelReq > d.level then
				local backZ = zone.zStart - 12
				local x = World.CenterX(backZ)
				local character = root.Parent :: Model
				character:PivotTo(CFrame.new(x, World.GroundHeight(x, backZ) + 5, backZ))
				S.AnnounceService:Notify(player, ("🔒 %s unlocks at Lv %d"):format(zone.name, zone.levelReq), "warn")
			elseif lastZone[player] ~= zone.id then
				if lastZone[player] ~= nil then
					S.AnnounceService:Notify(player, ("📍 %s"):format(zone.name), "zone")
				end
				lastZone[player] = zone.id
				player:SetAttribute("Zone", zone.id)
			end
		end
	end
end

return ZoneService
]]></string>
          </Properties>
        </Item>
