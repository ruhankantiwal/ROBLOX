  </Item>
  <Item class="StarterPlayer" referent="48">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">80</float>
      <float name="CharacterJumpPower">50</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterWalkSpeed">18</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="49">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="50">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">ClientState</string>
            <string name="Source"><![CDATA[--[[
	ClientState: the client's mirror of its own profile, fed by the Init
	and DataChanged remotes. UI subscribes with ClientState.Changed.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)

local ClientState = {
	data = nil :: any,
	loaded = false,
	Changed = Signal.new(), -- (key, value)
	Loaded = Signal.new(),
	serverTimeOffset = 0,
	wave = nil :: any,
	heist = nil :: any,
}

function ClientState.Start()
	Net.Event("Init").OnClientEvent:Connect(function(snapshot)
		ClientState.data = snapshot
		ClientState.serverTimeOffset = snapshot.serverTime - os.time()
		ClientState.loaded = true
		ClientState.Loaded:Fire(snapshot)
	end)
	Net.Event("DataChanged").OnClientEvent:Connect(function(key, a, b)
		local d = ClientState.data
		if not d then
			return
		end
		if key == "pet" then
			d.pets[a] = b
			ClientState.Changed:Fire("pets", d.pets)
		else
			d[key] = a
			ClientState.Changed:Fire(key, a)
		end
	end)
	Net.Event("WaveState").OnClientEvent:Connect(function(state)
		ClientState.wave = state
		ClientState.Changed:Fire("wave", state)
	end)
	Net.Event("HeistState").OnClientEvent:Connect(function(state)
		ClientState.heist = state
		ClientState.Changed:Fire("heist", state)
	end)
end

function ClientState.Now(): number
	return os.time() + ClientState.serverTimeOffset
end

return ClientState
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="52">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">Cinematics</string>
              <string name="Source"><![CDATA[--[[
	Cinematics: the clip-worthy moments.

	  Hatch      egg shakes harder and harder, white flash, pet spins in
	             with a rarity banner (1 or 3 eggs side by side)
	  Mutation   the camera orbits your pet in slow motion while it
	             transforms: flash in the fruit colour, rings, giant title
	  Clip Mode  hides every UI element so recording for TikTok/Shorts is
	             one tap

	All built from ViewportFrames + BlockyBuilder, no assets.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Pets = require(Shared.Config.Pets)
local Eggs = require(Shared.Config.Eggs)
local Fruits = require(Shared.Config.Fruits)
local Mutations = require(Shared.Config.Mutations)
local Rarity = require(Shared.Config.Rarity)
local BlockyBuilder = require(Shared.Art.BlockyBuilder)
local Props = require(Shared.Art.Props)
local PetStats = require(Shared.Util.PetStats)

local Kit = require(script.Parent.Parent.UI.Kit)
local FX = require(script.Parent.FX)
local EntityRenderer = require(script.Parent.EntityRenderer)
local ClientState = require(script.Parent.Parent.ClientState)

local LOCAL = Players.LocalPlayer

local Cinematics = { busy = false }

local gui: ScreenGui

function Cinematics.Start()
	gui = Kit.new("ScreenGui", {
		Name = "Cinematics",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 50,
		Parent = LOCAL:WaitForChild("PlayerGui"),
	})
	Net.Event("HatchResult").OnClientEvent:Connect(function(result)
		Cinematics.Hatch(result)
	end)
	Net.Event("MutationCinematic").OnClientEvent:Connect(function(info)
		Cinematics.Mutation(info)
	end)
end

----------------------------------------------------------------------------
-- Viewport helpers
----------------------------------------------------------------------------

local function viewport(parent: Instance, size: UDim2, position: UDim2): (ViewportFrame, WorldModel, Camera)
	local vp = Kit.new("ViewportFrame", {
		Size = size,
		Position = position,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(200, 200, 210),
		LightColor = Color3.fromRGB(255, 250, 240),
		LightDirection = Vector3.new(-1, -1, -0.6),
		Parent = parent,
	})
	local world = Kit.new("WorldModel", { Parent = vp })
	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	camera.Parent = vp
	vp.CurrentCamera = camera
	return vp, world, camera
end

-- Static pose of a pet rig inside a WorldModel. Returns its height.
function Cinematics.PetModel(parent: Instance, pet, cf: CFrame): (Model, number)
	local stats = PetStats.Compute(pet)
	local rig = BlockyBuilder.Build(Pets.Species[pet.species].body, {
		scale = stats.sizeMult,
		variant = pet.variant,
		fruit = pet.fruit and pet.fruit.id,
		awakened = stats.special.awakened,
		mutations = pet.mutations,
	})
	local model = Instance.new("Model")
	for _, spec in rig.parts do
		local p = Instance.new("Part")
		p.Anchored = true
		p.Size = spec.size
		p.Color = spec.color
		p.Material = spec.material
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.CFrame = cf * rig.groups[spec.group] * spec.localCF
		p.Parent = model
	end
	model.Parent = parent
	return model, rig.height
end

local function overlay(): Frame
	local dim = Kit.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	TweenService:Create(dim, TweenInfo.new(0.25), { BackgroundTransparency = 0.35 }):Play()
	return dim
end

local function flashScreen(color: Color3, duration: number?)
	local f = Kit.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color,
		BackgroundTransparency = 0,
		ZIndex = 20,
		Parent = gui,
	})
	TweenService:Create(f, TweenInfo.new(duration or 0.5), { BackgroundTransparency = 1 }):Play()
	task.delay((duration or 0.5) + 0.1, function()
		f:Destroy()
	end)
end

local function banner(parent: Instance, text: string, color: Color3, y: number, size: number): TextLabel
	local label = Kit.label(text, size, color, {
		Size = UDim2.new(1, 0, 0, size + 10),
		Position = UDim2.fromScale(0.5, y),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 10,
		Parent = parent,
	})
	Kit.pop(label)
	return label
end

----------------------------------------------------------------------------
-- Hatch
----------------------------------------------------------------------------

function Cinematics.Hatch(result)
	if not result or not result.ok or not result.results then
		return
	end
	local d = ClientState.data
	local dim = overlay()
	local n = #result.results
	local skip = false
	local tap = Kit.new("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 30,
		Parent = dim,
	})
	tap.Activated:Connect(function()
		skip = true
	end)

	local slots = {}
	for i, r in result.results do
		local x = if n == 1 then 0.5 else 0.2 + (i - 1) * 0.3
		local vp, world, camera = viewport(dim, UDim2.fromScale(0.34, 0.5), UDim2.fromScale(x, 0.45))
		local eggDef = Eggs.List[result.egg] or Eggs.List.DragonEgg
		local egg = Props.Egg(world, CFrame.new(), eggDef, 1)
		camera.CFrame = CFrame.lookAt(Vector3.new(0, 2.2, -9), Vector3.new(0, 1.7, 0))
		slots[i] = { vp = vp, world = world, camera = camera, egg = egg, result = r }
	end

	-- Shake: harder and faster
	local start = os.clock()
	while os.clock() - start < 1.3 and not skip do
		local t = os.clock() - start
		for _, s in slots do
			local amp = 0.05 + t * 0.35
			s.egg:PivotTo(CFrame.Angles(0, 0, math.sin(t * (12 + t * 30)) * amp))
		end
		RunService.RenderStepped:Wait()
	end
	flashScreen(Color3.new(1, 1, 1), 0.45)

	local best = 0
	for _, s in slots do
		s.egg:Destroy()
		local r = s.result
		local pet = (r.uid and d and d.pets[r.uid]) or { species = r.species, level = 1, variant = r.variant, mutations = {} }
		local _, height = Cinematics.PetModel(s.world, pet, CFrame.new())
		s.height = height
		local def = Pets.Species[r.species]
		local rarityColor = Rarity.Color(def.rarity)
		local rank = Rarity.Rank(def.rarity)
		best = math.max(best, rank)
		local title = def.emoji .. " " .. def.displayName
		if r.variant and r.variant ~= "Normal" then
			title = Pets.Variants[r.variant].label .. " " .. title
		end
		local holder = Kit.new("Frame", {
			Size = UDim2.new(0.3, 0, 0, 90),
			Position = UDim2.new(s.vp.Position.X.Scale, 0, 0.78, 0),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			Parent = dim,
		})
		banner(holder, title, Color3.new(1, 1, 1), 0.3, 30)
		banner(holder, def.rarity:upper(), rarityColor, 0.8, 26)
	end
	if best >= 5 then
		flashScreen(Color3.fromRGB(255, 220, 80), 0.9)
		FX.Shake(1.2, 0.6)
	end

	local spinStart = os.clock()
	while os.clock() - spinStart < (if skip then 0.6 else 2.2) do
		local t = os.clock() - spinStart
		for _, s in slots do
			local h = s.height or 3
			local dist = h * 2.2 + 5
			s.camera.CFrame = CFrame.lookAt(Vector3.new(math.sin(t * 1.4) * dist, h * 0.75, -math.cos(t * 1.4) * dist), Vector3.new(0, h * 0.45, 0))
		end
		RunService.RenderStepped:Wait()
	end
	TweenService:Create(dim, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
	for _, s in slots do
		s.vp:Destroy()
	end
	task.wait(0.25)
	dim:Destroy()
end

----------------------------------------------------------------------------
-- Mutation / Fruit feeding
----------------------------------------------------------------------------

function Cinematics.Mutation(info)
	local color, title, subtitle
	if info.kind == "Fruit" or info.kind == "FruitRoll" then
		local fruit = Fruits.List[info.id]
		color = fruit.color
		title = if info.kind == "Fruit" then ("%s %s MUTATION!"):format(fruit.emoji, fruit.element:upper()) else ("%s %s!"):format(fruit.emoji, fruit.displayName:upper())
		subtitle = fruit.tagline
	else
		local m = Mutations.List[info.id]
		color = Rarity.Color(m.rarity)
		title = ("%s %s"):format(m.emoji, m.displayName:upper())
		subtitle = m.joke
	end

	local dim = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })
	local ent = info.uid and EntityRenderer.PetByUid(info.uid)
	local camera = workspace.CurrentCamera

	if ent and info.kind ~= "FruitRoll" then
		-- In-world orbit around the real pet
		local oldType = camera.CameraType
		camera.CameraType = Enum.CameraType.Scriptable
		local start = os.clock()
		local flashed = false
		while os.clock() - start < 2.8 do
			local t = os.clock() - start
			local current = EntityRenderer.PetByUid(info.uid) or ent
			local h = if current.rig then current.rig.height else 3
			local center = current.pos + Vector3.new(0, h * 0.5, 0)
			local dist = h * 2 + 8 - t * 1.2
			camera.CFrame = CFrame.lookAt(center + Vector3.new(math.sin(t * 1.1) * dist, h * 0.5 + 2, math.cos(t * 1.1) * dist), center)
			if t > 0.7 and not flashed then
				flashed = true
				flashScreen(color, 0.7)
				FX.Ring(current.pos, 14, color, 0.8)
				FX.Ring(current.pos, 8, Color3.new(1, 1, 1), 0.5)
				FX.Burst(center, color, 24, 12)
				FX.Shake(1, 0.5)
				banner(dim, title, color, 0.18, 44)
				banner(dim, subtitle, Color3.new(1, 1, 1), 0.27, 22)
			end
			RunService.RenderStepped:Wait()
		end
		camera.CameraType = if oldType == Enum.CameraType.Scriptable then Enum.CameraType.Custom else oldType
	else
		-- Viewport fallback (pet not deployed, or a fruit roll)
		TweenService:Create(dim, TweenInfo.new(0.25), { BackgroundTransparency = 0.35 }):Play()
		dim.BackgroundColor3 = Color3.new(0, 0, 0)
		local vp, world, cam = viewport(dim, UDim2.fromScale(0.4, 0.55), UDim2.fromScale(0.5, 0.52))
		local height = 3
		if info.kind == "FruitRoll" then
			Props.Fruit(world, CFrame.new(0, 1.5, 0), Fruits.List[info.id], 1.6)
		else
			local pet = ClientState.data and ClientState.data.pets[info.uid]
			if pet then
				local _, h = Cinematics.PetModel(world, pet, CFrame.new())
				height = h
			end
		end
		flashScreen(color, 0.7)
		banner(dim, title, color, 0.16, 44)
		banner(dim, subtitle, Color3.new(1, 1, 1), 0.86, 22)
		local start = os.clock()
		while os.clock() - start < 2.6 do
			local t = os.clock() - start
			local dist = height * 2.2 + 5
			cam.CFrame = CFrame.lookAt(Vector3.new(math.sin(t) * dist, height * 0.8, math.cos(t) * dist), Vector3.new(0, height * 0.45, 0))
			RunService.RenderStepped:Wait()
		end
		vp:Destroy()
	end
	TweenService:Create(dim, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
	for _, child in dim:GetChildren() do
		if child:IsA("TextLabel") then
			TweenService:Create(child, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
		end
	end
	task.wait(0.35)
	dim:Destroy()
end

----------------------------------------------------------------------------
-- Clip mode
----------------------------------------------------------------------------

local clipMode = false
function Cinematics.ToggleClipMode(): boolean
	clipMode = not clipMode
	for _, screen in LOCAL.PlayerGui:GetChildren() do
		if screen:IsA("ScreenGui") and screen ~= gui and screen.Name ~= "ClipModeButton" then
			screen.Enabled = not clipMode
		end
	end
	return clipMode
end

return Cinematics
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">EntityRenderer</string>
              <string name="Source"><![CDATA[--[[
	EntityRenderer: draws every pet and zombie locally.

	Server sends 10 Hz snapshots; we smooth toward them every frame and pose
	blocky rigs procedurally (legs swing, tails wag, wings flap, zombies
	shamble). All parts are anchored, non-colliding and moved with ONE
	workspace:BulkMoveTo call per frame.

	Mobile LOD:
	  * models only exist within RENDER_DIST (streamed in/out, a few per frame)
	  * beyond ANIM_DIST limbs freeze and far entities update every 2nd frame
	  * particle/aura budgets come from FX.Quality()
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Pets = require(Shared.Config.Pets)
local Zombies = require(Shared.Config.Zombies)
local BlockyBuilder = require(Shared.Art.BlockyBuilder)
local Protocol = require(Shared.Util.EntityProtocol)
local Signal = require(Shared.Util.Signal)

local FX = require(script.Parent.FX)

local State = Protocol.State
local EV = Protocol.Event
local LOCAL = Players.LocalPlayer

local RENDER_DIST = 300
local ANIM_DIST = 110
local BUILDS_PER_FRAME = 4
local STALE_AFTER = 2.5

local EntityRenderer = {
	Spawned = Signal.new(),
	Removed = Signal.new(),
}

local entities: { [number]: any } = {}
local folder: Folder
local mounts: { [number]: any } = {} -- userId -> { entityId, height }
local frame = 0

local AURA_COLORS = {
	Fire = { Color3.fromRGB(255, 200, 60), Color3.fromRGB(255, 70, 20) },
	Ice = { Color3.fromRGB(255, 255, 255), Color3.fromRGB(120, 220, 255) },
	Volt = { Color3.fromRGB(255, 255, 180), Color3.fromRGB(255, 220, 40) },
	Dragon = { Color3.fromRGB(255, 180, 60), Color3.fromRGB(200, 20, 40) },
	Glitch = { Color3.fromRGB(255, 60, 220), Color3.fromRGB(60, 255, 240) },
	Gold = { Color3.fromRGB(255, 240, 150), Color3.fromRGB(255, 190, 20) },
}

----------------------------------------------------------------------------
-- Building models
----------------------------------------------------------------------------

local function bodyFor(appearance)
	if appearance.source == "Pet" then
		return Pets.Species[appearance.species].body, {
			scale = appearance.scale,
			variant = appearance.variant,
			fruit = appearance.fruit,
			awakened = appearance.awakened,
			mutations = appearance.mutations,
		}
	end
	return Zombies.Types[appearance.type].body, {}
end

local function addEmitter(parent: BasePart, colors, rate: number, size: number)
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(colors[1], colors[2])
	e.LightEmission = 0.7
	e.Rate = rate * FX.Quality()
	e.Lifetime = NumberRange.new(0.5, 1.1)
	e.Speed = NumberRange.new(1.5, 4)
	e.SpreadAngle = Vector2.new(40, 40)
	e.Size = NumberSequence.new(size, 0)
	e.Acceleration = Vector3.new(0, 4, 0)
	e.Parent = parent
	return e
end

local function build(ent)
	local body, opts = bodyFor(ent.appearance)
	local rig = BlockyBuilder.Build(body, opts)
	local model = Instance.new("Model")
	model.Name = ent.name or "Entity"
	local parts, specs = {}, {}
	local quality = FX.Quality()
	local torso: BasePart? = nil
	for i, spec in rig.parts do
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = quality > 0.6 and spec.size.Magnitude > 2.5
		p.Size = spec.size
		p.Color = spec.color
		p.Material = spec.material
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		parts[i] = p
		specs[i] = spec
		if spec.name == "Torso" then
			torso = p
		end
	end
	local effects = rig.effects
	if torso then
		if effects.aura and AURA_COLORS[effects.aura] then
			addEmitter(torso, AURA_COLORS[effects.aura], if effects.awakened then 22 else 12, 0.7 * (ent.appearance.scale or 1))
		end
		if effects.sparkles then
			addEmitter(torso, { Color3.new(1, 1, 1), Color3.fromRGB(255, 250, 200) }, 6, 0.4)
		end
		if effects.hearts then
			addEmitter(torso, { Color3.fromRGB(255, 120, 200), Color3.fromRGB(255, 60, 140) }, 4, 0.6)
		end
	end
	local extra = {}
	if effects.spotlight then
		local beam = Instance.new("Part")
		beam.Anchored = true
		beam.CanCollide = false
		beam.CanQuery = false
		beam.CanTouch = false
		beam.CastShadow = false
		beam.Material = Enum.Material.Neon
		beam.Color = Color3.fromRGB(255, 250, 200)
		beam.Transparency = 0.85
		beam.Shape = Enum.PartType.Cylinder
		beam.Size = Vector3.new(30, 4, 4)
		beam.Parent = model
		table.insert(extra, { part = beam, offset = CFrame.new(0, 15, 0) * CFrame.Angles(0, 0, math.pi / 2) })
	end
	if ent.boss then
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(240, 40)
		gui.StudsOffsetWorldSpace = Vector3.new(0, rig.height + 2, 0)
		gui.MaxDistance = 200
		gui.AlwaysOnTop = true
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(255, 90, 90)
		label.Text = ("👹 %s  Lv%d"):format(ent.name or "Boss", ent.level or 1)
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2.5
		stroke.Parent = label
		label.Parent = gui
		gui.Adornee = torso or parts[1]
		gui.Parent = model
	end
	model.Parent = folder
	ent.model = model
	ent.parts = parts
	ent.specs = specs
	ent.rig = rig
	ent.extra = extra
	ent.effects = effects
	ent.baseColors = nil
end

local function destroyModel(ent)
	if ent.model then
		ent.model:Destroy()
	end
	ent.model = nil
	ent.parts = nil
	ent.specs = nil
	ent.extra = nil
end

----------------------------------------------------------------------------
-- Posing
----------------------------------------------------------------------------

local ANGLES = CFrame.Angles

local function groupAnim(ent, t: number, moving: number, animate: boolean)
	local offsets = {}
	if not animate then
		return offsets
	end
	local state = ent.state
	local speedK = if ent.kind == "Zombie" then 6 else 11
	local swing = math.sin(t * speedK) * 0.7 * moving
	local attack = if state == State.Attack or state == State.Ability then math.sin(math.clamp((os.clock() - (ent.stateChanged or 0)) / 0.3, 0, 1) * math.pi) else 0
	local fx = ent.effects or {}

	if fx.biped then
		offsets.LegFL = ANGLES(swing, 0, 0)
		offsets.LegFR = ANGLES(-swing, 0, 0)
		local armBob = math.sin(t * 3) * 0.12 - attack * 0.9
		offsets.ArmL = ANGLES(armBob + swing * 0.3, 0, 0)
		offsets.ArmR = ANGLES(armBob - swing * 0.3, 0, 0)
		offsets.Head = ANGLES(math.sin(t * 2.1) * 0.1, math.sin(t * 1.3) * 0.2, math.sin(t * 1.7) * 0.15)
	else
		offsets.LegFL = ANGLES(swing, 0, 0)
		offsets.LegBR = ANGLES(swing, 0, 0)
		offsets.LegFR = ANGLES(-swing, 0, 0)
		offsets.LegBL = ANGLES(-swing, 0, 0)
		offsets.Head = ANGLES(-attack * 0.5 + math.sin(t * 2) * 0.05, 0, 0)
		offsets.Tail = ANGLES(0.2, math.sin(t * (6 + moving * 6)) * 0.5, 0)
	end
	if fx.wings then
		local flap = math.sin(t * (if moving > 0.3 or ent.state == State.Ability then 16 else 4)) * (0.35 + moving * 0.4)
		offsets.WingL = ANGLES(0, 0, -0.35 - flap)
		offsets.WingR = ANGLES(0, 0, 0.35 + flap)
	end
	if fx.halo then
		offsets.Halo = ANGLES(0, t * 3, 0)
	end
	if fx.hands67 then
		local six = math.sin(t * 7)
		offsets.HandL = CFrame.new(0, six * 0.5, 0)
		offsets.HandR = CFrame.new(0, -six * 0.5, 0)
	end
	return offsets
end

local function rootPose(ent, t: number, moving: number): CFrame
	local cf = CFrame.new(ent.pos) * ANGLES(0, ent.yaw, 0)
	local state = ent.state
	if state == State.Fainted then
		return cf * CFrame.new(0, 0.2, 0) * ANGLES(0, 0, math.pi / 2) * CFrame.new(0, -0.6, 0)
	end
	local fx = ent.effects or {}
	local bob = math.abs(math.sin(t * 11)) * 0.25 * moving
	if fx.hop then
		bob = math.abs(math.sin(t * 9)) * 0.6 * moving
	end
	local lunge = 0
	if state == State.Attack then
		lunge = math.sin(math.clamp((os.clock() - (ent.stateChanged or 0)) / 0.3, 0, 1) * math.pi) * 0.9
	end
	cf *= CFrame.new(0, bob, -lunge)
	if fx.jitter then
		cf *= CFrame.new((math.random() - 0.5) * 0.15, 0, (math.random() - 0.5) * 0.15)
	end
	if ent.kind == "Zombie" and moving > 0.1 then
		cf *= ANGLES(0.08, 0, math.sin(t * 3) * 0.06)
	end
	return cf
end

----------------------------------------------------------------------------
-- Frame loop
----------------------------------------------------------------------------

local tintTimer = 0

local function mountedPose(ent): boolean
	local info = ent.mountedBy and mounts[ent.mountedBy]
	if not info or info.entityId ~= ent.id then
		return false
	end
	local player = Players:GetPlayerByUserId(ent.mountedBy)
	local character = player and player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then
		return false
	end
	local feet = root.Position.Y - root.Size.Y / 2 - humanoid.HipHeight
	ent.pos = Vector3.new(root.Position.X, feet, root.Position.Z)
	local look = root.CFrame.LookVector
	ent.yaw = math.atan2(-look.X, -look.Z)
	ent.moving = math.clamp(Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude / 20, 0, 1)
	return true
end

local function step(dt: number)
	frame += 1
	local camera = workspace.CurrentCamera
	local camPos = camera.CFrame.Position
	local now = os.clock()
	local alpha = 1 - math.exp(-dt * 12)
	local builds = 0
	local partList, cfList = {}, {}
	tintTimer += dt
	local doTint = tintTimer > 0.1
	if doTint then
		tintTimer = 0
	end

	for _, ent in entities do
		-- smoothing (mounted pets snap to their rider)
		if not mountedPose(ent) then
			local prev = ent.pos
			ent.pos = ent.pos:Lerp(ent.targetPos, alpha)
			local dy = (ent.targetYaw - ent.yaw + math.pi) % (math.pi * 2) - math.pi
			ent.yaw += dy * alpha
			local speed = Vector3.new(ent.pos.X - prev.X, 0, ent.pos.Z - prev.Z).Magnitude / math.max(dt, 1e-3)
			ent.moving = math.clamp(speed / 12, 0, 1)
		end

		local dist = (ent.pos - camPos).Magnitude
		local stale = now - ent.lastUpdate > STALE_AFTER and ent.ownerId ~= LOCAL.UserId and not ent.mountedBy
		if dist > RENDER_DIST or stale then
			if ent.model then
				destroyModel(ent)
			end
		else
			if not ent.model and builds < BUILDS_PER_FRAME then
				builds += 1
				build(ent)
			end
			if ent.model and ent.parts and (dist < ANIM_DIST or (frame + ent.id) % 2 == 0) then
				local animate = dist < ANIM_DIST
				local t = now + ent.id * 0.37
				local root = rootPose(ent, t, ent.moving)
				local offsets = groupAnim(ent, t, ent.moving, animate)
				local groups = ent.rig.groups
				local groupCF = {}
				for name, pivot in groups do
					local off = offsets[name]
					groupCF[name] = if off then root * pivot * off else root * pivot
				end
				for i, part in ent.parts do
					local spec = ent.specs[i]
					table.insert(partList, part)
					table.insert(cfList, groupCF[spec.group] * spec.localCF)
				end
				for _, x in ent.extra do
					table.insert(partList, x.part)
					table.insert(cfList, root * x.offset)
				end

				-- colour effects
				if doTint then
					local fx = ent.effects
					if fx.rainbow then
						local hue = (now * 0.25 + ent.id * 0.1) % 1
						for i, part in ent.parts do
							if ent.specs[i].role == "main" or ent.specs[i].role == "head" then
								part.Color = Color3.fromHSV(hue, 0.65, 1)
							end
						end
					end
					if fx.glitch and math.random() < 0.15 then
						local p = ent.parts[math.random(1, #ent.parts)]
						p.Color = Color3.fromHSV(math.random(), 1, 1)
					end
					if ent.flashUntil and now > ent.flashUntil then
						ent.flashUntil = nil
						for i, part in ent.parts do
							part.Color = ent.specs[i].color
						end
					end
					local frozen = ent.state == State.Frozen
					if frozen ~= (ent.frozenTint == true) then
						ent.frozenTint = frozen
						for i, part in ent.parts do
							part.Color = if frozen then ent.specs[i].color:Lerp(Color3.fromRGB(170, 230, 255), 0.7) else ent.specs[i].color
						end
					end
				end
			end
		end
	end
	if #partList > 0 then
		workspace:BulkMoveTo(partList, cfList, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

----------------------------------------------------------------------------
-- Network handlers
----------------------------------------------------------------------------

local function addEntity(desc)
	local existing = entities[desc.id]
	if existing then
		destroyModel(existing)
	end
	local pos = Vector3.new(desc.x, desc.y, desc.z)
	local ent = {
		id = desc.id,
		kind = desc.kind,
		ownerId = desc.ownerId,
		uid = desc.uid,
		name = desc.name,
		appearance = desc.appearance,
		maxHp = desc.maxHp,
		boss = desc.boss,
		level = desc.level,
		rarity = desc.rarity,
		pos = pos,
		targetPos = pos,
		yaw = 0,
		targetYaw = 0,
		state = State.Idle,
		hp = 1,
		moving = 0,
		lastUpdate = os.clock(),
	}
	for userId, info in mounts do
		if info.entityId == desc.id then
			ent.mountedBy = userId
		end
	end
	entities[desc.id] = ent
	EntityRenderer.Spawned:Fire(ent)
end

local function removeEntity(id: number, fx: string?)
	local ent = entities[id]
	if not ent then
		return
	end
	entities[id] = nil
	if ent.model and fx and fx:sub(1, 6) == "Death:" and ent.parts then
		local parts = ent.parts
		for _, x in ent.extra or {} do
			x.part:Destroy()
		end
		for _, child in ent.model:GetDescendants() do
			if child:IsA("BillboardGui") or child:IsA("ParticleEmitter") then
				child:Destroy()
			end
		end
		FX.DeathExplosion(parts, ent.pos + Vector3.new(0, 2, 0), fx:sub(7))
		ent.model.Parent = nil
		task.delay(3, function()
			if ent.model then
				ent.model:Destroy()
			end
		end)
	else
		destroyModel(ent)
	end
	EntityRenderer.Removed:Fire(ent)
end

local function flash(ent)
	if not ent.parts then
		return
	end
	ent.flashUntil = os.clock() + 0.08
	for i = 1, math.min(3, #ent.parts) do
		ent.parts[i].Color = Color3.new(1, 1, 1)
	end
end

local function colorFromHex(hex: string?): Color3
	local ok, c = pcall(Color3.fromHex, hex or "#FFFFFF")
	return if ok then c else Color3.new(1, 1, 1)
end

local function headPos(ent): Vector3
	local h = if ent.rig then ent.rig.height else 3
	return ent.pos + Vector3.new(0, h + 0.5, 0)
end

local function onCombat(batch)
	for _, ev in batch do
		local code = ev[1]
		if code == EV.Hit then
			local target = entities[ev[3]]
			if target then
				flash(target)
				local attacker = entities[ev[2]]
				local color = FX.ElementColors[ev[6]] or Color3.new(1, 1, 1)
				local mine = (attacker and attacker.ownerId == LOCAL.UserId) or target.ownerId == LOCAL.UserId
				if mine or target.boss or FX.Quality() > 0.7 then
					FX.Damage(headPos(target), ev[4], ev[5], if target.kind == "Pet" then Color3.fromRGB(255, 110, 110) else color)
				end
				if ev[6] ~= "" and ev[6] ~= "Hit" and ev[6] ~= "Claw" then
					FX.Burst(target.pos + Vector3.new(0, 1.5, 0), color, 3, 3)
				end
			end
		elseif code == EV.Ability then
			local caster = entities[ev[2]]
			local pos = Vector3.new(ev[4], if caster then caster.pos.Y else 0, ev[5])
			if not caster then
				local root = FX.LocalPlayerPosition()
				pos = Vector3.new(ev[4], if root then root.Y - 3 else 0, ev[5])
			end
			FX.Ability(ev[3], pos, ev[6], Vector3.new(ev[7], 0, ev[8]), caster ~= nil and caster.ownerId == LOCAL.UserId)
		elseif code == EV.Text then
			local ent = entities[ev[2]]
			if ent then
				FX.Text(headPos(ent) + Vector3.new(0, 1, 0), ev[3], colorFromHex(ev[4]), true)
			end
		elseif code == EV.Projectile then
			local from, to = entities[ev[2]], entities[ev[3]]
			if from and to then
				FX.Projectile(from.pos + Vector3.new(0, 1.5, 0), to.pos + Vector3.new(0, 1.5, 0), FX.ElementColors[ev[4]] or Color3.new(1, 1, 1))
			end
		elseif code == EV.Heal then
			local ent = entities[ev[2]]
			if ent then
				FX.Text(headPos(ent), "+" .. tostring(ev[3]), FX.ElementColors.Heal)
			end
		elseif code == EV.Chain then
			local points = {}
			for _, id in ev[2] do
				local ent = entities[id]
				if ent then
					table.insert(points, ent.pos + Vector3.new(0, 2, 0))
				end
			end
			if #points >= 2 then
				FX.Lightning(points, FX.ElementColors.Volt)
			end
		elseif code == EV.Beam then
			local from = Vector3.new(ev[3], ev[4], ev[5])
			local to = Vector3.new(ev[6], ev[7], ev[8])
			if ev[2] == "CoreHit" then
				FX.Burst(from, Color3.fromRGB(255, 60, 90), 5, 4)
			elseif ev[2] == "DefenseBroken" then
				FX.Burst(from, Color3.fromRGB(200, 170, 120), 12, 6)
			else
				FX.Beam(from, to, if ev[2] == "BlazeCannon" then FX.ElementColors.Fire else FX.ElementColors.Turret, 0.6)
				FX.Burst(to, FX.ElementColors.Turret, 3, 3)
			end
		end
	end
end

----------------------------------------------------------------------------
-- Public
----------------------------------------------------------------------------

function EntityRenderer.Start()
	folder = Instance.new("Folder")
	folder.Name = "ClientEntities"
	folder.Parent = workspace

	Net.Event("EntitySpawned").OnClientEvent:Connect(function(list)
		for _, desc in list do
			addEntity(desc)
		end
	end)
	Net.Event("EntityRemoved").OnClientEvent:Connect(removeEntity)
	Net.Event("EntityAppearance").OnClientEvent:Connect(function(id, appearance, maxHp)
		local ent = entities[id]
		if ent then
			ent.appearance = appearance
			ent.maxHp = maxHp or ent.maxHp
			destroyModel(ent)
		end
	end)
	Net.Unreliable("EntitySnapshot").OnClientEvent:Connect(function(buf)
		local now = os.clock()
		Protocol.Unpack(buf, function(id, x, y, z, yaw, state, hp)
			local ent = entities[id]
			if ent then
				ent.targetPos = Vector3.new(x, y, z)
				ent.targetYaw = yaw
				if ent.state ~= state then
					ent.state = state
					ent.stateChanged = now
				end
				ent.hp = hp
				if ent.lastUpdate and now - ent.lastUpdate > STALE_AFTER then
					ent.pos = ent.targetPos -- re-entered interest range: snap
				end
				ent.lastUpdate = now
			end
		end)
	end)
	Net.Event("CombatEvents").OnClientEvent:Connect(onCombat)
	Net.Event("MountState").OnClientEvent:Connect(function(userId, info)
		for _, ent in entities do
			if ent.mountedBy == userId then
				ent.mountedBy = nil
			end
		end
		mounts[userId] = info
		if info then
			local ent = entities[info.entityId]
			if ent then
				ent.mountedBy = userId
			end
		end
	end)

	RunService.PreRender:Connect(step)
end

function EntityRenderer.Get(id: number)
	return entities[id]
end

function EntityRenderer.All()
	return entities
end

-- The local player's pet entity for an inventory uid.
function EntityRenderer.PetByUid(uid: string)
	for _, ent in entities do
		if ent.kind == "Pet" and ent.uid == uid and ent.ownerId == LOCAL.UserId then
			return ent
		end
	end
	return nil
end

-- Nearest living boss the local player can see (for the boss bar).
function EntityRenderer.NearestBoss(maxDist: number)
	local root = FX.LocalPlayerPosition()
	if not root then
		return nil
	end
	local best, bestD = nil, maxDist
	for _, ent in entities do
		if ent.boss and ent.state ~= State.Dead then
			local d = (ent.pos - root).Magnitude
			if d < bestD then
				best, bestD = ent, d
			end
		end
	end
	return best
end

-- Raycast-free picking for "tap a zombie to focus": nearest zombie to a
-- screen point.
function EntityRenderer.PickZombie(screenPos: Vector2, radiusPx: number)
	local camera = workspace.CurrentCamera
	local best, bestD = nil, radiusPx
	for _, ent in entities do
		if ent.kind == "Zombie" and ent.model then
			local p, onScreen = camera:WorldToViewportPoint(ent.pos + Vector3.new(0, 2.5, 0))
			if onScreen then
				local d = (Vector2.new(p.X, p.Y) - screenPos).Magnitude
				if d < bestD then
					best, bestD = ent, d
				end
			end
		end
	end
	return best
end


return EntityRenderer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">FX</string>
              <string name="Source"><![CDATA[--[[
	FX: every visual effect in the game, built from neon blocks and tweens.
	Budgets scale with the player's graphics quality so phones stay smooth.

	The two money shots for TikTok/Shorts live here:
	  * DeathExplosion: zombies burst into physics blocks (ragdoll pop)
	  * the ability rings/cones/lightning that come off mutated pets
]]

local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local FX = {}

local folder: Folder
local debrisCount = 0
local textPool: { BillboardGui } = {}
local activeTexts = 0
local shake = { amount = 0, untilT = 0 }

FX.ElementColors = {
	Hit = Color3.fromRGB(255, 255, 255),
	Fire = Color3.fromRGB(255, 110, 30),
	Ice = Color3.fromRGB(150, 230, 255),
	Lightning = Color3.fromRGB(255, 240, 60),
	Volt = Color3.fromRGB(255, 240, 60),
	Dragon = Color3.fromRGB(255, 60, 60),
	Brainrot = Color3.fromRGB(255, 80, 220),
	Heal = Color3.fromRGB(90, 255, 120),
	Taunt = Color3.fromRGB(255, 170, 60),
	Spit = Color3.fromRGB(160, 255, 80),
	Turret = Color3.fromRGB(110, 200, 255),
	Nuke = Color3.fromRGB(255, 255, 180),
}

-- 0.3 (potato) .. 1 (high)
function FX.Quality(): number
	local ok, level = pcall(function()
		return UserSettings():GetService("UserGameSettings").SavedQualityLevel.Value
	end)
	local q = if ok and level > 0 then level / 10 else 0.6
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		q = math.min(q, 0.5)
	end
	return math.clamp(q, 0.3, 1)
end

function FX.Start()
	folder = Instance.new("Folder")
	folder.Name = "ClientFX"
	folder.Parent = workspace

	RunService:BindToRenderStep("BeastShake", Enum.RenderPriority.Camera.Value + 1, function()
		local now = os.clock()
		if now < shake.untilT then
			local camera = workspace.CurrentCamera
			local a = shake.amount * ((shake.untilT - now) / 0.4)
			camera.CFrame *= CFrame.new(math.random() * a - a / 2, math.random() * a - a / 2, 0)
		end
	end)
end

function FX.Shake(amount: number, duration: number?)
	shake.amount = math.max(shake.amount * (if os.clock() < shake.untilT then 1 else 0), amount)
	shake.untilT = os.clock() + (duration or 0.4)
end

local function block(size: Vector3, cf: CFrame, color: Color3, neon: boolean?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = if neon == false then Enum.Material.SmoothPlastic else Enum.Material.Neon
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = folder
	return p
end

local function fadeAndKill(p: BasePart, duration: number, goal: { [string]: any }?)
	local props: { [string]: any } = { Transparency = 1 }
	local extra: { [string]: any } = goal or {}
	for k, v in extra do
		props[k] = v
	end
	TweenService:Create(p, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
	Debris:AddItem(p, duration + 0.05)
end

----------------------------------------------------------------------------
-- Primitives
----------------------------------------------------------------------------

-- Expanding flat ring on the ground.
function FX.Ring(pos: Vector3, radius: number, color: Color3, duration: number?)
	local d = duration or 0.45
	local ring = block(Vector3.new(0.4, 2, 2), CFrame.new(pos + Vector3.new(0, 0.4, 0)) * CFrame.Angles(0, 0, math.pi / 2), color)
	ring.Shape = Enum.PartType.Cylinder
	ring.Transparency = 0.2
	fadeAndKill(ring, d, { Size = Vector3.new(0.4, radius * 2, radius * 2) })
end

-- Blocks flying outward (tween only, no physics).
function FX.Burst(pos: Vector3, color: Color3, count: number?, speed: number?)
	local n = math.floor((count or 8) * FX.Quality())
	for _ = 1, n do
		local dir = Vector3.new(math.random() - 0.5, math.random() * 0.8, math.random() - 0.5).Unit
		local s = 0.3 + math.random() * 0.5
		local p = block(Vector3.new(s, s, s), CFrame.new(pos), color)
		fadeAndKill(p, 0.45, {
			CFrame = CFrame.new(pos + dir * (speed or 6)) * CFrame.Angles(math.random() * 6, math.random() * 6, 0),
			Size = Vector3.new(0.05, 0.05, 0.05),
		})
	end
end

function FX.Cone(pos: Vector3, dir: Vector3, range: number, angleDeg: number, color: Color3)
	local flat = Vector3.new(dir.X, 0, dir.Z)
	if flat.Magnitude < 1e-3 then
		return
	end
	flat = flat.Unit
	local width = 2 * range * math.tan(math.rad(angleDeg / 2))
	local cf = CFrame.lookAt(pos + Vector3.new(0, 1.5, 0), pos + Vector3.new(0, 1.5, 0) + flat) * CFrame.new(0, 0, -range / 2)
	local wedge = block(Vector3.new(1, 3, 2), cf, color)
	wedge.Transparency = 0.3
	fadeAndKill(wedge, 0.4, { Size = Vector3.new(width, 3.5, range) })
	for k = 1, math.floor(6 * FX.Quality()) do
		local off = (math.random() - 0.5) * width * 0.8
		local target = cf * CFrame.new(off, 0, -range / 2)
		local p = block(Vector3.new(0.8, 0.8, 0.8), CFrame.new(pos + Vector3.new(0, 1.5, 0)), color)
		fadeAndKill(p, 0.35 + k * 0.02, { CFrame = target })
	end
end

function FX.Projectile(from: Vector3, to: Vector3, color: Color3, size: number?)
	local s = size or 0.8
	local p = block(Vector3.new(s, s, s), CFrame.new(from), color)
	local t = math.clamp((to - from).Magnitude / 90, 0.08, 0.35)
	TweenService:Create(p, TweenInfo.new(t, Enum.EasingStyle.Linear), { CFrame = CFrame.new(to) }):Play()
	task.delay(t, function()
		FX.Burst(to, color, 4, 3)
		p:Destroy()
	end)
end

-- Jagged lightning through a list of points.
function FX.Lightning(points: { Vector3 }, color: Color3)
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		local segments = 3
		local prev = a
		for s = 1, segments do
			local t = s / segments
			local nextP = a:Lerp(b, t) + (if s < segments then Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 2 else Vector3.zero)
			local len = (nextP - prev).Magnitude
			local seg = block(Vector3.new(0.3, 0.3, len), CFrame.lookAt((prev + nextP) / 2, nextP), color)
			fadeAndKill(seg, 0.25)
			prev = nextP
		end
	end
end

function FX.Beam(from: Vector3, to: Vector3, color: Color3, width: number?)
	local len = (to - from).Magnitude
	if len < 0.1 then
		return
	end
	local w = width or 0.5
	local seg = block(Vector3.new(w, w, len), CFrame.lookAt((from + to) / 2, to), color)
	fadeAndKill(seg, 0.2)
end

----------------------------------------------------------------------------
-- Floating text / damage numbers (pooled BillboardGuis)
----------------------------------------------------------------------------

local function getText(): BillboardGui
	local gui = table.remove(textPool)
	if gui then
		return gui
	end
	gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(220, 50)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 140
	local label = Instance.new("TextLabel")
	label.Name = "T"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Parent = label
	label.Parent = gui
	return gui
end

function FX.Text(pos: Vector3, text: string, color: Color3, big: boolean?)
	local cap = math.floor(40 * FX.Quality())
	if activeTexts >= cap then
		return
	end
	activeTexts += 1
	local anchor = block(Vector3.new(0.1, 0.1, 0.1), CFrame.new(pos + Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) * 2), color)
	anchor.Transparency = 1
	local gui = getText()
	local label = gui:FindFirstChild("T") :: TextLabel
	gui.Size = if big then UDim2.fromOffset(300, 70) else UDim2.fromOffset(200, 42)
	label.Text = text
	label.TextColor3 = color
	label.TextTransparency = 0
	gui.Adornee = anchor
	gui.Parent = anchor
	TweenService:Create(anchor, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = anchor.CFrame + Vector3.new(0, if big then 6 else 4, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(0.35, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 0.6), { TextTransparency = 1 }):Play()
	task.delay(0.95, function()
		activeTexts -= 1
		gui.Parent = nil
		gui.Adornee = nil
		table.insert(textPool, gui)
		anchor:Destroy()
	end)
end

function FX.Damage(pos: Vector3, amount: number, crit: boolean, color: Color3?)
	local text = if amount >= 1e6 then string.format("%.1fM", amount / 1e6) elseif amount >= 1e3 then string.format("%.1fK", amount / 1e3) else tostring(amount)
	FX.Text(pos, if crit then text .. "!" else text, if crit then Color3.fromRGB(255, 70, 70) else (color or Color3.new(1, 1, 1)), crit)
end

----------------------------------------------------------------------------
-- Zombie death: the ragdoll pop
----------------------------------------------------------------------------

local DEATH_STYLES = {
	Fire = { color = Color3.fromRGB(40, 30, 30), burst = Color3.fromRGB(255, 120, 30), power = 1 },
	Ice = { color = Color3.fromRGB(180, 235, 255), burst = Color3.fromRGB(200, 245, 255), power = 0.8 },
	Volt = { burst = Color3.fromRGB(255, 240, 60), power = 1.2 },
	Lightning = { burst = Color3.fromRGB(255, 240, 60), power = 1.2 },
	Dragon = { color = Color3.fromRGB(50, 30, 30), burst = Color3.fromRGB(255, 70, 40), power = 1.4 },
	Nuke = { burst = Color3.fromRGB(255, 255, 200), power = 2.4 },
	Meme_GravityFlip = { burst = Color3.fromRGB(255, 80, 220), power = 1.6, up = 3 },
	Meme_ConfettiNuke = { burst = Color3.fromRGB(255, 220, 60), power = 1.8, confetti = true },
	Meme_BruhFreeze = { color = Color3.fromRGB(180, 235, 255), burst = Color3.fromRGB(255, 255, 255), power = 1 },
	Poof = { poof = true },
}

function FX.DeathExplosion(parts: { BasePart }, center: Vector3, fx: string)
	local style = DEATH_STYLES[fx] or { burst = Color3.fromRGB(150, 255, 120), power = 1 }
	if style.poof then
		for _, p in parts do
			fadeAndKill(p, 0.3, { Size = p.Size * 0.2 })
		end
		FX.Burst(center, Color3.fromRGB(200, 200, 220), 6)
		return
	end
	local budget = math.floor(260 * FX.Quality())
	local power = style.power or 1
	for _, p in parts do
		if style.color then
			p.Color = p.Color:Lerp(style.color, 0.7)
		end
		if debrisCount < budget then
			debrisCount += 1
			p.Anchored = false
			p.CanCollide = true
			p.Parent = folder
			local out = (p.Position - center)
			out = if out.Magnitude > 0.01 then out.Unit else Vector3.new(0, 1, 0)
			p.AssemblyLinearVelocity = (out * 28 + Vector3.new(0, 30 * (style.up or 1), 0) + Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) * 16) * power
			p.AssemblyAngularVelocity = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 22
			task.delay(1.8, function()
				fadeAndKill(p, 0.5)
				task.delay(0.5, function()
					debrisCount -= 1
				end)
			end)
		else
			fadeAndKill(p, 0.3)
		end
	end
	FX.Burst(center + Vector3.new(0, 2, 0), style.burst, 10, 8 * power)
	if style.confetti then
		local colors = { Color3.fromRGB(255, 80, 120), Color3.fromRGB(80, 220, 255), Color3.fromRGB(255, 230, 60), Color3.fromRGB(120, 255, 120) }
		for i = 1, math.floor(18 * FX.Quality()) do
			FX.Burst(center + Vector3.new(0, 3, 0), colors[i % #colors + 1], 1, 14)
		end
	end
end

----------------------------------------------------------------------------
-- Ability dispatcher (fx names come from Config/Fruits and services)
----------------------------------------------------------------------------

function FX.Ability(fx: string, pos: Vector3, radius: number, dir: Vector3, ownerIsLocal: boolean)
	local q = FX.Quality()
	if fx == "FireBurst" or fx == "FireRing" then
		FX.Ring(pos, radius, FX.ElementColors.Fire)
		FX.Burst(pos + Vector3.new(0, 1, 0), Color3.fromRGB(255, 200, 60), 14, radius * 0.6)
	elseif fx == "IceRing" then
		FX.Ring(pos, radius, FX.ElementColors.Ice, 0.6)
		FX.Burst(pos + Vector3.new(0, 1, 0), Color3.new(1, 1, 1), 12, radius * 0.5)
	elseif fx == "IceCone" then
		FX.Cone(pos, dir, radius, 55, FX.ElementColors.Ice)
	elseif fx == "DragonBreath" then
		FX.Cone(pos, dir, radius, 50, FX.ElementColors.Fire)
		FX.Cone(pos, dir, radius * 0.7, 30, Color3.fromRGB(255, 230, 80))
	elseif fx == "VoltRing" then
		FX.Ring(pos, radius, FX.ElementColors.Volt, 0.3)
		for _ = 1, math.floor(5 * q) do
			local a = math.random() * math.pi * 2
			local r = math.random() * radius
			local ground = pos + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
			FX.Lightning({ ground + Vector3.new(0, 18, 0), ground }, FX.ElementColors.Volt)
		end
	elseif fx == "SkyDive" then
		FX.Ring(pos, radius, FX.ElementColors.Dragon, 0.6)
		FX.Ring(pos, radius * 0.6, Color3.fromRGB(255, 200, 60), 0.4)
		FX.Burst(pos, Color3.fromRGB(120, 90, 70), 16, radius * 0.5)
	elseif fx == "Dash" then
		FX.Beam(pos + Vector3.new(0, 2, 0), pos + dir + Vector3.new(0, 2, 0), Color3.fromRGB(255, 255, 255), 1.2)
	elseif fx == "Glitch" or fx:sub(1, 5) == "Meme_" then
		local colors = { Color3.fromRGB(255, 60, 220), Color3.fromRGB(60, 255, 240), Color3.fromRGB(255, 240, 60) }
		for i, c in colors do
			task.delay(i * 0.06, function()
				FX.Ring(pos, radius * (0.6 + i * 0.15), c, 0.35)
			end)
		end
		if fx == "Meme_ConfettiNuke" or fx == "Meme_GigaMode" then
			FX.Burst(pos + Vector3.new(0, 3, 0), colors[math.random(1, 3)], 20, radius)
		end
	elseif fx == "Aura" then
		FX.Ring(pos, radius, Color3.fromRGB(255, 215, 0), 0.7)
		FX.Ring(pos, radius * 0.5, Color3.new(1, 1, 1), 0.5)
		FX.Burst(pos + Vector3.new(0, 2, 0), Color3.fromRGB(255, 215, 0), 18, radius * 0.7)
	elseif fx == "Heal" then
		FX.Ring(pos, radius * 0.4, FX.ElementColors.Heal, 0.5)
	elseif fx == "Taunt" then
		FX.Ring(pos, radius, FX.ElementColors.Taunt, 0.35)
	elseif fx == "Nuke" then
		FX.Ring(pos, radius, FX.ElementColors.Nuke, 1.2)
		FX.Ring(pos, radius * 0.5, Color3.fromRGB(255, 160, 40), 0.9)
		FX.Shake(2.5, 1)
	elseif fx:sub(1, 6) == "Mount_" then
		local element = fx:sub(7)
		FX.Cone(pos, dir, radius, 70, FX.ElementColors[element] or Color3.new(1, 1, 1))
	else
		FX.Ring(pos, radius, Color3.new(1, 1, 1), 0.3)
	end
	if ownerIsLocal and radius >= 14 then
		FX.Shake(0.6 + radius / 40, 0.35)
	end
end

function FX.LocalPlayerPosition(): Vector3?
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return root and root.Position
end

return FX
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">MountController</string>
              <string name="Source"><![CDATA[--[[
	MountController: ride your Alpha.
	  PC       R toggles the mount, left click attacks while riding
	  Mobile   RIDE / ⚔️ buttons in the HUD
	  Gamepad  ButtonY toggles, ButtonR2 attacks
	The rider plays the sit pose borrowed from the default Animate script,
	so no animation uploads are needed.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)

local HUD = require(script.Parent.Parent.UI.HUD)

local LOCAL = Players.LocalPlayer

local MountController = { mounted = false }

local sitTrack: AnimationTrack? = nil
local lastAttack = 0

local function playSit(on: boolean)
	if sitTrack then
		sitTrack:Stop(0.2)
		sitTrack = nil
	end
	if not on then
		return
	end
	local character = LOCAL.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	local animate = character and character:FindFirstChild("Animate")
	local sit = animate and animate:FindFirstChild("sit")
	local anim = sit and sit:FindFirstChildOfClass("Animation")
	if animator and anim then
		local track = animator:LoadAnimation(anim)
		track.Priority = Enum.AnimationPriority.Action
		track.Looped = true
		track:Play(0.2)
		sitTrack = track
	end
end

function MountController.Toggle()
	Net.Event("ToggleMount"):FireServer()
end

function MountController.Attack()
	if not MountController.mounted or os.clock() - lastAttack < 0.15 then
		return
	end
	lastAttack = os.clock()
	local camera = workspace.CurrentCamera
	local aim = camera.CFrame.LookVector
	local mouse = UserInputService:GetMouseLocation()
	if UserInputService.MouseEnabled then
		local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
		local character = LOCAL.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			-- aim at where the cursor ray crosses the rider's height
			local t = if math.abs(ray.Direction.Y) > 1e-3 then (root.Position.Y - 2 - ray.Origin.Y) / ray.Direction.Y else 0
			if t > 0 then
				local hit = ray.Origin + ray.Direction * t
				aim = hit - root.Position
			end
		end
	end
	Net.Event("MountAttack"):FireServer(Vector3.new(aim.X, 0, aim.Z))
end

function MountController.Start()
	HUD.OnRideToggle = MountController.Toggle
	HUD.OnMountAttack = MountController.Attack

	Net.Event("MountState").OnClientEvent:Connect(function(userId, info)
		if userId ~= LOCAL.UserId then
			return
		end
		MountController.mounted = info ~= nil
		HUD.SetMounted(MountController.mounted)
		playSit(MountController.mounted)
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.R or input.KeyCode == Enum.KeyCode.ButtonY then
			MountController.Toggle()
		elseif MountController.mounted and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.ButtonR2) then
			MountController.Attack()
		end
	end)
	LOCAL.CharacterAdded:Connect(function()
		MountController.mounted = false
		HUD.SetMounted(false)
		sitTrack = nil
	end)
end

return MountController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">WorldClient</string>
              <string name="Source"><![CDATA[--[[
	WorldClient: client-side world logic.
	  * prompt filtering (owner-only / visitor-only prompts)
	  * client-handled prompts (eggs, dealer, lab, rebirth -> panels)
	  * zone gates open locally once you hit the level
	  * conveyor goo sliding along every nearby base's belt (pure visuals)
	  * Fruit Notifier beams + distance markers
	  * waypoint home while carrying stolen loot
	  * tap/click a zombie to focus-fire your whole army on it
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local World = require(Shared.Config.World)
local Base = require(Shared.Config.Base)
local Fruits = require(Shared.Config.Fruits)

local ClientState = require(script.Parent.Parent.ClientState)
local Panels = require(script.Parent.Parent.UI.Panels)
local HUD = require(script.Parent.Parent.UI.HUD)
local EntityRenderer = require(script.Parent.EntityRenderer)
local MountController = require(script.Parent.MountController)
local FX = require(script.Parent.FX)

local LOCAL = Players.LocalPlayer

local WorldClient = {}

local fxFolder: Folder
local beams: { [string]: any } = {}
local homeMarker: BillboardGui? = nil

----------------------------------------------------------------------------
-- Prompts
----------------------------------------------------------------------------

-- Hides prompts by zeroing their activation distance locally, so the
-- server stays free to toggle Enabled (e.g. a maxed-out build pad).
local baseDistance: { [ProximityPrompt]: number } = {}

local function applyPromptRule(prompt: Instance)
	if not prompt:IsA("ProximityPrompt") then
		return
	end
	local base = baseDistance[prompt]
	if not base then
		base = prompt.MaxActivationDistance
		baseDistance[prompt] = base
		prompt.Destroying:Connect(function()
			baseDistance[prompt] = nil
		end)
	end
	local owner = prompt:GetAttribute("OwnerUserId")
	local visible = true
	if CollectionService:HasTag(prompt, "OwnerOnlyPrompt") then
		visible = owner == LOCAL.UserId
	elseif CollectionService:HasTag(prompt, "VisitorPrompt") then
		visible = owner ~= LOCAL.UserId
	end
	prompt.MaxActivationDistance = if visible then base else 0
end

local function watchTag(tag: string)
	local function hook(inst: Instance)
		applyPromptRule(inst)
		inst:GetAttributeChangedSignal("OwnerUserId"):Connect(function()
			applyPromptRule(inst)
		end)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(hook)
	for _, inst in CollectionService:GetTagged(tag) do
		hook(inst)
	end
end

----------------------------------------------------------------------------
-- Zone gates
----------------------------------------------------------------------------

local function refreshGates()
	local level = if ClientState.data then ClientState.data.level else 1
	for _, gate in CollectionService:GetTagged("ZoneGate") do
		if gate:IsA("BasePart") then
			local open = level >= (gate:GetAttribute("LevelReq") or 1)
			gate.CanCollide = not open
			gate.Transparency = if open then 0.93 else 0.7
		end
	end
end

----------------------------------------------------------------------------
-- Conveyor goo (visual only)
----------------------------------------------------------------------------

local GOO_COLORS = {
	Color3.fromRGB(120, 220, 255),
	Color3.fromRGB(120, 255, 140),
	Color3.fromRGB(255, 220, 80),
	Color3.fromRGB(255, 140, 60),
	Color3.fromRGB(230, 100, 255),
	Color3.fromRGB(255, 80, 130),
}
local conveyorTimers: { [string]: number } = {}

local function stepConveyors()
	local camera = workspace.CurrentCamera
	local camPos = camera.CFrame.Position
	local info = ReplicatedStorage:FindFirstChild("PlotInfo")
	if not info then
		return
	end
	local now = os.clock()
	local q = FX.Quality()
	for _, plotInfo in info:GetChildren() do
		local levels = plotInfo:GetAttribute("Droppers")
		local index = plotInfo:GetAttribute("Index")
		if levels and index then
			local cf = World.PlotCFrame(index)
			if (cf.Position - camPos).Magnitude < 220 then
				local speed = plotInfo:GetAttribute("BeltSpeed") or 1
				local i = 0
				for lvl in string.gmatch(levels, "[^,]+") do
					i += 1
					local level = tonumber(lvl) or 0
					local def = Base.Conveyor.droppers[i]
					local key = index .. ":" .. i
					if level > 0 and def and now >= (conveyorTimers[key] or 0) then
						conveyorTimers[key] = now + Base.Conveyor.dropInterval / speed / q
						local startLocal = Vector3.new(Base.Conveyor.start.X, 1.8, def.offset.Z)
						local finishLocal = Vector3.new(Base.Conveyor.finish.X, 1.8, Base.Conveyor.finish.Z)
						local s = 0.8 + math.min(level, 10) * 0.05
						local goo = Instance.new("Part")
						goo.Anchored = true
						goo.CanCollide = false
						goo.CanQuery = false
						goo.CanTouch = false
						goo.CastShadow = false
						goo.Material = Enum.Material.Neon
						goo.Color = GOO_COLORS[i]
						goo.Size = Vector3.new(s, s, s)
						goo.CFrame = cf * CFrame.new(startLocal + Vector3.new(0, 4, 0))
						goo.Parent = fxFolder
						local distance = (finishLocal - startLocal).Magnitude
						local travel = distance / (7 * speed)
						TweenService:Create(goo, TweenInfo.new(0.35, Enum.EasingStyle.Bounce), { CFrame = cf * CFrame.new(startLocal) }):Play()
						task.delay(0.35, function()
							TweenService:Create(goo, TweenInfo.new(travel, Enum.EasingStyle.Linear), { CFrame = cf * CFrame.new(finishLocal) }):Play()
							task.delay(travel, function()
								goo:Destroy()
							end)
						end)
					end
				end
			end
		end
	end
end

----------------------------------------------------------------------------
-- Fruit Notifier
----------------------------------------------------------------------------

local function addBeam(id: string, fruitId: string, pos: Vector3, hidden: boolean)
	local fruit = Fruits.List[fruitId]
	local beam = Instance.new("Part")
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.CanTouch = false
	beam.CastShadow = false
	beam.Material = Enum.Material.Neon
	beam.Color = fruit.color
	beam.Transparency = 0.45
	beam.Size = Vector3.new(1.4, 300, 1.4)
	beam.Position = pos + Vector3.new(0, 150, 0)
	beam.Parent = fxFolder
	local marker = Instance.new("BillboardGui")
	marker.Size = UDim2.fromOffset(220, 50)
	marker.AlwaysOnTop = true
	marker.LightInfluence = 0
	marker.StudsOffsetWorldSpace = Vector3.new(0, -140, 0)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = fruit.color
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = label
	label.Parent = marker
	marker.Parent = beam
	beams[id] = { part = beam, label = label, pos = pos, name = fruit.emoji .. " " .. fruit.displayName .. (if hidden then " (hidden!)" else "") }
	HUD.Toast(("🔔 %s %s spawned!"):format(fruit.emoji, fruit.displayName), "reward")
end

local function removeBeam(id: string)
	local b = beams[id]
	if b then
		b.part:Destroy()
		beams[id] = nil
	end
end

----------------------------------------------------------------------------
-- Waypoint home while carrying loot
----------------------------------------------------------------------------

local function refreshHome()
	local carrying = LOCAL:GetAttribute("Carrying")
	local plotIndex = LOCAL:GetAttribute("PlotIndex")
	if homeMarker then
		local oldAnchor = homeMarker.Parent
		if oldAnchor then
			oldAnchor:Destroy()
		end
		homeMarker = nil
	end
	if not carrying or not plotIndex then
		return
	end
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(1, 1, 1)
	local target = if carrying == "Egg" then Base.IncubatorOffset else Vector3.zero
	anchor.CFrame = World.PlotCFrame(plotIndex) * CFrame.new(target + Vector3.new(0, 8, 0))
	anchor.Parent = fxFolder
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(200, 60)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Name = "T"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(120, 255, 140)
	label.Text = "🏠 HOME"
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = anchor
	homeMarker = gui
end

----------------------------------------------------------------------------
-- Start
----------------------------------------------------------------------------

function WorldClient.Start()
	fxFolder = Instance.new("Folder")
	fxFolder.Name = "WorldClientFX"
	fxFolder.Parent = workspace

	watchTag("OwnerOnlyPrompt")
	watchTag("VisitorPrompt")

	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		if CollectionService:HasTag(prompt, "EggPrompt") then
			Panels.Open("Egg", prompt:GetAttribute("EggId"))
		elseif CollectionService:HasTag(prompt, "DealerPrompt") then
			Panels.Open("Dealer")
		elseif CollectionService:HasTag(prompt, "LabPrompt") then
			Panels.Open("Lab")
		elseif CollectionService:HasTag(prompt, "RebirthPrompt") then
			Panels.Open("Rebirth")
		end
	end)

	CollectionService:GetInstanceAddedSignal("ZoneGate"):Connect(refreshGates)
	ClientState.Loaded:Connect(refreshGates)
	ClientState.Changed:Connect(function(key)
		if key == "level" then
			refreshGates()
		end
	end)

	Net.Event("FruitSpawned").OnClientEvent:Connect(addBeam)
	Net.Event("FruitDespawned").OnClientEvent:Connect(removeBeam)

	LOCAL:GetAttributeChangedSignal("Carrying"):Connect(refreshHome)

	-- Tap / click a zombie: the whole army focuses it.
	local function tryFocus(screenPos: Vector2)
		if MountController.mounted then
			return
		end
		local zombie = EntityRenderer.PickZombie(screenPos, 60)
		if zombie then
			Net.Event("SquadCommand"):FireServer("Attack", zombie.id)
			HUD.SetSquadMode("Attack", true)
			FX.Ring(zombie.pos, 5, Color3.fromRGB(255, 80, 80), 0.5)
			FX.Text(zombie.pos + Vector3.new(0, 6, 0), "🎯 FOCUS!", Color3.fromRGB(255, 90, 90), true)
		end
	end
	UserInputService.TouchTapInWorld:Connect(function(position, processedByUI)
		if not processedByUI then
			tryFocus(position)
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.UserInputType == Enum.UserInputType.MouseButton1 then
			local p = UserInputService:GetMouseLocation()
			tryFocus(Vector2.new(p.X, p.Y))
		end
	end)

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.25 then
			return
		end
		acc = 0
		stepConveyors()
		local character = LOCAL.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			for _, b in beams do
				b.label.Text = ("%s · %dm"):format(b.name, math.floor((b.pos - root.Position).Magnitude))
			end
			if homeMarker then
				local text = homeMarker:FindFirstChild("T") :: TextLabel?
				if text and homeMarker.Parent then
					local anchor = homeMarker.Parent :: BasePart
					text.Text = ("🏠 HOME · %dm"):format(math.floor((anchor.Position - root.Position).Magnitude))
				end
			end
		end
	end)
end

return WorldClient
]]></string>
            </Properties>
          </Item>
